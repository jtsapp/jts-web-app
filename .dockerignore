node_modules
.next
.git
.env
.env*.local
agent
# Исходники курсов и прочее сырьё в образ не едут — кроме текстов книг: они
# уехали из public за авторизованный роут /api/books, и Dockerfile копирует их
# отдельной строкой. Без исключения COPY в runner-стадии падает: файлов нет в
# контексте сборки.
#
# `data/*`, а не `data`: исключение целой директории не даёт сборщику зайти
# внутрь, и «!»-строка ниже осталась бы бесполезной.
data/*
!data/books
docs
public/practice/books.html
tests
playwright-report
test-results
.playwright
