er":"печатные заглавные буквы","optionsKk":["бас әріптермен","белгі қою","жақын туысы","тіркелу","өтініш беру"],"answerKk":"бас әріптермен"},{"stage":"Grammar","type":"note","title":"Как это работает","html":"You&rsquo;re <span class=\"hl\">breaking up</span>."},{"stage":"Grammar","type":"note","title":"Как это работает","html":"<span class=\"hl\">Could you repeat that</span>, please?"},{"stage":"Grammar","type":"note","title":"Как это работает","html":"<span class=\"hl\">Please could you speak up?</span>"},{"stage":"Grammar","type":"choice","title":"","prompt":"Look at the four lines. What is the difference between line 2 and line 3?","options":["line 2 is polite and line 3 is rude","line 2 asks you to say it again; line 3 asks you to say it differently","line 2 is about a word and line 3 is about the sound","there is no difference"],"answer":"line 2 asks you to say it again; line 3 asks you to say it differently"},{"stage":"Practice","type":"choice","title":"Repeat it, or explain it? Choose what you would say.","prompt":"A lorry goes past and you miss the address.","options":["Sorry, could you repeat that?","Sorry, what do you mean by that?","neither of these"],"answer":"Sorry, could you repeat that?"},{"stage":"Practice","type":"choice","title":"Repeat it, or explain it? Choose what you would say.","prompt":"You heard “marital status” clearly but it means nothing to you.","options":["Sorry, could you repeat that?","Sorry, what does ‘marital status’ mean?","neither of these"],"answer":"Sorry, what does ‘marital status’ mean?"},{"stage":"Practice","type":"choice","title":"Repeat it, or explain it? Choose what you would say.","prompt":"The line is bad and the voice keeps stopping.","options":["Sorry, you’re breaking up.","Sorry, I’m a bit lost.","neither of these"],"answer":"Sorry, you’re breaking up."},{"stage":"Practice","type":"choice","title":"Repeat it, or explain it? Choose what you would say.","prompt":"She is speaking very quietly.","options":["Could you explain that?","Please could you speak up?","neither of these"],"answer":"Please could you speak up?"},{"stage":"Listening","type":"rows","title":"Listen once. Where is each conversation?","sub":"","track":"Track_8.11.mp3","items":[{"q":"Conversation 1","options":["in a shop","on the phone, from a train","at a concert"],"answer":"on the phone, from a train"},{"q":"Conversation 2","options":["in a restaurant","on the phone","in a lecture"],"answer":"in a lecture"},{"q":"Conversation 3","options":["at a concert","in a library","in an office"],"answer":"at a concert"}]},{"stage":"Speaking","type":"write","title":"Check your own draft before you finish.","sub":"Напиши ответ, затем проверь себя","placeholder":"Твой ответ…","model":"Booking: I’d like to enrol on… · Is it suitable for beginners? · Do you have any places left?"},{"stage":"Wrap","type":"checklist","title":"Отметь, чему научился","sub":"Я могу…","items":["✓ ask someone to say it again — Sorry, could you repeat that? · Please could you speak up?","✓ say why you could not hear — You’re breaking up. · It’s too noisy in here.","✓ ask what a word means — What do you mean by…? · Could you explain?","✓ say you have lost the thread — Sorry, I’m a bit lost.","✓ check something before you agree — So do I need to…?","✓ say what you must and don’t have to do recycled — You must get insurance. You don’t have to pay it all today."]}]}