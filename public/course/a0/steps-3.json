льное слово.","tokens":["I","have","three","key."],"bad":3,"answer":"I have three keys.","why":"Два и больше предметов — с -s."},{"stage":"Practice","type":"mistake","title":"Найдите ошибку.","sub":"Нажмите на неправильное слово.","tokens":["Twos","phones","are","here."],"bad":0,"answer":"Two phones are here.","why":"К числу -s не добавляется."},{"stage":"Practice","type":"mistake","title":"Найдите ошибку.","sub":"Нажмите на неправильное слово.","tokens":["I","am","twenty","years."],"bad":3,"answer":"I am twenty.","why":"О возрасте просто называют число: I'm twenty."},{"stage":"Listening","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/ff963af8fd44.mp3","prompt":"Сколько книг?","options":["nine","five","fifteen"],"answer":"five","html":""},{"stage":"Listening","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/74e3bcff0761.mp3","prompt":"Сколько ключей?","options":["three","thirteen","two"],"answer":"three","html":""},{"stage":"Listening","type":"gap","title":"Послушайте. Дополните фразу.","sub":"","src":"/course/a0/audio/29cbacbf92a4.mp3","before":"two","after":"","answers":["wallets"],"bank":["wallets","wallet","walls"]},{"stage":"Listening","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/5d4a6e3518fa.mp3","prompt":"Что вы слышите?","options":["two umbrellas","ten umbrellas","two umbrella"],"answer":"two umbrellas","html":""},{"stage":"Listening","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/8de964c47bf6.mp3","prompt":"Сколько яблок?","options":["fourteen","four","forty"],"answer":"forty","html":""},{"stage":"Listening","type":"gap","title":"Послушайте. Дополните фразу.","sub":"","src":"/course/a0/audio/c79bd52c31e9.mp3","before":"nine","after":"","answers":["bags"],"bank":["bags","bag","backs"]},{"stage":"Listening","type":"listen","title":"Послушайте. Выберите правил