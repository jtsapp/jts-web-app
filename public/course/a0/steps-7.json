rning/audio/a0/e6427457497f.mp3"},{"en":"restaurant","pos":"","ru":"ресторан","kk":"мейрамхана","def":"He's a waiter in a restaurant.","img":null,"icon":"<circle cx=\"12\" cy=\"13.4\" r=\"6.6\"/><path d=\"M6.6 13.4h10.8\"/><path d=\"M12 6.8V4.2\"/>","audio":"/learning/audio/a0/32ac991d88d6.mp3"}]},{"stage":"Слова","type":"gap","title":"Дополните предложение.","sub":"","before":"A nurse works in a","after":".","answers":["hospital"],"bank":["school","restaurant","hospital"],"why":"","html":"","src":null},{"stage":"Слова","type":"gap","title":"Дополните предложение.","sub":"","before":"A waiter works in a","after":".","answers":["restaurant"],"bank":["office","restaurant","hospital"],"why":"","html":"","src":null},{"stage":"Слова","type":"gap","title":"Дополните предложение.","sub":"","before":"A teacher works in a","after":".","answers":["school"],"bank":["hospital","shop","school"],"why":"","html":"","src":null},{"stage":"Грамматика","type":"phrases","title":"Послушайте два предложения.","sub":"Слушайте слово перед профессией.","items":[{"text":"I'm a teacher.","src":"/learning/audio/a0/d652485f7181.mp3"},{"text":"I'm an engineer.","src":"/learning/audio/a0/5251bef3efaf.mp3"}]},{"stage":"Грамматика","type":"note","title":"a или an","sub":"","html":"<table class=\"cp-table\"><tr><th></th><th>a + …</th><th>an + …</th></tr><tr><td>1</td><td>a doctor</td><td>an engineer</td></tr><tr><td>2</td><td>a nurse</td><td>an artist</td></tr><tr><td>3</td><td>a taxi driver</td><td>an office</td></tr></table><p>Перед a, e, i, o, u — <b>an</b>: <b>an</b> engineer.</p><p>Перед остальными буквами — <b>a</b>: <b>a</b> doctor.</p><p>У профессии всегда a или an: I'm <b>a</b> student, а не «I'm student».</p>"},{"stage":"Грамматика","type":"note","title":"work / works","sub":"","html":"<table class=\"cp-table\"><tr><th>Лицо</th><th>Глагол</th><th>Пример</th></tr><tr><td>I</td><td>work</td><td>I work in an office.</td></tr><tr><td>You</td><td>work</td><td>You work in a hospital.</td></tr><tr><td>He / She</td><td>works</td><td>She works in a school.</td></tr></table><p>С <b>he</b> и <b>she</b> глагол получает <b>-s</b>: she work<b>s</b>.</p><p><b>What's your job?</b> спрашивает название профессии.</p><p><b>What do you do?</b> — тот же вопрос в обычной речи.</p><p class=\"cp-note__fwd\">Полностью Present Simple будет в уроке 13.</p>"},{"stage":"Грамматика","type":"note","title":"Смотрите и слушайте.","sub":"","html":"","examples":["What do you do?","I'm a taxi driver.","I'm an engineer.","I work in an office.","She works in a hospital.","He's a student. He studies English."]},{"stage":"Практика","type":"choice","title":"Выберите правильное слово.","sub":"","prompt":"He's ___ engineer.","options":["a","an","the"],"keep":false,"answer":"an","why":"engineer начинается на e → an.","html":"","src":null},{"stage":"Практика","type":"choice","title":"Выберите правильное слово.","sub":"","prompt":"She's ___ doctor.","options":["an","a","the"],"keep":false,"answer":"a","why":"","html":"","src":null},{"stage":"Практика","type":"choice","title":"Выберите правильное слово.","sub":"","prompt":"I'm ___ shop assistant.","options":["an","the","a"],"keep":false,"answer":"a","why":"","html":"","src":null},{"stage":"Практика","type":"cols","title":"a или an?","sub":"","columns":["a","an"],"items":[{"text":"artist","col":1},{"text":"waiter","col":0},{"text":"nurse","col":0},{"text":"teacher","col":0},{"text":"engineer","col":1},{"text":"office","col":1}]},{"stage":"Практика","type":"gap","title":"Дополните предложение.","sub":"","before":"I","after":"in an office.","answers":["work"],"bank":["works","work","working"],"why":"","html":"","src":null},{"stage":"Практика","type":"gap","title":"Дополните предложение.","sub":"","before":"She","after":"in a school.","answers":["works"],"bank":["works","working","work"],"why":"С she глагол получает -s.","html":"","src":null},{"stage":"Практика","type":"gap","title":"Дополните предложение.","sub":"","before":"He","after":"English.","answers":["studies"],"bank":["studys","study","studies"],"why":"","html":"","src":null},{"stage":"Практика","type":"order","title":"Расставьте слова по порядку.","sub":"","words":["What","you","do","do?"],"answer":"What do you do?","why":""},{"stage":"Практика","type":"order","title":"Расставьте слова по порядку.","sub":"","words":["a","am","I","driver.","taxi"],"answer":"I am a taxi driver.","why":""},{"stage":"Практика","type":"order","title":"Расставьте слова по порядку.","sub":"","words":["She","works","in","hospital.","a"],"answer":"She works in a hospital.","why":""},{"stage":"Практика","type":"mistake","title":"Найдите ошибку.","sub":"Нажмите на неправильное слово.","tokens":["I'm","teacher","in","a","school."],"bad":1,"answer":"I'm a teacher in a school.","why":"Перед профессией нужен a или an."},{"stage":"Практика","type":"mistake","title":"Найдите ошибку.","sub":"Нажмите на неправильное слово.","tokens":["He's","a","artist."],"bad":1,"answer":"He's an artist.","why":"artist начинается на a → an."},{"stage":"Практика","type":"mistake","title":"Найдите ошибку.","sub":"Нажмите на неправильное слово.","tokens":["She","work","in","a","hospital."],"bad":1,"answer":"She works in a hospital.","why":"С she у глагола -s."},{"stage":"Аудирование","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/49b5407ece55.mp3","prompt":"Эрик —","options":["a student","an engineer","a teacher"],"answer":"an engineer","html":""},{"stage":"Аудирование","type":"gap","title":"Послушайте. Дополните предложение.","sub":"","src":"/course/a0/audio/6fc8e273f9f7.mp3","before":"Thierry's","after":"waiter.","answers":["a"],"bank":["a","an","the"]},{"stage":"Аудирование","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/ff5da794e7fe.mp3","prompt":"Соня —","options":["a nurse","a doctor","a shop assistant"],"answer":"a doctor","html":""},{"stage":"Аудирование","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/e38148f19bb2.mp3","prompt":"Кто Фернандо по профессии?","options":["a student","a teacher","a doctor"],"answer":"a teacher","html":""},{"stage":"Аудирование","type":"gap","title":"Послушайте. Дополните предложение.","sub":"","src":"/course/a0/audio/04dc1e1d3b15.mp3","before":"They're nurses in a","after":".","answers":["hospital"],"bank":["hospital","school","shop"]},{"stage":"Аудирование","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/ec095ce483e8.mp3","prompt":"Где он работает?","options":["in a car factory","in a hospital","in a restaurant"],"answer":"in a car factory","html":""},{"stage":"Аудирование","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/ec095ce483e8.mp3","prompt":"Во сколько он начинает работу?","options":["at 8 a.m.","at 8 p.m.","at 4 a.m."],"answer":"at 8 p.m.","html":""},{"stage":"Аудирование","type":"note","title":"Прочитайте про Нурлана.","sub":"","html":"<p class=\"cp-who\">Nurlan</p><p>Hi! I'm Nurlan. I'm a taxi driver.</p><p>I work in Almaty. My car is old but it's good.</p><p>My wife is a nurse. She works in a hospital.</p><p>Our daughter is a student. She studies English.</p>"},{"stage":"Аудирование","type":"choice","title":"True или False?","sub":"","prompt":"Nurlan is a taxi driver.","options":["True","False"],"answer":"True","why":"","html":"<p class=\"cp-who\">Nurlan</p><p>Hi! I'm Nurlan. I'm a taxi driver.</p><p>I work in Almaty. My car is old but it's good.</p><p>My wife is a nurse. She works in a hospital.</p><p>Our daughter is a student. She studies English.</p>","src":null},{"stage":"Аудирование","type":"choice","title":"True или False?","sub":"","prompt":"His wife works in a school.","options":["True","False"],"answer":"False","why":"","html":"<p class=\"cp-who\">Nurlan</p><p>Hi! I'm Nurlan. I'm a taxi driver.</p><p>I work in Almaty. My car is old but it's good.</p><p>My wife is a nurse. She works in a hospital.</p><p>Our daughter is a student. She studies English.</p>","src":null},{"stage":"Аудирование","type":"gap","title":"Прочитайте ещё раз. Дополните предложение.","sub":"","before":"His wife is","after":"nurse.","answers":["a"],"bank":["a","the","an"],"why":"","html":"<p class=\"cp-who\">Nurlan</p><p>Hi! I'm Nurlan. I'm a taxi driver.</p><p>I work in Almaty. My car is old but it's good.</p><p>My wife is a nurse. She works in a hospital.</p><p>Our daughter is a student. She studies English.</p>","src":null},{"stage":"Аудирование","type":"choice","title":"Прочитайте ещё раз. Выберите правильный ответ.","sub":"","prompt":"Чем занимается их дочь?","options":["She's a nurse.","She's a taxi driver.","She's a student."],"keep":false,"answer":"She's a student.","why":"","html":"<p class=\"cp-who\">Nurlan</p><p>Hi! I'm Nurlan. I'm a taxi driver.</p><p>I work in Almaty. My car is old but it's good.</p><p>My wife is a nurse. She works in a hospital.</p><p>Our daughter is a student. She studies English.</p>","src":null},{"stage":"Говорение","type":"write","title":"Напишите о своей работе.","sub":"Ваша профессия, место работы и профессия ещё одного человека.","placeholder":"","html":"<ul class=\"cp-frames\"><li>I'm ___ .</li><li>I work in ___ .</li><li>My ___ is ___ .</li></ul><div class=\"cp-note__chips\"><span class=\"cp-note__chip\">a</span><span class=\"cp-note__chip\">an</span><span class=\"cp-note__chip\">teacher</span><span class=\"cp-note__chip\">student</span><span class=\"cp-note__chip\">engineer</span><span class=\"cp-note__chip\">doctor</span><span class=\"cp-note__chip\">an office</span><span class=\"cp-note__chip\">a school</span><span class=\"cp-note__chip\">a hospital</span><span class=\"cp-note__chip\">I work in</span></div>","modelHtml":"<ul class=\"cp-checks\"><li>Перед профессией стоит <b>a</b> или <b>an</b>.</li><li>Я написал(а), где работаю или учусь.</li><li>Для he или she глагол с <b>-s</b>.</li></ul>"},{"stage":"Говорен