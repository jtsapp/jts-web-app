rse/a0/audio/336e9b1437bb.mp3","prompt":"","options":["yellow","green","grey"],"answer":"yellow","html":""},{"stage":"Слова","type":"listen","title":"Послушайте. Выберите цвет.","sub":"","src":"/course/a0/audio/33ecbb2f4ec0.mp3","prompt":"","options":["black","blue","brown"],"answer":"brown","html":""},{"stage":"Слова","type":"cards","title":"Слова урока","sub":"Нажми на карточку, чтобы увидеть перевод","words":[{"en":"big","pos":"","ru":"большой","kk":"үлкен","def":"It's a big kitchen.","img":null,"icon":"<rect x=\"5\" y=\"3.6\" width=\"14\" height=\"16.8\" rx=\"2.4\"/><path d=\"M9 7.6h2M13 7.6h2M9 11.6h2M13 11.6h2M9 15.6h6\"/>","audio":"/learning/audio/a0/95c4bea12e4e.mp3"},{"en":"small","pos":"","ru":"маленький","kk":"кішкентай","def":"My flat is small.","img":null,"icon":"<rect x=\"4.4\" y=\"2.8\" width=\"15.2\" height=\"18.4\" rx=\"3\"/><path d=\"M8 7.4h8\"/><path d=\"M8.4 12h.02M12 12h.02M15.6 12h.02M8.4 16.4h.02M12 16.4h.02M15.6 16.4h.02\" stroke-width=\"2.6\"/>","audio":"/learning/audio/a0/89f6229a11ac.mp3"},{"en":"long","pos":"","ru":"длинный","kk":"ұзын","def":"A long street.","img":null,"icon":"<path d=\"M4 20.2 5 16l10.8-10.8a2.2 2.2 0 0 1 3.1 3.1L8 19.2z\"/><path d=\"m13.9 7.3 3 3\"/>","audio":"/learning/audio/a0/bd3027fa569e.mp3"},{"en":"new","pos":"","ru":"новый","kk":"жаңа","def":"Is it a new laptop?","img":null,"icon":"<path d=\"m12 3.6 2.6 5.3 5.8.9-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.9z\"/>","audio":"/learning/audio/a0/c2a6b03f190d.mp3"},{"en":"old","pos":"","ru":"старый","kk":"ескі","def":"No, it's three years old.","img":null,"icon":"<circle cx=\"12\" cy=\"12\" r=\"8.2\"/><path d=\"M12 7v5.2l3.4 2\"/>","audio":"/learning/audio/a0/c00dbbc9dadf.mp3"}]},{"stage":"Слова","type":"match","title":"Соедините противоположные слова.","sub":"","pairs":[{"left":"big","right":"small"},{"left":"new","right":"old"},{"left":"black","right":"white"},{"left":"long","right":"short"}],"options":["old","small","white","short"]},{"stage":"Грамматика","type":"phrases","title":"Послушайте два предложения.","sub":"Рядом с вами или далеко?","items":[{"text":"This is my laptop.","src":"/learning/audio/a0/a3f74ef9d7ba.mp3"},{"text":"That bag over there is my brother's.","src":"/learning/audio/a0/829bbfa7f95f.mp3"}]},{"stage":"Грамматика","type":"note","title":"this / that / these / those","sub":"","html":"<table class=\"cp-table\"><tr><th></th><th>Рядом</th><th>Далеко</th></tr><tr><td>one</td><td>this — This is a pen.</td><td>that — That's a wallet.</td></tr><tr><td>many</td><td>these — These are keys.</td><td>those — Those are books.</td></tr><tr><td>?</td><td>What's this?</td><td>What are those?</td></tr></table><p><b>this / these</b> — рядом. <b>that / those</b> — дальше.</p><p><b>this / that</b> — один предмет, <b>these / those</b> — два и больше.</p><p>С несколькими предметами меняется и глагол: <b>These are</b> keys.</p>"},{"stage":"Грамматика","type":"note","title":"Цвет и размер перед словом","sub":"","html":"<table class=\"cp-table\"><tr><th></th><th>Предложение</th><th>Заметка</th></tr><tr><td>1</td><td>a big kitchen</td><td>size before the noun</td></tr><tr><td>2</td><td>a black bag</td><td>colour before the noun</td></tr><tr><td>3</td><td>a small red car</td><td>size, then colour</td></tr></table><p>Описывающее слово стоит <b>перед</b> существительным: a <b>black</b> bag.</p><p>К нему не добавляется <b>-s</b>: two <b>black</b> bags.</p><p>Сначала размер, потом цвет: a small red car.</p><p class=\"cp-note__fwd\">Другие описательные слова будут в уроке 17.</p>"},{"stage":"Грамматика","type":"note","title":"Смотрите и слушайте.","sub":"","html":"","examples":["What's this in English?","It's an umbrella.","What are these?","They're keys.","That's a big black bag.","Those books are old."]},{"stage":"Практика","type":"choice","title":"Выберите правильное слово.","sub":"","prompt":"___ is my laptop. It's here.","options":["Those","That","This"],"keep":false,"answer":"This","why":"","html":"","src":null},{"stage":"Практика","type":"choice","title":"Выберите правильное слово.","sub":"","prompt":"___ are my keys. They're here.","options":["These","This","That"],"keep":false,"answer":"These","why":"","html":"","src":null},{"stage":"Практика","type":"choice","title":"Выберите правильное слово.","sub":"","prompt":"___ books over there are old.","options":["This","Those","These"],"keep":false,"answer":"Those","why":"Далеко + много → those.","html":"","src":null},{"stage":"Практика","type":"gap","title":"Дополните предложение.","sub":"","before":"— What's this? —","after":"an umbrella.","answers":["It's"],"bank":["It's","These","They're"],"why":"","html":"","src":null},{"stage":"Практика","type":"gap","title":"Дополните предложение.","sub":"","before":"— What are these? —","after":"keys.","answers":["They're"],"bank":["They're","That's","It's"],"why":"","html":"","src":null},{"stage":"Практика","type":"gap","title":"Дополните предложение.","sub":"","before":"That","after":"bag is my brother's.","answers":["black"],"bank":["black","blacks","black's"],"why":"","html":"","src":null},{"stage":"Практика","type":"cols","title":"Один предмет или несколько?","sub":"","columns":["this / that","these / those"],"items":[{"text":"This is a pen.","col":0},{"text":"Those are books.","col":1},{"text":"This is my bag.","col":0},{"text":"These are my keys.","col":1},{"text":"These are pens.","col":1},{"text":"That's a book.","col":0}]},{"stage":"Практика","type":"order","title":"Расставьте слова по порядку.","sub":"","words":["this","is","What","in","English?"],"answer":"What is this in English?","why":""},{"stage":"Практика","type":"order","title":"Расставьте слова по порядку.","sub":"","words":["are","keys.","new","my","These"],"answer":"These are my new keys.","why":""},{"stage":"Практика","type":"order","title":"Расставьте слова по порядку.","sub":"","words":["is","a","That","red","car.","small"],"answer":"That is a small red car.","why":""},{"stage":"Практика","type":"mistake","title":"Найдите ошибку.","sub":"Нажмите на неправильное слово.","tokens":["This","are","my","keys."],"bad":0,"answer":"These are my keys.","why":"Два и больше → these."},{"stage":"Практика","type":"mistake","title":"Найдите ошибку.","sub":"Нажмите на неправильное слово.","tokens":["It's","a","bag","black."],"bad":3,"answer":"It's a black bag.","why":"Цвет ставится перед существительным."},{"stage":"Практика","type":"mistake","title":"Найдите ошибку.","sub":"Нажмите на неправильное слово.","tokens":["Those","is","my","books."],"bad":1,"answer":"Those are my books.","why":"С those — are."},{"stage":"Аудирование","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/a21c4ee34e3d.mp3","prompt":"— What's this in English?","options":["It's a wallet.","It's an umbrella.","They're notepads."],"answer":"It's an umbrella.","html":""},{"stage":"Аудирование","type":"gap","title":"Послушайте. Дополните ответ.","sub":"","src":"/course/a0/audio/b9f0203ab5ec.mp3","before":"— What's that in English? — It's a","after":".","answers":["wallet"],"bank":["wallet","notepad","pen"]},{"stage":"Аудирование","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/f4cf8b9f37b2.mp3","prompt":"Сколько предметов?","options":["One","Two or more"],"answer":"Two or more","html":""},{"stage":"Аудирование","type":"listen","title":"Послушайте. Выберите правильный ответ.","sub":"","src":"/course/a0/audio/e4bac341f6be.mp3","prompt":"— What are those in English?","options":["They're pens.","It's a pen.","They're keys."],"answer":"They're pens.","html":""},{"stage":"Аудирование","type":"note","title":"Прочитайте про Тома.","sub":"","html":"<p class=\"cp-who\">Tom</p><p>Hi! I'm Tom. This is my desk.</p><p>This is my new laptop. It's grey and small.</p><p>Those are my books. They're old but they're good.</p><p>That black bag over there is my brother's.</p>"},{"stage":"Аудирование","type":"choice","title":"True или False?","sub":"","prompt":"Tom's laptop is grey.","options":["True","False"],"answer":"True","why":"","html":"<p class=\"cp-who\">Tom</p><p>Hi! I'm Tom. This is my desk.</p><p>This is my new laptop. It's grey and small.</p><p>Those are my books. They're old but they're good.</p><p>That black bag over there is my brother's.</p>","src":null},{"stage":"Аудирование","type":"choice","title":"True или False?","sub":"","prompt":"The black bag is Tom's.","options":["True","False"],"answer":"False","why":"","html":"<p class=\"cp-who\">Tom</p><p>Hi! I'm Tom. This is my desk.</p><p>This is my new laptop. It's grey and small.</p><p>Those are my books. They're old but they're good.</p><p>That black bag over there is my brother's.</p>","src":null},{"stage":"Аудирование","type":"gap","title":"Прочитайте ещё раз. Дополните предложение.","sub":"","before":"","after":"are his books.","answers":["Those"],"bank":["That","Those","This"],"why":"","html":"<p class=\"cp-who\">Tom</p><p>Hi! I'm Tom. This is my desk.</p><p>This is my new laptop. It's grey and small.</p><p>Those are my books. They're old but they're good.</p><p>That black bag over there is my brother's.</p>","src":null},{"stage":"Говорение","type":"write","title":"Напишите о своём столе.","sub":"Один предмет рядом и два подальше.","placeholder":"","html":"<ul class=\"cp-frames\"><li>This is ___ .</li><li>Those are ___ .</li><li>My ___ is ___ .</li></ul><div class=\"cp-note__chips\"><span class=\"cp-note__chip\">This is</span><span class=\"cp-note__chip\">That's</span><span class=\"cp-note__chip\">These are</span><span class=\"cp-note__chip\">Those are</span><span class=\"cp-note__chip\">a black</span><span class=\"cp-note__chip\">a small</span><span class=\"cp-note__chip\">a new</span><span class=\"cp-note__chip\">laptop</span><span class=\"cp-note__chip\">keys</span><span class=\"cp-note__chip\">books</span></div>","modelHtml":"<ul class=\"cp-checks\"><li>Для близкого предмета я использовал(а) <b>this</b> или <b>these</b>.</li><li>С <b>these / those</b> я поставил(а) <b>are</b>.</li><li>Цвет стоит перед существительным.</li></ul>"},{"stage":"Говорение","type":"record","title":"Произнесите предложения. Запишите и послушайте.","sub":"Сначала послушайте каждое предложение.","items":["What's this in English?","It's a black wallet.","These are my keys.","Those books are old."],"itemAudio":["/learning/audio/a0/257ca13c4964.mp3","/learning/audio/a0/8196acbe8898.mp3","/learning/audio/a0/aaf77713f048.mp3","/learning/audio/a0/5ddd70c13a0c.mp3"]},{"stage":"Итоги","type":"checklist","title":"Урок 10 пройден","sub":"Урок 10 из 24 · Юнит 3","items":["Я могу назвать повседневные предметы.","Я могу использовать this, that, these и those.","Я могу назвать цвет и размер."]}]}
