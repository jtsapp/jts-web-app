{"unit":7,"no":26,"title":"World records","blurb":"Unit 7","VOCAB":[["mountain","","гора","тау",""],["lake","","озеро","көл",""],["desert","","пустыня","шөл",""],["island","","остров","арал",""],["coast","","побережье","жағалау",""],["river","","река","өзен",""],["ocean","","океан","мұхит",""],["forest","","лес","орман",""],["pyramid","","пирамида","пирамида",""],["population","","население","халық саны",""],["high","","высокий","биік",""],["deep","","глубокий","терең",""],["wide","","широкий","кең",""],["popular","","популярный","танымал",""]],"SLIDES":[["🏔️","Everest is the highest mountain on Earth."]],"PICWORDS":["mountain","lake","desert","island","coast","river","ocean","forest","pyramid","population","high","deep","wide","popular"],"DEFS":[],"CTX":{},"COLLOC":{},"IMG":{},"NOTES":{},"TIMING":{},"tracks":{"10_11":"A1_L26_10_11.mp3","10_9":"A1_L26_10_9.mp3","10_12":"A1_L26_10_12.mp3"},"SEGS":{"10_11":[3.7,null],"10_9":[3.47,null],"10_12":[3.34,null]},"html":"\n  <section class=\"stage on\" data-stage=\"Intro\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 1 &middot; Intro</div>\n      <h2>World records</h2>\n      <p>Talk about the most extreme things in the world — and in your own life.</p>\n    </div>\n\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"self\"><div class=\"blab\">In other words</div><div><b>How to study</b> — about 25 minutes, top to bottom.</div><div>Headphones on. This lesson has real audio — tap ▶ to listen.</div><div>After each <b>Check answers</b>, read the note — that is your teacher.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with a partner. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with your teacher. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Warm-up\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 2 &middot; Warm-up</div>\n      <h2>Warm-up</h2>\n    </div>\n\n      <div class=\"instruction\">Quick! Guess the record.</div>\n      <p class=\"subline\">Tap your answers — no googling!</p>\n      <div class=\"grid3\" style=\"margin-top:16px\"><div class=\"card\"><b>🏔️</b> &nbsp;the highest mountain?</div><div class=\"card\"><b>🏞️</b> &nbsp;the deepest lake?</div><div class=\"card\"><b>🏜️</b> &nbsp;the biggest desert?</div><div class=\"card\"><b>✈️</b> &nbsp;the busiest airport?</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Words\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 3 &middot; Words</div>\n      <h2>Words</h2>\n    </div>\n\n      <div class=\"vbar\">\n        <div class=\"instruction\" style=\"margin:0\">Read the words. Click a card to see an example.</div>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"trToggle\"><span class=\"track\"></span><span>Show translation</span></label>\n      </div>\n      <div class=\"words\" id=\"words\"></div>\n\n      <div class=\"instruction\">These are your geography words for this lesson.</div>\n      <p class=\"subline\">Tap 🔊 to listen. Turn on translations only if you need them.</p>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Recall\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 4 &middot; Recall</div>\n      <h2>Recall</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Choose the correct word.</div>\n      <div class=\"task\" data-task data-tid=\"l26s3SSt1\" data-only=\"self\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Baikal is a very deep ___.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">river</button><button class=\"opt\" data-val=\"b\">lake</button><button class=\"opt\" data-val=\"c\">deserts</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">The Sahara and the Gobi are ___.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">deserts</button><button class=\"opt\" data-val=\"b\">forests</button><button class=\"opt\" data-val=\"c\">lake</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Phuket is a famous ___.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">island</button><button class=\"opt\" data-val=\"b\">pyramid</button><button class=\"opt\" data-val=\"c\">lake</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">The Amazon is a river and also a rain___.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">coast</button><button class=\"opt\" data-val=\"b\">lake</button><button class=\"opt\" data-val=\"c\">forest</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">The number of people in a country is its ___.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">population</button><button class=\"opt\" data-val=\"b\">ocean</button><button class=\"opt\" data-val=\"c\">lake</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">The opposite of “shallow” water is ___ water.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">wide</button><button class=\"opt\" data-val=\"b\">deep</button><button class=\"opt\" data-val=\"c\">lake</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\" data-only=\"self\"><div class=\"blab\">Why</div><p>lake · deserts · island · rainforest · population · deep.</p></div>\n      <div class=\"instruction\" data-only=\"group\">Match each place to its example.</div>\n      <p class=\"subline\" data-only=\"group\">Tap a word, then tap the example.</p>\n      <p class=\"subline\" data-only=\"group\"><b>Place</b> &rarr; <b>Example</b></p>\n      <div class=\"task\" data-task data-tid=\"l26s3GRt3\" data-only=\"group\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>lake</b> <select data-answer=\"Baikal\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>desert</b> <select data-answer=\"the Gobi\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>island</b> <select data-answer=\"Phuket\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>river</b> <select data-answer=\"the Amazon\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>mountain</b> <select data-answer=\"Kilimanjaro\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>ocean</b> <select data-answer=\"the Pacific\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"instruction\" data-only=\"solo\">Match each place to its example.</div>\n      <p class=\"subline\" data-only=\"solo\">Tap a word, then tap the example.</p>\n      <p class=\"subline\" data-only=\"solo\"><b>Place</b> &rarr; <b>Example</b></p>\n      <div class=\"task\" data-task data-tid=\"l26s3OOt5\" data-only=\"solo\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>lake</b> <select data-answer=\"Baikal\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>desert</b> <select data-answer=\"the Gobi\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>island</b> <select data-answer=\"Phuket\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>river</b> <select data-answer=\"the Amazon\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>mountain</b> <select data-answer=\"Kilimanjaro\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>ocean</b> <select data-answer=\"the Pacific\"><option value=\"\">choose&hellip;</option><option value=\"Baikal\">Baikal</option><option value=\"the Gobi\">the Gobi</option><option value=\"Phuket\">Phuket</option><option value=\"the Amazon\">the Amazon</option><option value=\"Kilimanjaro\">Kilimanjaro</option><option value=\"the Pacific\">the Pacific</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Grammar\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 5 &middot; Grammar</div>\n      <h2>Grammar</h2>\n    </div>\n\n      <div class=\"instruction\">the highest, the deepest, the most famous.</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('10_11',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 10.11 — which river is the longest?</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">A: Which river's the longest in the world? B: I think the Nile's the longest. C: Maybe, but I think the Amazon is longer than the Mississippi.</div></details>\n      <div class=\"task\" data-task data-tid=\"l26s4t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">What does B think?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">The Amazon is the longest.</button><button class=\"opt\" data-val=\"b\">The Amazon are the longest.</button><button class=\"opt\" data-val=\"c\">The Nile is the longest.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">“the longest” — the sounds…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">strong /ði:/</button><button class=\"opt\" data-val=\"b\">silent — not pronounced</button><button class=\"opt\" data-val=\"c\">weak /ðə/</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>B says the <b>Nile</b> · “the” is a little weak /ðə/ before a consonant.</p></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>“Kilimanjaro is <b>the highest</b> mountain in Africa.”</div><div>“Baikal is <b>the biggest, deepest and oldest</b> lake in the world.”</div><div>“Al Hasa is <b>the most beautiful</b> area in the country.”</div><div>“It's <b>one of the easiest</b> mountains to climb.”</div></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Notice:</span> a comparative compares TWO things. What does a superlative do?</p></div>\n      <div style=\"margin-top:18px;overflow-x:auto\"><table class=\"gtable\"><tbody><tr><th>Adjective type</th><th>Rule</th><th>Example</th></tr><tr><td>short</td><td class=\"pos\">the + -est</td><td>the high<b>est</b> mountain · the old<b>est</b> lake</td></tr><tr><td>one vowel + one consonant</td><td class=\"pos\">the + double + est</td><td>the bi<b>ggest</b> · the ho<b>ttest</b></td></tr><tr><td>-y</td><td class=\"pos\">the + -iest</td><td>the bus<b>iest</b> airport · the eas<b>iest</b> mountain</td></tr><tr><td>long adjectives</td><td class=\"pos\">the most + adjective</td><td>the <b>most famous</b> island · the <b>most beautiful</b> area</td></tr><tr><td>irregular</td><td class=\"pos\">new word</td><td>the <b>best</b> · the <b>worst</b> · the <b>furthest</b></td></tr><tr><td colspan=\"3\">“<b>one of the</b> + superlative + plural”: one of the largest volcanoes in the world.</td></tr></tbody></table></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>Superlative = number one in a group: <b>the</b> + -est / <b>the most</b> + adjective.</div><div>Always with <b>the</b>. And “in the world / in Africa” — not “of the world”.</div><div>Irregular: the <b>best</b>, the <b>worst</b>.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Practice\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 6 &middot; Practice</div>\n      <h2>Practice</h2>\n    </div>\n\n      <div class=\"instruction\">Part 1 — Make the superlative.</div>\n      <div class=\"task\" data-task data-tid=\"l26s5t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">high →\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">the most high</button><button class=\"opt\" data-val=\"b\">the biggest</button><button class=\"opt\" data-val=\"c\">the highest</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">big →\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">the bigest</button><button class=\"opt\" data-val=\"b\">the bigests</button><button class=\"opt\" data-val=\"c\">the biggest</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">busy →\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">the busiest</button><button class=\"opt\" data-val=\"b\">the busyest</button><button class=\"opt\" data-val=\"c\">the busiests</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">famous →\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">the most famous</button><button class=\"opt\" data-val=\"b\">the famousest</button><button class=\"opt\" data-val=\"c\">the highest</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">good →\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">the goodest</button><button class=\"opt\" data-val=\"b\">the best</button><button class=\"opt\" data-val=\"c\">the bests</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">bad →\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">the baddest</button><button class=\"opt\" data-val=\"b\">the worst</button><button class=\"opt\" data-val=\"c\">the worsts</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>the highest · the bi<b>gg</b>est · the bus<b>iest</b> · the <b>most</b> famous · the <b>best</b> · the <b>worst</b>.</p></div>\n      <div class=\"task\" data-task data-tid=\"l26s5t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">❌ “Baikal is the most oldest lake.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Baikal is the oldest lake.</button><button class=\"opt\" data-val=\"b\">Baikal is most old lake.</button><button class=\"opt\" data-val=\"c\">Baikal are the oldest lake.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">❌ “It's the deepest lake of the world.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">It's the deepest lake in the world.</button><button class=\"opt\" data-val=\"b\">It's the deepest lake at the world.</button><button class=\"opt\" data-val=\"c\">It've the deepest lake in the world.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">❌ “Everest is the higher mountain on Earth.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Everest is the most high mountain on Earth.</button><button class=\"opt\" data-val=\"b\">Everest is the highest mountain on Earth.</button><button class=\"opt\" data-val=\"c\">Everest are the most high mountain on Earth.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>never “most + -est” · <b>in</b> the world · number one → superlative (highest), not comparative.</p></div>\n      <div class=\"task\" data-task data-tid=\"l26s5t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Madagascar is ___ than Sumatra.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">the biggest</button><button class=\"opt\" data-val=\"b\">more big</button><button class=\"opt\" data-val=\"c\">bigger</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Greenland is ___ island of the three.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">bigger</button><button class=\"opt\" data-val=\"b\">the biggest</button><button class=\"opt\" data-val=\"c\">more big</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The Parthenon is ___ than the Colosseum.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">older</button><button class=\"opt\" data-val=\"b\">the oldest</button><button class=\"opt\" data-val=\"c\">the older</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>two things → -er than · number one in the group → the -est.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Read\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 7 &middot; Read</div>\n      <h2>Read</h2>\n    </div>\n\n      <div class=\"instruction\">The highest, the deepest, the oldest — and one big surprise.</div>\n      <div class=\"task\" data-task data-tid=\"l26s6t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">What is the surprising record?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Everest is the highest mountain.</button><button class=\"opt\" data-val=\"b\">The biggest desert is Antarctica.</button><button class=\"opt\" data-val=\"c\">Airports are busy.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Antarctica — the coldest AND driest place — is technically the biggest desert.</p></div>\n      <div class=\"task\" data-task data-tid=\"l26s6t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Kilimanjaro is the highest mountain on Earth.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Baikal has almost 20% of the world's fresh water.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The Sahara is the biggest desert.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">The oldest person to climb Kilimanjaro was 87.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Kilimanjaro is the highest <b>in Africa</b> (Everest on Earth) · Antarctica beats the Sahara · and yes — 87 years old!</p></div>\n      <div class=\"task\" data-task data-tid=\"l26s6t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">“It is ___ the easiest big mountains to climb.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">one of</button><button class=\"opt\" data-val=\"b\">some of</button><button class=\"opt\" data-val=\"c\">ones of</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">“The ___ airports are in big cities.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">busyest</button><button class=\"opt\" data-val=\"b\">busiest</button><button class=\"opt\" data-val=\"c\">population</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Find the word that means “the number of people”.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">pyramid</button><button class=\"opt\" data-val=\"b\">population</button><button class=\"opt\" data-val=\"c\">record</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>one of the easiest + plural · bus<b>iest</b> · population.</p></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Before you read:</span> which is the biggest desert in the world? Are you sure?</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Listen\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 8 &middot; Listen</div>\n      <h2>Listen</h2>\n    </div>\n\n      <div class=\"instruction\">Baikal, Kilimanjaro and the largest oasis on Earth.</div>\n      <p class=\"subline\">Listen once. Then choose the correct answers.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('10_9',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 10.9 — three natural wonders</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">Lake Baikal in Siberia is the biggest, deepest and oldest lake in the world. It's more than 1,600 metres deep and more than twenty-five million years old. It has almost twenty per cent of the world's freshwater. — Mount Kilimanjaro, in Tanzania, is one of the largest volcanoes in the world. It's 5,895 metres tall — the highest mountain in Africa, sometimes called the 'Roof of Africa'. It's also one of the easiest mountains to climb. The oldest person ever to climb to the top was a Frenchman, Valtee Daniel — eighty-seven years old. — An oasis is an area of water in a desert, and Al Hasa is the largest oasis in Saudi Arabia. It gives water to over three million trees and a million people. Many Saudis believe Al Hasa is the most beautiful and best area to visit in the country.</div></details>\n      <div class=\"task\" data-task data-tid=\"l26s7t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">How deep is Lake Baikal?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">About 600 metres</button><button class=\"opt\" data-val=\"b\">160 metres</button><button class=\"opt\" data-val=\"c\">More than 1,600 metres</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">What is Kilimanjaro sometimes called?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">The Old Volcano</button><button class=\"opt\" data-val=\"b\">The White Mountain</button><button class=\"opt\" data-val=\"c\">The Roof of Africa</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">How old was the oldest climber?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">87</button><button class=\"opt\" data-val=\"b\">78</button><button class=\"opt\" data-val=\"c\">97</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">What does Al Hasa give water to?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">One small village</button><button class=\"opt\" data-val=\"b\">Three million trees and a million people</button><button class=\"opt\" data-val=\"c\">Only tourists</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>1,600+ metres deep · the Roof of Africa · Valtee Daniel, 87 · three million trees and a million people.</p></div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('10_12',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 10.12 — three records</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 The busiest airport of the three is Beijing, then Dubai and then Los Angeles. 2 Of these islands, Greenland is the biggest, and Madagascar is bigger than Sumatra. 3 The Great Pyramid of Giza isn't the oldest monument in the world, but it's the oldest in this group — older than the Parthenon, and the Parthenon's older than the Colosseum.</div></details>\n      <div class=\"task\" data-task data-tid=\"l26s7t6\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">The busiest airport of the three is…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Dubai</button><button class=\"opt\" data-val=\"b\">Los Angeles</button><button class=\"opt\" data-val=\"c\">Beijing</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">The biggest island of the three is…\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Greenland</button><button class=\"opt\" data-val=\"b\">Madagascar</button><button class=\"opt\" data-val=\"c\">Sumatra</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Beijing wins the airports · Greenland wins the islands.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Write\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 9 &middot; Write</div>\n      <h2>Write</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">World records are fun — but write YOUR records.</div>\n      <p class=\"subline\" data-only=\"self\">5–6 sentences with superlatives about your own life.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"self\"><div class=\"blab\">Useful language</div><ul><li>The best day of my life was…</li><li>The most beautiful place I know is…</li><li>The longest trip I…</li><li>My oldest friend is…</li><li>The worst film I…</li><li>one of the most…</li></ul></div>\n      <div class=\"instruction\" data-only=\"group\">Interview your partner about their personal records.</div>\n      <p class=\"subline\" data-only=\"group\">Five questions. Then report the best one to another pair.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"group\"><div class=\"blab\">Useful language</div><ul><li>What was the best…?</li><li>The most beautiful place I know is…</li><li>My longest trip was…</li><li>one of the most…</li><li>Really? Tell me more!</li><li>That's the strangest record!</li></ul></div>\n      <div class=\"instruction\" data-only=\"solo\">Interview your teacher about their personal records.</div>\n      <p class=\"subline\" data-only=\"solo\">Five questions. Then report the best one to your teacher.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"solo\"><div class=\"blab\">Useful language</div><ul><li>What was the best…?</li><li>The most beautiful place I know is…</li><li>My longest trip was…</li><li>one of the most…</li><li>Really? Tell me more!</li><li>That's the strangest record!</li></ul></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — ask five record questions: “What was the best day of your life? The most beautiful place you know? Your longest trip? Your oldest friend? The worst film?”</div><div><b>Step 2</b> — swap roles.</div><div><b>Step 3</b> — report the most interesting record to another pair: “Her longest trip was three days on a train!”</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — ask five record questions: “What was the best day of your life? The most beautiful place you know? Your longest trip? Your oldest friend? The worst film?”</div><div><b>Step 2</b> — swap roles.</div><div><b>Step 3</b> — report the most interesting record to your teacher: “Her longest trip was three days on a train!”</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Type it\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 10 &middot; Type it</div>\n      <h2>Type it</h2>\n    </div>\n\n      <div class=\"instruction\">Now produce it — type, don’t tap.</div>\n      <p class=\"subline\">Spelling counts. Type the answers, then check.</p>\n      <div class=\"task\" data-task data-tid=\"l26s9t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Everest is ___ mountain in the world. (high)<br><input class=\"gap gap-lg\" data-answer=\"the highest\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">My grandfather is the ___ person in our family. (old)<br><input class=\"gap gap-lg\" data-answer=\"oldest\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Almaty is the biggest city ___ Kazakhstan.<br><input class=\"gap gap-lg\" data-answer=\"in\" placeholder=\"Type the missing word…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>the + -est (the highest) \\u00b7 long \\u2192 the most + adjective \\u00b7 good \\u2192 the best \\u00b7 + in the world.</p></div>\n      <div class=\"task\" data-task data-tid=\"l26s9t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Everest is the most high mountain.<br><input class=\"gap gap-lg\" data-answer=\"Everest is the highest mountain.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">She is the goodest singer.<br><input class=\"gap gap-lg\" data-answer=\"She is the best singer.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The Nile is longest river in the world.<br><input class=\"gap gap-lg\" data-answer=\"The Nile is the longest river in the world.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>the + -est (the highest) \\u00b7 long \\u2192 the most + adjective \\u00b7 good \\u2192 the best \\u00b7 + in the world.</p></div>\n      <div class=\"task\" data-task data-tid=\"l26s9t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Superlative with BIG: Almaty / city / Kazakhstan<br><input class=\"gap gap-lg\" data-answer=\"Almaty is the biggest city in Kazakhstan.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Superlative with COLD: Antarctica / place / the world<br><input class=\"gap gap-lg\" data-answer=\"Antarctica is the coldest place in the world.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Superlative with EXPENSIVE: this hotel / town<br><input class=\"gap gap-lg\" data-answer=\"This is the most expensive hotel in town.|It is the most expensive hotel in town.\" placeholder=\"Type the new sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>the + -est (the highest) \\u00b7 long \\u2192 the most + adjective \\u00b7 good \\u2192 the best \\u00b7 + in the world.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Done\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 11 &middot; Done</div>\n      <h2>Done</h2>\n    </div>\n\n  </section>\n\n"}