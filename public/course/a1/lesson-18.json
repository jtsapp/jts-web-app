{"unit":5,"no":18,"title":"Instagram stories","blurb":"Unit 5","VOCAB":[["jacket","","куртка","күрте",""],["coat","","пальто","пальто",""],["jumper","","свитер","жемпір",""],["shirt","","рубашка","жейде",""],["T-shirt","","футболка","футболка",""],["jeans","","джинсы","джинсы",""],["trousers","","брюки","шалбар",""],["skirt","","юбка","белдемше",""],["dress","","платье","көйлек",""],["suit","","костюм","костюм",""],["trainers","","кроссовки","кроссовка",""],["boots","","ботинки","етік",""],["scarf","","шарф","мойынорағыш",""],["gloves","","перчатки","қолғап",""],["wear","","носить","кию",""],["try on","","примерять","өлшеп көру",""]],"SLIDES":[["🧥","She's wearing a red coat."]],"PICWORDS":["jacket","coat","jumper","shirt","T-shirt","jeans","trousers","skirt","dress","suit","trainers","boots","scarf","gloves","wear","try on"],"DEFS":[],"CTX":{},"COLLOC":{},"IMG":{},"NOTES":{},"TIMING":{},"tracks":{"5_6":"A1_L18_5_6.mp3","5_8":"A1_L18_5_8.mp3","5_7":"A1_L18_5_7.mp3"},"SEGS":{"5_6":[3.41,null],"5_8":[5.42,null],"5_7":[3.72,null]},"html":"\n  <section class=\"stage on\" data-stage=\"Intro\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 1 &middot; Intro</div>\n      <h2>Instagram stories</h2>\n      <p>Describe what is happening right now — including what people are wearing.</p>\n    </div>\n\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"self\"><div class=\"blab\">In other words</div><div><b>How to study</b> — about 25 minutes, top to bottom.</div><div>Headphones on. This lesson has real audio — tap ▶ to listen.</div><div>After each <b>Check answers</b>, read the note — that is your teacher.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with a partner. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with your teacher. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Warm-up\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 2 &middot; Warm-up</div>\n      <h2>Warm-up</h2>\n    </div>\n\n      <div class=\"instruction\">Right now, this minute — what is true?</div>\n      <p class=\"subline\">Tap everything that is happening around you.</p>\n      <div class=\"grid3\" style=\"margin-top:16px\"><div class=\"card\"><b>☕</b> &nbsp;I'm drinking something</div><div class=\"card\"><b>🎧</b> &nbsp;I'm wearing headphones</div><div class=\"card\"><b>🛋️</b> &nbsp;I'm sitting on a sofa</div><div class=\"card\"><b>🚌</b> &nbsp;I'm travelling somewhere</div><div class=\"card\"><b>🌧️</b> &nbsp;it's raining outside</div><div class=\"card\"><b>📱</b> &nbsp;my phone is dying</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Words\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 3 &middot; Words</div>\n      <h2>Words</h2>\n    </div>\n\n      <div class=\"vbar\">\n        <div class=\"instruction\" style=\"margin:0\">Read the words. Click a card to see an example.</div>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"trToggle\"><span class=\"track\"></span><span>Show translation</span></label>\n      </div>\n      <div class=\"words\" id=\"words\"></div>\n\n      <div class=\"instruction\">These are your clothes words for this lesson.</div>\n      <p class=\"subline\">Tap 🔊 to listen. Turn on translations only if you need them.</p>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Recall\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 4 &middot; Recall</div>\n      <h2>Recall</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Choose the correct word.</div>\n      <div class=\"task\" data-task data-tid=\"l18s3SSt1\" data-only=\"self\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">It's -20° outside. Put on your ___ and gloves!\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">T-shirt</button><button class=\"opt\" data-val=\"b\">coat</button><button class=\"opt\" data-val=\"c\">suit</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">He has a job interview — he's wearing a ___.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">skirt</button><button class=\"opt\" data-val=\"b\">suit</button><button class=\"opt\" data-val=\"c\">coat</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">For running you need good ___.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">gloves</button><button class=\"opt\" data-val=\"b\">trainers</button><button class=\"opt\" data-val=\"c\">coat</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">It's cold around my neck — where is my ___?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">shirt</button><button class=\"opt\" data-val=\"b\">scarf</button><button class=\"opt\" data-val=\"c\">coat</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">Before you buy trousers, ___ first.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">wear them</button><button class=\"opt\" data-val=\"b\">try them on</button><button class=\"opt\" data-val=\"c\">on your legs</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">Jeans, trousers and a skirt — you wear them…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">on your head</button><button class=\"opt\" data-val=\"b\">on your legss</button><button class=\"opt\" data-val=\"c\">on your legs</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\" data-only=\"self\"><div class=\"blab\">Why</div><p>coat + gloves for winter · a suit for the interview · trainers for running · a scarf for your neck · try on before you buy.</p></div>\n      <div class=\"instruction\" data-only=\"group\">Match each clothes word to its picture.</div>\n      <p class=\"subline\" data-only=\"group\">Tap a word, then tap its picture.</p>\n      <p class=\"subline\" data-only=\"group\"><b>Word</b> &rarr; <b>Picture</b></p>\n      <div class=\"task\" data-task data-tid=\"l18s3GRt3\" data-only=\"group\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>coat</b> <select data-answer=\"🧥\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>dress</b> <select data-answer=\"👗\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>trainers</b> <select data-answer=\"👟\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>boots</b> <select data-answer=\"🥾\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>scarf</b> <select data-answer=\"🧣\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>gloves</b> <select data-answer=\"🧤\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"instruction\" data-only=\"solo\">Match each clothes word to its picture.</div>\n      <p class=\"subline\" data-only=\"solo\">Tap a word, then tap its picture.</p>\n      <p class=\"subline\" data-only=\"solo\"><b>Word</b> &rarr; <b>Picture</b></p>\n      <div class=\"task\" data-task data-tid=\"l18s3OOt5\" data-only=\"solo\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>coat</b> <select data-answer=\"🧥\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>dress</b> <select data-answer=\"👗\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>trainers</b> <select data-answer=\"👟\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>boots</b> <select data-answer=\"🥾\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>scarf</b> <select data-answer=\"🧣\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>gloves</b> <select data-answer=\"🧤\"><option value=\"\">choose&hellip;</option><option value=\"🧥\">🧥</option><option value=\"👗\">👗</option><option value=\"👟\">👟</option><option value=\"🥾\">🥾</option><option value=\"🧣\">🧣</option><option value=\"🧤\">🧤</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Grammar\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 5 &middot; Grammar</div>\n      <h2>Grammar</h2>\n    </div>\n\n      <div class=\"instruction\">The Present Continuous — happening right now.</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('5_6',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 5.6 — Paul and Anita</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 Paul is wearing a suit. 2 Anita and Paul are having a meeting with their boss. 3 They aren't working today.</div></details>\n      <div class=\"task\" data-task data-tid=\"l18s4t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Sentence 1 —\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Paul is buying a suit.</button><button class=\"opt\" data-val=\"b\">Paul are wearing a suit.</button><button class=\"opt\" data-val=\"c\">Paul is wearing a suit.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Sentence 2 —\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">They are having lunch with their boss.</button><button class=\"opt\" data-val=\"b\">They is having a meeting with their boss.</button><button class=\"opt\" data-val=\"c\">They are having a meeting with their boss.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Sentence 3 —\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">They aren't walking today.</button><button class=\"opt\" data-val=\"b\">They aren't workings today.</button><button class=\"opt\" data-val=\"c\">They aren't working today.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>wearing · having a meeting · aren't <b>working</b> — listen for the -ing verb.</p></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>“Paul <b>is wearing</b> a suit.”</div><div>“I<b>'m buying</b> clothes, of course.”</div><div>“They <b>aren't working</b> today.”</div><div>“<b>What are you doing?</b>”</div></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Notice:</span> every sentence has TWO parts: a form of <b>be</b> — and the verb with <b>-ing</b>.</p></div>\n      <div style=\"margin-top:18px;overflow-x:auto\"><table class=\"gtable\"><tbody><tr><th>Form</th><th>Example</th></tr><tr><td>Positive</td><td class=\"pos\">I<b>'m buying</b> clothes. · Paul <b>is wearing</b> a suit. · The kids <b>are making</b> noise.</td></tr><tr><td>Negative</td><td class=\"pos\">They <b>aren't working</b> today. · I<b>'m not running</b> yet.</td></tr><tr><td>Question</td><td class=\"pos\"><b>What are you doing?</b> · <b>Is it raining?</b> — Yes, it is.</td></tr><tr><td>spelling</td><td>sit → si<b>tt</b>ing · make → mak<b>ing</b> · run → ru<b>nn</b>ing · lie → <b>lying</b></td></tr></tbody></table></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>Use the Present Continuous for actions happening <b>now, at the moment</b>.</div><div>Build it with <b>am / is / are + verb-ing</b>: I'm eating, she's running.</div><div>Both parts are necessary: “I wearing” ✗ · “I'm wear” ✗ · “I'm wearing” ✓.</div><div>Time words: now, right now, at the moment, today.</div><div>Now vs every day — the big comparison — comes in Lesson 19.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Practice\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 6 &middot; Practice</div>\n      <h2>Practice</h2>\n    </div>\n\n      <div class=\"instruction\">Part 1 — Complete each sentence.</div>\n      <div class=\"task\" data-task data-tid=\"l18s5t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">She ___ a red scarf today.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">is wearing</button><button class=\"opt\" data-val=\"b\">is wear</button><button class=\"opt\" data-val=\"c\">are wearing</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">I ___ for the bus right now.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">'m waiting</button><button class=\"opt\" data-val=\"b\">waiting</button><button class=\"opt\" data-val=\"c\">'re having</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">They ___ TV — they're sleeping!\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">aren't watching</button><button class=\"opt\" data-val=\"b\">don't watching</button><button class=\"opt\" data-val=\"c\">doesn't watching</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">___ you listening to me?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Do</button><button class=\"opt\" data-val=\"b\">Are</button><button class=\"opt\" data-val=\"c\">Is</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">The dog ___ around the kitchen.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">is runing</button><button class=\"opt\" data-val=\"b\">is running</button><button class=\"opt\" data-val=\"c\">are running</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">We ___ lunch at the moment.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">'re having</button><button class=\"opt\" data-val=\"b\">'re haveing</button><button class=\"opt\" data-val=\"c\">'re havings</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>be + verb-ing, both parts: is wearing · 'm waiting · aren't watching · Are you listening · ru<b>nn</b>ing · hav<b>ing</b>.</p></div>\n      <div class=\"task\" data-task data-tid=\"l18s5t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">❌ “I wearing jeans today.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">I am wear jeans today.</button><button class=\"opt\" data-val=\"b\">I'm wearing jeans today.</button><button class=\"opt\" data-val=\"c\">I wearing jeans today.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">❌ “She is run to the bus.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">She is running to the bus.</button><button class=\"opt\" data-val=\"b\">She is runing to the bus.</button><button class=\"opt\" data-val=\"c\">She are running to the bus.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">❌ “He's makeing dinner.”\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">He's makking dinner.</button><button class=\"opt\" data-val=\"b\">He've makking dinner.</button><button class=\"opt\" data-val=\"c\">He's making dinner.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>I<b>'m</b> wearing (don't drop be) · ru<b>nn</b>ing · mak<b>ing</b> (drop the e).</p></div>\n      <div class=\"task\" data-task data-tid=\"l18s5t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">___ you busy right now?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Do</button><button class=\"opt\" data-val=\"b\">Is</button><button class=\"opt\" data-val=\"c\">Are</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">I can ___ you back later — I'm cooking now.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">calling</button><button class=\"opt\" data-val=\"b\">Are</button><button class=\"opt\" data-val=\"c\">call</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Sorry, she ___ talk now — she's driving.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">can't</button><button class=\"opt\" data-val=\"b\">isn't</button><button class=\"opt\" data-val=\"c\">Are</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Are you busy · can + base verb: can call, can't talk.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Read\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 7 &middot; Read</div>\n      <h2>Read</h2>\n    </div>\n\n      <div class=\"instruction\">Three people, three stories, one Saturday.</div>\n      <div class=\"task\" data-task data-tid=\"l18s6t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Who is very comfortable and warm?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">@marat.runs</button><button class=\"opt\" data-val=\"b\">@aizhan_kz</button><button class=\"opt\" data-val=\"c\">@tila_travel</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Who is a little nervous?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">@aizhan_kz</button><button class=\"opt\" data-val=\"b\">@marat.runs</button><button class=\"opt\" data-val=\"c\">@tila_travel</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Aizhan is in a café with hot chocolate; Marat's heart is doing boom-boom before the marathon.</p></div>\n      <div class=\"task\" data-task data-tid=\"l18s6t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Aizhan is drinking coffee.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">It's raining where Aizhan is.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Marat is running right now.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">Tila is standing on the Great Wall right now.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">Tila's feet hurt.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Hot chocolate, not coffee · Marat is <b>not running yet</b> · Tila is lying on the bed NOW — the Wall photo is from earlier today.</p></div>\n      <div class=\"task\" data-task data-tid=\"l18s6t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">“I'm ___ on my hotel bed.” (lie)\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">lieing</button><button class=\"opt\" data-val=\"b\">is</button><button class=\"opt\" data-val=\"c\">lying</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">“The sun ___ shining.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">are</button><button class=\"opt\" data-val=\"b\">is</button><button class=\"opt\" data-val=\"c\">am</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">What is Aizhan wearing?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">A red scarf</button><button class=\"opt\" data-val=\"b\">A blue coat</button><button class=\"opt\" data-val=\"c\">A new yellow jumper</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>lie → <b>lying</b> · the sun <b>is</b> shining · a new yellow jumper.</p></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Before you read:</span> when do people usually post stories — on a boring day or a special day?</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Listen\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 8 &middot; Listen</div>\n      <h2>Listen</h2>\n    </div>\n\n      <div class=\"instruction\">A phone call: “What are you doing?!”</div>\n      <p class=\"subline\">Listen once. Then choose the correct answers.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('5_8',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 5.8 — the call from the clothes shop</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">L: Hello? M: Where are you? L: I'm in a clothes shop. Why? M: Because I need your help. What are you doing? L: What am I doing? What do people usually do in clothes shops? I'm buying clothes, of course. M: Well, are you nearly finished? I'm trying to cook a meal for six people, and the kids are making a lot of noise and the dog's running around and… L: Why are the kids there? They go to tennis practice on Thursdays. M: Not today because it's raining. They never play in the rain. L: OK, I'm paying now. I'll be back in an hour. M: An hour? Why…</div></details>\n      <div class=\"task\" data-task data-tid=\"l18s7t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Where is she?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">In a clothes shop</button><button class=\"opt\" data-val=\"b\">At tennis practice</button><button class=\"opt\" data-val=\"c\">At home</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">What is he trying to do?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Watch TV</button><button class=\"opt\" data-val=\"b\">Sleep</button><button class=\"opt\" data-val=\"c\">Cook a meal for six people</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Why are the kids at home?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">It's a holiday.</button><button class=\"opt\" data-val=\"b\">It's raining — no tennis today.</button><button class=\"opt\" data-val=\"c\">They are ill.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">What is the dog doing?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Running around</button><button class=\"opt\" data-val=\"b\">Sleeping</button><button class=\"opt\" data-val=\"c\">Eating</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>She's buying clothes · he's cooking for six · rain stopped the tennis · and the dog is running around!</p></div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('5_7',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 5.7 — the colours you wear</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">Most of us have a colour, or two colours, that we wear more than others. Are you wearing black? People who often wear black like to be the boss. It can make you look serious and important. I'm wearing white today — if you often wear white, you like things to be tidy and clean, and you enjoy a simple life. Blue means you are a peaceful person and you don't like change. Are you wearing red? You are probably a strong person and you always try hard. Finally, who is wearing yellow? You are the good students, because you love learning — and you are a lot of fun!</div></details>\n      <div class=\"task\" data-task data-tid=\"l18s7t6\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">People who often wear black…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">love learning.</button><button class=\"opt\" data-val=\"b\">like to be the boss.</button><button class=\"opt\" data-val=\"c\">hate working in a team.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">People who wear yellow…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">don't like change.</button><button class=\"opt\" data-val=\"b\">is fun and love learning.</button><button class=\"opt\" data-val=\"c\">are fun and love learning.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Black → the boss · yellow → fun + learning. What are YOU wearing today?</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Write\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 9 &middot; Write</div>\n      <h2>Write</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Write three story captions about YOUR day — morning, afternoon, now.</div>\n      <p class=\"subline\" data-only=\"self\">Each caption: 2 sentences in the Present Continuous.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"self\"><div class=\"blab\">Useful language</div><ul><li>I'm sitting / drinking / waiting…</li><li>I'm wearing…</li><li>It's raining / shining</li><li>Right now…</li><li>at the moment</li><li>Wish me luck!</li></ul></div>\n      <div class=\"instruction\" data-only=\"group\">Describe a famous person's look — clothes, colours, style: “She's wearing…” Your partner guesses who it is.</div>\n      <p class=\"subline\" data-only=\"group\">Only what they are wearing and doing — no names!</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"group\"><div class=\"blab\">Useful language</div><ul><li>He's / She's wearing…</li><li>She's sitting next to…</li><li>He's holding…</li><li>She's looking at…</li><li>Is it…?</li><li>Yes! Your turn.</li></ul></div>\n      <div class=\"instruction\" data-only=\"solo\">Describe a famous person's look — clothes, colours, style: “She's wearing…” Your teacher guesses who it is.</div>\n      <p class=\"subline\" data-only=\"solo\">Only what they are wearing and doing — no names!</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"solo\"><div class=\"blab\">Useful language</div><ul><li>He's / She's wearing…</li><li>She's sitting next to…</li><li>He's holding…</li><li>She's looking at…</li><li>Is it…?</li><li>Yes! Your turn.</li></ul></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — choose a person in the room (or a famous person in a photo everyone knows).</div><div><b>Step 2</b> — describe them: “She's wearing a blue jumper. She's sitting near the window. She's looking at her phone…”</div><div><b>Step 3</b> — your partner guesses. Three rounds each, then swap.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — choose a person in the room (or a famous person in a photo everyone knows).</div><div><b>Step 2</b> — describe them: “She's wearing a blue jumper. She's sitting near the window. She's looking at her phone…”</div><div><b>Step 3</b> — your teacher guesses. Three rounds each, then swap.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Type it\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 10 &middot; Type it</div>\n      <h2>Type it</h2>\n    </div>\n\n      <div class=\"instruction\">Now produce it — type, don’t tap.</div>\n      <p class=\"subline\">Spelling counts. Type the answers, then check.</p>\n      <div class=\"task\" data-task data-tid=\"l18s9t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">She is ___ a red scarf. (wear)<br><input class=\"gap gap-lg\" data-answer=\"wearing\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">He ___ dancing right now.<br><input class=\"gap gap-lg\" data-answer=\"is\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">They ___ watching TV.<br><input class=\"gap gap-lg\" data-answer=\"are\" placeholder=\"Type the missing word…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>be + verb-ing = happening now: She IS wearING \\u00b7 both parts are needed.</p></div>\n      <div class=\"task\" data-task data-tid=\"l18s9t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">She wearing a red scarf.<br><input class=\"gap gap-lg\" data-answer=\"She is wearing a red scarf.|She's wearing a red scarf.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">I am wear jeans.<br><input class=\"gap gap-lg\" data-answer=\"I am wearing jeans.|I'm wearing jeans.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">They is dancing.<br><input class=\"gap gap-lg\" data-answer=\"They are dancing.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>be + verb-ing = happening now: She IS wearING \\u00b7 both parts are needed.</p></div>\n      <div class=\"task\" data-task data-tid=\"l18s9t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Say it about NOW: He wears a suit.<br><input class=\"gap gap-lg\" data-answer=\"He is wearing a suit.|He's wearing a suit.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Make a question: She is crying.<br><input class=\"gap gap-lg\" data-answer=\"Is she crying?|Why is she crying?\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Make it negative: It is raining.<br><input class=\"gap gap-lg\" data-answer=\"It isn't raining.|It's not raining.\" placeholder=\"Type the new sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>be + verb-ing = happening now: She IS wearING \\u00b7 both parts are needed.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Done\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 11 &middot; Done</div>\n      <h2>Done</h2>\n    </div>\n\n  </section>\n\n"}