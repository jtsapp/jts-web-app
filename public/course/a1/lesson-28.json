{"unit":7,"no":28,"title":"A rule book for tourists","blurb":"Unit 8","VOCAB":[["flight","","рейс","рейс",""],["luggage","","багаж","жүк",""],["passport","","паспорт","төлқұжат",""],["ticket","","билет","билет",""],["single","","в одну сторону","бір жаққа",""],["return","","туда-обратно","барып-қайту",""],["platform","","платформа","платформа",""],["delay","","задержка","кешігу",""],["underground","","метро","метро",""],["miss the bus","","опоздать на автобус","автобустан қалу",""],["go on foot","","идти пешком","жаяу жүру",""],["custom","","обычай","салт-дәстүр",""],["polite","","вежливый","сыпайы",""],["rude","","грубый","дөрекі",""]],"SLIDES":[["🗺️","You should have a map."]],"PICWORDS":["flight","luggage","passport","ticket","single","return","platform","delay","underground","miss the bus","go on foot","custom","polite","rude"],"DEFS":[],"CTX":{},"COLLOC":{},"IMG":{},"NOTES":{},"TIMING":{},"tracks":{"8_9":"A1_L28_8_9.mp3","8_10":"A1_L28_8_10.mp3","8_14":"A1_L28_8_14.mp3","8_19":"A1_L28_8_19.mp3"},"SEGS":{"8_9":[3.59,null],"8_10":[3.51,null],"8_14":[3.98,null],"8_19":[3.69,null]},"html":"\n  <section class=\"stage on\" data-stage=\"Intro\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 1 &middot; Intro</div>\n      <h2>A rule book for tourists</h2>\n      <p>Give advice and talk about rules: what you should do — and what you have to do.</p>\n    </div>\n\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"self\"><div class=\"blab\">In other words</div><div><b>How to study</b> — about 25 minutes, top to bottom.</div><div>Headphones on. This lesson has real audio — tap ▶ to listen.</div><div>After each <b>Check answers</b>, read the note — that is your teacher.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with a partner. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with your teacher. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Warm-up\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 2 &middot; Warm-up</div>\n      <h2>Warm-up</h2>\n    </div>\n\n      <div class=\"instruction\">A foreign friend visits your country tomorrow. What is important?</div>\n      <p class=\"subline\">Tap the TWO most important things to tell them.</p>\n      <div class=\"grid3\" style=\"margin-top:16px\"><div class=\"card\"><b>👟</b> &nbsp;shoes off — or not?</div><div class=\"card\"><b>💶</b> &nbsp;cash or card?</div><div class=\"card\"><b>🎁</b> &nbsp;gifts and tips</div><div class=\"card\"><b>🗣️</b> &nbsp;loud or quiet in public?</div><div class=\"card\"><b>🍽️</b> &nbsp;food rules</div><div class=\"card\"><b>🚌</b> &nbsp;how to use transport</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Words\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 3 &middot; Words</div>\n      <h2>Words</h2>\n    </div>\n\n      <div class=\"vbar\">\n        <div class=\"instruction\" style=\"margin:0\">Read the words. Click a card to see an example.</div>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"trToggle\"><span class=\"track\"></span><span>Show translation</span></label>\n      </div>\n      <div class=\"words\" id=\"words\"></div>\n\n      <div class=\"instruction\">These are your travel words for this lesson.</div>\n      <p class=\"subline\">Tap 🔊 to listen. Turn on translations only if you need them.</p>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Recall\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 4 &middot; Recall</div>\n      <h2>Recall</h2>\n    </div>\n\n      <div class=\"instruction\">take, miss, go — the transport verbs. Listen, then choose.</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('8_9',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 8.9 — transport collocations</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 You take or get the train, the underground, a taxi or the bus. 2 You can miss the bus, your plane or your train. 3 You go on foot. 4 You go by public transport, by bike or by car.</div></details>\n      <div class=\"task\" data-task data-tid=\"l28s3t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">You ___ the train or the bus.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">take</button><button class=\"opt\" data-val=\"b\">miss</button><button class=\"opt\" data-val=\"c\">missed</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">You were late and the bus left. You ___ the bus.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">took</button><button class=\"opt\" data-val=\"b\">take</button><button class=\"opt\" data-val=\"c\">missed</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">No transport — you go ___ foot.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">by</button><button class=\"opt\" data-val=\"b\">on</button><button class=\"opt\" data-val=\"c\">take</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">You go ___ bike or ___ car.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">on / on</button><button class=\"opt\" data-val=\"b\">by / by</button><button class=\"opt\" data-val=\"c\">silent — not pronounced</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">A ___ ticket = there and back.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">single</button><button class=\"opt\" data-val=\"b\">take</button><button class=\"opt\" data-val=\"c\">return</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">The train is 40 minutes late — there's a ___.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">platform</button><button class=\"opt\" data-val=\"b\">delay</button><button class=\"opt\" data-val=\"c\">take</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>take the train · miss the bus · on foot · by bike/car · return = both ways · a delay.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Grammar\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 5 &middot; Grammar</div>\n      <h2>Grammar</h2>\n    </div>\n\n      <div class=\"instruction\">should = a good idea. have to = a rule.</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('8_10',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 8.10 — four sentences</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 You should have a map. 2 You shouldn't take a taxi. 3 You have to wear it. 4 You don't have to pay.</div></details>\n      <div class=\"task\" data-task data-tid=\"l28s4t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">1 — “You should have a map.” is…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">a rule (necessary)</button><button class=\"opt\" data-val=\"b\">advice (a good idea)</button><button class=\"opt\" data-val=\"c\">an rule (necessary)</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">3 — “You have to wear it.” is…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">advice</button><button class=\"opt\" data-val=\"b\">an rule (necessary)</button><button class=\"opt\" data-val=\"c\">a rule (necessary)</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">4 — “You don't have to pay.” means…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">paying is a bad idea</button><button class=\"opt\" data-val=\"b\">paying is not necessary</button><button class=\"opt\" data-val=\"c\">paying are not necessary</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>should → advice · have to → rule · don't have to → not necessary.</p></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>“You <b>should</b> have a map.” (good idea)</div><div>“You <b>shouldn't</b> take a taxi.” (bad idea)</div><div>“You <b>have to</b> wear it.” (a rule — necessary)</div><div>“You <b>don't have to</b> pay.” (not necessary — it's free)</div></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Notice:</span> which sentences are ADVICE — and which are RULES?</p></div>\n      <div style=\"margin-top:18px;overflow-x:auto\"><table class=\"gtable\"><tbody><tr><th>Form</th><th>Meaning</th><th>Example</th></tr><tr><td class=\"pos\">should</td><td>a good idea (advice)</td><td>You <b>should</b> have a map.</td></tr><tr><td class=\"neg\">shouldn't</td><td>a bad idea</td><td>You <b>shouldn't</b> take a taxi.</td></tr><tr><td class=\"pos\">have to / has to</td><td>necessary (a rule)</td><td>You <b>have to</b> wear it. · She <b>has to</b> start at seven.</td></tr><tr><td class=\"neg\">don't have to</td><td>NOT necessary (but you can)</td><td>You <b>don't have to</b> pay — it's free.</td></tr></tbody></table></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div><b>should / shouldn't + base verb</b> — advice, a good or bad idea.</div><div><b>have to + base verb</b> — necessary; he/she <b>has to</b>.</div><div><b>don't have to</b> = you CAN, but it's not necessary. Very different from shouldn't!</div><div>“You don't have to tip” = tipping is optional. “You shouldn't tip” = tipping is a bad idea.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Practice\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 6 &middot; Practice</div>\n      <h2>Practice</h2>\n    </div>\n\n      <div class=\"instruction\">Part 1 — should, shouldn't, have to or don't have to?</div>\n      <div class=\"task\" data-task data-tid=\"l28s5t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">It's cold there — you ___ wear warm clothes. (good idea)\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">have to</button><button class=\"opt\" data-val=\"b\">should</button><button class=\"opt\" data-val=\"c\">must to</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">You ___ show your passport at the border. (the rule)\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">should</button><button class=\"opt\" data-val=\"b\">have to</button><button class=\"opt\" data-val=\"c\">must to</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The museum is free — you ___ pay.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">shouldn't</button><button class=\"opt\" data-val=\"b\">don't have to</button><button class=\"opt\" data-val=\"c\">don't should</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">You ___ drink the tap water there. (bad idea)\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">don't have to</button><button class=\"opt\" data-val=\"b\">don't should</button><button class=\"opt\" data-val=\"c\">shouldn't</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">She ___ to start work at seven. (rule)\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">have</button><button class=\"opt\" data-val=\"b\">has</button><button class=\"opt\" data-val=\"c\">is</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">The school gives you a book, so you ___ buy one.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">have to</button><button class=\"opt\" data-val=\"b\">don't have to</button><button class=\"opt\" data-val=\"c\">don't has to</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>advice → should(n't) · rule → have to / has to · not necessary → don't have to.</p></div>\n      <div class=\"task\" data-task data-tid=\"l28s5t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">❌ “You should to buy a return ticket.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">You should buying a return ticket.</button><button class=\"opt\" data-val=\"b\">You should buy a return ticket.</button><button class=\"opt\" data-val=\"c\">You should buying an return ticket.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">❌ “He have to check in at six.”\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">He haves to check in at six.</button><button class=\"opt\" data-val=\"b\">He have to check in at six.</button><button class=\"opt\" data-val=\"c\">He has to check in at six.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">❌ “You don't should be late.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">You don't have be late.</button><button class=\"opt\" data-val=\"b\">You shouldn't be late.</button><button class=\"opt\" data-val=\"c\">You don't has be late.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>should + base verb · he <b>has to</b> · the negative of should is <b>shouldn't</b>.</p></div>\n      <div class=\"task\" data-task data-tid=\"l28s5t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">You ___ take photos here — it's allowed.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">can</button><button class=\"opt\" data-val=\"b\">have to</button><button class=\"opt\" data-val=\"c\">has to</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">You ___ smoke on the platform. (not allowed)\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">don't have to</button><button class=\"opt\" data-val=\"b\">don't has to</button><button class=\"opt\" data-val=\"c\">can't</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">___ forget your passport! (instruction)\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Not</button><button class=\"opt\" data-val=\"b\">Don't</button><button class=\"opt\" data-val=\"c\">can</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>allowed → can · not allowed → can't · instruction → Don't + verb.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Read\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 7 &middot; Read</div>\n      <h2>Read</h2>\n    </div>\n\n      <div class=\"instruction\">A rule book for visitors to Japan.</div>\n      <div class=\"task\" data-task data-tid=\"l28s6t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">The text is…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">a story about a trip to Japan.</button><button class=\"opt\" data-val=\"b\">a hotel advertisement.</button><button class=\"opt\" data-val=\"c\">rules and advice for visitors to Japan.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>What you have to do, should do — and don't have to do.</p></div>\n      <div class=\"task\" data-task data-tid=\"l28s6t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">You have to speak Japanese.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">You have to take off your shoes in homes.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">You should eat while you walk in the street.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">You have to carry some cash.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">You have to give tips.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Japanese is optional · shoes off — yes · no eating while walking · cash — yes · tips — <b>don't have to</b>!</p></div>\n      <div class=\"task\" data-task data-tid=\"l28s6t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">“You don't have to give tips” means…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">tips are a bad idea.</button><button class=\"opt\" data-val=\"b\">tips are not necessary.</button><button class=\"opt\" data-val=\"c\">tips is not necessary.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">“You shouldn't talk loudly on the train” is…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">a law</button><button class=\"opt\" data-val=\"b\">an law</button><button class=\"opt\" data-val=\"c\">advice</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Find the word that means “a tradition, a normal way of doing things”.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">custom</button><button class=\"opt\" data-val=\"b\">delay</button><button class=\"opt\" data-val=\"c\">platform</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>don't have to = optional · shouldn't = advice · <b>custom</b>.</p></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Before you read:</span> what do you know about the rules in Japan? Shoes? Tips? Trains?</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Listen\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 8 &middot; Listen</div>\n      <h2>Listen</h2>\n    </div>\n\n      <div class=\"instruction\">Advice from someone who lived in Moscow for three years.</div>\n      <p class=\"subline\">Listen once. Then choose the correct answers.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('8_14',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 8.14 — Moscow, from a local</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">G: I'm going to Moscow for two months. You went to Moscow a few years ago, didn't you? H: Yes — I even lived there for three years. G: Do you speak the language? H: A little. I can buy things in shops and order food. G: What did you think of the transport system? H: The Underground is fantastic! It was built in the 1930s, and every station is a work of art. Local people complain about it, but I always thought it was very good — and quite cheap. G: Do the local people use the buses? H: Oh yes, the buses are usually full. But I got taxis quite a lot to my lessons — I didn't want to be late! And one great thing: you can simply stand in the street and stop any car, like a taxi, and they give you a lift for money.</div></details>\n      <div class=\"task\" data-task data-tid=\"l28s7t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">How long did she live in Moscow?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Two months</button><button class=\"opt\" data-val=\"b\">Ten years</button><button class=\"opt\" data-val=\"c\">Three years</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">The Underground was built…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">last year</button><button class=\"opt\" data-val=\"b\">in the 1930s</button><button class=\"opt\" data-val=\"c\">in the 1990s</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">What does she say about the buses?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">They are empty.</button><button class=\"opt\" data-val=\"b\">They are usually full.</button><button class=\"opt\" data-val=\"c\">There are no buses.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">What is the “one great thing”?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">You can stop any car like a taxi.</button><button class=\"opt\" data-val=\"b\">Taxis are free.</button><button class=\"opt\" data-val=\"c\">The trains never stop.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Three years · the 1930s — every station a work of art · full buses · and you can stop any car for a lift.</p></div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('8_19',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 8.19 — a ticket to Manchester</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">A: Hello. Can I help you? B: When's the next bus to Manchester? A: There's one at 4.00. B: How much does it cost? A: Do you want a single or return ticket? B: A return, please. A: When would you like to come back? B: Next Sunday. A: OK, that's £32, please. B: How long does it take? A: Two hours 45 minutes. B: Where does it leave from? A: Bay six. It's just over there.</div></details>\n      <div class=\"task\" data-task data-tid=\"l28s7t6\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">What ticket does he buy?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">a return — £32</button><button class=\"opt\" data-val=\"b\">a single — £32</button><button class=\"opt\" data-val=\"c\">an return — £32</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Where does the bus leave from?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Platform two</button><button class=\"opt\" data-val=\"b\">Bay six</button><button class=\"opt\" data-val=\"c\">Gate four</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>A return for £32 · bay six, just over there.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Project\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 9 &middot; Project</div>\n      <h2>Project</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Write the rule book for visitors to YOUR country.</div>\n      <p class=\"subline\" data-only=\"self\">Five rules: two with have to, two with should/shouldn't, one with don't have to.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"self\"><div class=\"blab\">Useful language</div><ul><li>You have to…</li><li>You don't have to…</li><li>You should…</li><li>You shouldn't…</li><li>It's polite to… / It's rude to…</li><li>In our custom,…</li></ul></div>\n      <div class=\"instruction\" data-only=\"group\">Write your country's rule book — together.</div>\n      <p class=\"subline\" data-only=\"group\">Five rules. Then exchange with another pair.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"group\"><div class=\"blab\">Useful language</div><ul><li>You have to…</li><li>You should…</li><li>You shouldn't…</li><li>You don't have to…</li><li>It's polite / rude to…</li><li>In our custom,…</li></ul></div>\n      <div class=\"instruction\" data-only=\"solo\">Write your country's rule book — together.</div>\n      <p class=\"subline\" data-only=\"solo\">Five rules. Then exchange with your teacher.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"solo\"><div class=\"blab\">Useful language</div><ul><li>You have to…</li><li>You should…</li><li>You shouldn't…</li><li>You don't have to…</li><li>It's polite / rude to…</li><li>In our custom,…</li></ul></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — with your partner, write five rules for visitors to your country: two with <b>have to</b>, two with <b>should/shouldn't</b>, one happy <b>don't have to</b>.</div><div><b>Step 2</b> — exchange rule books with another pair. Read theirs: which rule is the best?</div><div><b>Step 3</b> — role play: one pair are tourists, the other pair answer their questions with the rules.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — with your teacher, write five rules for visitors to your country: two with <b>have to</b>, two with <b>should/shouldn't</b>, one happy <b>don't have to</b>.</div><div><b>Step 2</b> — exchange rule books with your teacher. Read theirs: which rule is the best?</div><div><b>Step 3</b> — role play: one pair are tourists, the other pair answer their questions with the rules.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Type it\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 10 &middot; Type it</div>\n      <h2>Type it</h2>\n    </div>\n\n      <div class=\"instruction\">Now produce it — type, don’t tap.</div>\n      <p class=\"subline\">Spelling counts. Type the answers, then check.</p>\n      <div class=\"task\" data-task data-tid=\"l28s9t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">You ___ carry some cash in Japan. (advice)<br><input class=\"gap gap-lg\" data-answer=\"should\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">She ___ to start work at seven. (rule)<br><input class=\"gap gap-lg\" data-answer=\"has\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">You ___ take a taxi \\u2014 the metro is faster. (bad idea)<br><input class=\"gap gap-lg\" data-answer=\"shouldn't\" placeholder=\"Type the missing word…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>should = good idea \\u00b7 have/has to = rule \\u00b7 don't have to = not necessary.</p></div>\n      <div class=\"task\" data-task data-tid=\"l28s9t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">You should to have a map.<br><input class=\"gap gap-lg\" data-answer=\"You should have a map.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">She have to start at seven.<br><input class=\"gap gap-lg\" data-answer=\"She has to start at seven.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">You not have to pay.<br><input class=\"gap gap-lg\" data-answer=\"You don't have to pay.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>should = good idea \\u00b7 have/has to = rule \\u00b7 don't have to = not necessary.</p></div>\n      <div class=\"task\" data-task data-tid=\"l28s9t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Give the advice: carry cash<br><input class=\"gap gap-lg\" data-answer=\"You should carry some cash.|You should carry cash.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Say the rule: take off your shoes<br><input class=\"gap gap-lg\" data-answer=\"You have to take off your shoes.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Say it is not necessary: tip<br><input class=\"gap gap-lg\" data-answer=\"You don't have to tip.\" placeholder=\"Type the new sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>should = good idea \\u00b7 have/has to = rule \\u00b7 don't have to = not necessary.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Done\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 11 &middot; Done</div>\n      <h2>Done</h2>\n    </div>\n\n  </section>\n\n"}