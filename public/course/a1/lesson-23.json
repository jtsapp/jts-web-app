{"unit":6,"no":23,"title":"Eating out","blurb":"Unit 6","VOCAB":[["book a table","","забронировать столик","үстел брондау",""],["order","","заказать","тапсырыс беру",""],["starter","","закуска","бастапқы тағам",""],["main course","","основное блюдо","негізгі тағам",""],["side dish","","гарнир","қосымша тағам",""],["dessert","","десерт","десерт",""],["bill","","счёт","шот",""],["grilled","","на гриле","грильде піскен",""],["roast","","запечённый","қақталған",""],["baked","","печёный","пеште піскен",""],["fried","","жареный","қуырылған",""],["sparkling water","","газированная вода","газдалған су",""],["waiter","","официант","даяшы",""],["recommend","","рекомендовать","ұсыну",""]],"SLIDES":[["📋","Would you like to order?"]],"PICWORDS":["book a table","order","starter","main course","side dish","dessert","bill","grilled","roast","baked","fried","sparkling water","waiter","recommend"],"DEFS":[],"CTX":{},"COLLOC":{},"IMG":{},"NOTES":{},"TIMING":{},"tracks":{"9_18":"A1_L23_9_18.mp3","9_17":"A1_L23_9_17.mp3","9_16":"A1_L23_9_16.mp3","9_21":"A1_L23_9_21.mp3"},"SEGS":{"9_18":[3.49,null],"9_17":[3.67,null],"9_16":[3.68,null],"9_21":[3.57,null]},"html":"\n  <section class=\"stage on\" data-stage=\"Intro\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 1 &middot; Intro</div>\n      <h2>Eating out</h2>\n      <p>Recommend a place, order a meal — and understand what the waiter asks.</p>\n    </div>\n\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"self\"><div class=\"blab\">In other words</div><div><b>How to study</b> — about 25 minutes, top to bottom.</div><div>Headphones on. This lesson has real audio — tap ▶ to listen.</div><div>After each <b>Check answers</b>, read the note — that is your teacher.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with a partner. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with your teacher. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Warm-up\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 2 &middot; Warm-up</div>\n      <h2>Warm-up</h2>\n    </div>\n\n      <div class=\"instruction\">Eating out — what matters most to you?</div>\n      <p class=\"subline\">Tap your top TWO.</p>\n      <div class=\"grid3\" style=\"margin-top:16px\"><div class=\"card\"><b>😋</b> &nbsp;the food</div><div class=\"card\"><b>💶</b> &nbsp;the price</div><div class=\"card\"><b>🎶</b> &nbsp;the atmosphere</div><div class=\"card\"><b>🪟</b> &nbsp;a table with a view</div><div class=\"card\"><b>⏱️</b> &nbsp;fast service</div><div class=\"card\"><b>📶</b> &nbsp;the Wi-Fi, honestly</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Words\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 3 &middot; Words</div>\n      <h2>Words</h2>\n    </div>\n\n      <div class=\"vbar\">\n        <div class=\"instruction\" style=\"margin:0\">Read the words. Click a card to see an example.</div>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"trToggle\"><span class=\"track\"></span><span>Show translation</span></label>\n      </div>\n      <div class=\"words\" id=\"words\"></div>\n\n      <div class=\"instruction\">These are your restaurant words for this lesson.</div>\n      <p class=\"subline\">Tap 🔊 to listen. Turn on translations only if you need them.</p>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Recall\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 4 &middot; Recall</div>\n      <h2>Recall</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Choose the correct word.</div>\n      <div class=\"task\" data-task data-tid=\"l23s3SSt1\" data-only=\"self\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">The small dish BEFORE the main course is the…\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">starter</button><button class=\"opt\" data-val=\"b\">dessert</button><button class=\"opt\" data-val=\"c\">bill</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">The potatoes next to your chicken are a…\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">side dish</button><button class=\"opt\" data-val=\"b\">main course</button><button class=\"opt\" data-val=\"c\">dessert</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The sweet dish at the end is the…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">bill</button><button class=\"opt\" data-val=\"b\">starter</button><button class=\"opt\" data-val=\"c\">dessert</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">The paper with the price at the end is the…\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">bill</button><button class=\"opt\" data-val=\"b\">menu</button><button class=\"opt\" data-val=\"c\">starter</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">Chicken cooked over fire is…\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">grilled</button><button class=\"opt\" data-val=\"b\">baked</button><button class=\"opt\" data-val=\"c\">starter</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">Water with bubbles is…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">roast</button><button class=\"opt\" data-val=\"b\">starter</button><button class=\"opt\" data-val=\"c\">sparkling</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\" data-only=\"self\"><div class=\"blab\">Why</div><p>starter → main course (+ side dish) → dessert → the bill. Grilled = over fire; sparkling = with bubbles.</p></div>\n      <div class=\"instruction\" data-only=\"group\">Match each course to its example.</div>\n      <p class=\"subline\" data-only=\"group\">Tap a word, then tap the example.</p>\n      <p class=\"subline\" data-only=\"group\"><b>Course</b> &rarr; <b>Example</b></p>\n      <div class=\"task\" data-task data-tid=\"l23s3GRt3\" data-only=\"group\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>starter</b> <select data-answer=\"a small soup\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>main course</b> <select data-answer=\"grilled chicken\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>side dish</b> <select data-answer=\"roast potatoes\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>dessert</b> <select data-answer=\"chocolate cake\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>drink</b> <select data-answer=\"sparkling water\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>the bill</b> <select data-answer=\"£24.50, please\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"instruction\" data-only=\"solo\">Match each course to its example.</div>\n      <p class=\"subline\" data-only=\"solo\">Tap a word, then tap the example.</p>\n      <p class=\"subline\" data-only=\"solo\"><b>Course</b> &rarr; <b>Example</b></p>\n      <div class=\"task\" data-task data-tid=\"l23s3OOt5\" data-only=\"solo\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>starter</b> <select data-answer=\"a small soup\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>main course</b> <select data-answer=\"grilled chicken\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>side dish</b> <select data-answer=\"roast potatoes\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>dessert</b> <select data-answer=\"chocolate cake\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>drink</b> <select data-answer=\"sparkling water\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>the bill</b> <select data-answer=\"£24.50, please\"><option value=\"\">choose&hellip;</option><option value=\"a small soup\">a small soup</option><option value=\"grilled chicken\">grilled chicken</option><option value=\"roast potatoes\">roast potatoes</option><option value=\"chocolate cake\">chocolate cake</option><option value=\"sparkling water\">sparkling water</option><option value=\"£24.50, please\">£24.50, please</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Grammar\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 5 &middot; Grammar</div>\n      <h2>Grammar</h2>\n    </div>\n\n      <div class=\"instruction\">Would you like…? — Could I have…, please?</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_18',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.18 — the ordering phrase bank</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 Would you like to order? 2 Could I have the grilled chicken, please? 3 Would you like any side dishes with that? 4 Can I have some roast potatoes? 5 Would you like something to drink? 6 Can we pay by credit card?</div></details>\n      <div class=\"task\" data-task data-tid=\"l23s4t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">“Would you like to order?” —\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">the customer</button><button class=\"opt\" data-val=\"b\">the chef</button><button class=\"opt\" data-val=\"c\">the waiter</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">“Could I have the grilled chicken, please?” —\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">the customer</button><button class=\"opt\" data-val=\"b\">the waiter</button><button class=\"opt\" data-val=\"c\">the chef</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">“Would you like any side dishes?” —\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">the waiter</button><button class=\"opt\" data-val=\"b\">the customer</button><button class=\"opt\" data-val=\"c\">the chef</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">“Can we pay by credit card?” —\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">the waiter</button><button class=\"opt\" data-val=\"b\">the chef</button><button class=\"opt\" data-val=\"c\">the customer</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Would you like → the waiter offers. Could/Can I have → the customer orders.</p></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>“<b>Would you like</b> to order?” — “Yes, please.”</div><div>“<b>Could I have</b> the grilled chicken, please?”</div><div>“<b>Can I have</b> some roast potatoes?”</div><div>“<b>Would you like</b> something to drink?” — “Some sparkling water, please.”</div></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Notice:</span> which phrases does the WAITER say — and which do YOU say?</p></div>\n      <div style=\"margin-top:18px;overflow-x:auto\"><table class=\"gtable\"><tbody><tr><th>Who</th><th>Says</th><th>Example</th></tr><tr><td>The waiter offers</td><td class=\"pos\">Would you like…?</td><td><b>Would you like</b> a starter? · <b>Would you like</b> something to drink?</td></tr><tr><td>You order</td><td class=\"pos\">Could I have… / Can I have… / I'd like…</td><td><b>Could I have</b> the grilled chicken, please? · <b>I'd like</b> some fish cakes.</td></tr><tr><td>Saying yes / no</td><td class=\"pos\">Yes, please. / No, thanks.</td><td>No, thanks. Just a main course, please.</td></tr></tbody></table></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>The waiter offers with <b>Would you like…?</b> — answer “Yes, please” or “No, thanks”.</div><div>You order with <b>Could I have… / Can I have… / I'd like…</b> + please.</div><div><b>I'd like</b> = I would like — polite “I want”.</div><div>The article matters: <b>the</b> grilled chicken (from the menu) · <b>some</b> potatoes.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Practice\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 6 &middot; Practice</div>\n      <h2>Practice</h2>\n    </div>\n\n      <div class=\"instruction\">Part 1 — Complete the restaurant lines.</div>\n      <div class=\"task\" data-task data-tid=\"l23s5t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">___ you like a starter?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Could</button><button class=\"opt\" data-val=\"b\">have</button><button class=\"opt\" data-val=\"c\">Would</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Could I ___ the baked fish, please?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">like</button><button class=\"opt\" data-val=\"b\">have</button><button class=\"opt\" data-val=\"c\">do</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">I'd ___ some fish cakes, please.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">like</button><button class=\"opt\" data-val=\"b\">have</button><button class=\"opt\" data-val=\"c\">do</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">Would you like ___ to drink?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">anything</button><button class=\"opt\" data-val=\"b\">something</button><button class=\"opt\" data-val=\"c\">Would</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">“Would you like a dessert?” — “No, ___.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">please</button><button class=\"opt\" data-val=\"b\">thanks</button><button class=\"opt\" data-val=\"c\">Would</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">Could we have the ___, please? We need to go.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">bill</button><button class=\"opt\" data-val=\"b\">menu</button><button class=\"opt\" data-val=\"c\">Would</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Would you like (offer) · Could I have (order) · I'd like · No, thanks · the bill at the end.</p></div>\n      <div class=\"task\" data-task data-tid=\"l23s5t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">❌ “I like the baked fish, please.” (ordering)\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">I liking the baked fish, please.</button><button class=\"opt\" data-val=\"b\">Would you like to order?</button><button class=\"opt\" data-val=\"c\">I'd like the baked fish, please.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">❌ “Could I have any roast potatoes?”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Could I have some roast potatoes?</button><button class=\"opt\" data-val=\"b\">Could I have a roast potatoes?</button><button class=\"opt\" data-val=\"c\">Could I has some roast potatoes?</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">❌ “Would you like order?”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Would you like ordering?</button><button class=\"opt\" data-val=\"b\">Would you like to order?</button><button class=\"opt\" data-val=\"c\">I'd like the baked fish, please.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>I<b>'d</b> like · Could I have <b>some</b> (positive request) · Would you like <b>to</b> order.</p></div>\n      <div class=\"task\" data-task data-tid=\"l23s5t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">How ___ is the bill?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">many</button><button class=\"opt\" data-val=\"b\">a lot</button><button class=\"opt\" data-val=\"c\">much</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">___ we pay by card?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Would</button><button class=\"opt\" data-val=\"b\">much</button><button class=\"opt\" data-val=\"c\">Can</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Just a ___ sugar in my tea, please.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">little</button><button class=\"opt\" data-val=\"b\">few</button><button class=\"opt\" data-val=\"c\">much</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>How <b>much</b> (money) · <b>Can</b> we pay · a <b>little</b> sugar.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Listen\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 7 &middot; Listen</div>\n      <h2>Listen</h2>\n    </div>\n\n      <div class=\"instruction\">A couple orders dinner.</div>\n      <p class=\"subline\">Listen once. Then choose the correct answers.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_17',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.17 — ordering dinner</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">S: Excuse me? W: Hi, would you like to order? S: Yes, please. W: Would you like a starter? S: No, thanks. Just a main course, please. Could I have the grilled chicken? W: Certainly. And would you like any side dishes with that? S: Yes — can I have some roast potatoes and some mixed green vegetables, please? W: Of course. And for you, madam? M: Could I have some fish cakes, please? W: The fish cakes, OK. Anything else? M: A tomato, olive and onion salad, thanks. W: And would you like something to drink? M: Yes, some sparkling water, please. S: And the same for me. Oh, and another question — can we pay by credit card? W: Yes, of course. No problem!</div></details>\n      <div class=\"task\" data-task data-tid=\"l23s6t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Does the man want a starter?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">No — just a main course.</button><button class=\"opt\" data-val=\"b\">Yes, a salad.</button><button class=\"opt\" data-val=\"c\">No — just an main course.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">What main course does he order?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">The fish cakes</button><button class=\"opt\" data-val=\"b\">The grilled chicken</button><button class=\"opt\" data-val=\"c\">The baked fish</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">What side dishes does he choose?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Chips and salad</button><button class=\"opt\" data-val=\"b\">The grilled chicken</button><button class=\"opt\" data-val=\"c\">Roast potatoes and mixed green vegetables</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">What does the woman order?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Fish cakes and a tomato, olive and onion salad</button><button class=\"opt\" data-val=\"b\">Grilled chicken and rice</button><button class=\"opt\" data-val=\"c\">Fish cakes and an tomato, olive and onion salad</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">Can they pay by credit card?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">No — cash only.</button><button class=\"opt\" data-val=\"b\">Yes, of course.</button><button class=\"opt\" data-val=\"c\">The grilled chicken</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>No starter · grilled chicken + roast potatoes and green vegetables · fish cakes + salad · sparkling water × 2 · card is fine.</p></div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_16',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.16 — where's a good place to…?</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 We're looking for a Thai restaurant. 2 You can sit outside on the roof. 3 What's your favourite café for lunch? 4 Do I need to book online? 5 Where's a good place to have some cake? 6 It has a wonderful menu. 7 You don't need to call them and book. 8 Do you know anywhere that has a garden? 9 There's a place called the Riverside with a nice view. 10 My favourite place is Café Blanc because it sells French food.</div></details>\n      <div class=\"task\" data-task data-tid=\"l23s6t6\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">“Where's a good place to have some ___?”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">fish</button><button class=\"opt\" data-val=\"b\">cake</button><button class=\"opt\" data-val=\"c\">cakes</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">The Riverside has…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">a garden</button><button class=\"opt\" data-val=\"b\">an nice view</button><button class=\"opt\" data-val=\"c\">a nice view</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>…a good place to have some <b>cake</b> · the Riverside — a nice <b>view</b>.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Write\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 8 &middot; Write</div>\n      <h2>Write</h2>\n    </div>\n\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_21',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.21 — the short model</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">W: Would you like to order? C: Could I have the baked fish, please? W: Would you like a side dish with that? C: Could I have some roast potatoes, please? W: And would you like something to drink? C: Do you have any apple juice? W: No, we don't. C: OK, just a bottle of water, please.</div></details>\n      <div class=\"instruction\" data-only=\"self\">Listen to the short model. Then write your own restaurant dialogue.</div>\n      <p class=\"subline\" data-only=\"self\">6–8 lines: order a main course, a side dish and a drink.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"self\"><div class=\"blab\">Useful language</div><ul><li>Would you like to order?</li><li>Could I have the…, please?</li><li>Can I have some…?</li><li>Do you have any…?</li><li>Anything else?</li><li>Could we have the bill?</li></ul></div>\n      <div class=\"instruction\" data-only=\"group\">The restaurant. Waiter and customer. Then swap.</div>\n      <p class=\"subline\" data-only=\"group\">Listen to the short model first.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"group\"><div class=\"blab\">Useful language</div><ul><li>Would you like to order?</li><li>Could I have the…, please?</li><li>Do you have any…?</li><li>I'm afraid we don't.</li><li>Anything else?</li><li>Could we have the bill?</li></ul></div>\n      <div class=\"instruction\" data-only=\"solo\">The restaurant. Waiter and customer. Then swap roles.</div>\n      <p class=\"subline\" data-only=\"solo\">Listen to the short model first.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"solo\"><div class=\"blab\">Useful language</div><ul><li>Would you like to order?</li><li>Could I have the…, please?</li><li>Do you have any…?</li><li>I'm afraid we don't.</li><li>Anything else?</li><li>Could we have the bill?</li></ul></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — the waiter invents a small menu: three main courses, three side dishes, three drinks. Tell the customer.</div><div><b>Step 2</b> — the customer orders a full dinner. ONE thing is not available — the waiter says so politely, and the customer chooses again.</div><div><b>Step 3</b> — the customer asks for the bill and how to pay. Then swap roles with a NEW menu.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — the waiter invents a small menu: three main courses, three side dishes, three drinks. Tell the customer.</div><div><b>Step 2</b> — the customer orders a full dinner. ONE thing is not available — the waiter says so politely, and the customer chooses again.</div><div><b>Step 3</b> — the customer asks for the bill and how to pay. Then swap roles with a NEW menu.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Type it\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 9 &middot; Type it</div>\n      <h2>Type it</h2>\n    </div>\n\n      <div class=\"instruction\">Now produce it — type, don’t tap.</div>\n      <p class=\"subline\">Spelling counts. Type the answers, then check.</p>\n      <div class=\"task\" data-task data-tid=\"l23s8t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">I'___ like the grilled chicken, please.<br><input class=\"gap gap-lg\" data-answer=\"d\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Could I ___ the menu, please?<br><input class=\"gap gap-lg\" data-answer=\"have\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Could we have the ___, please? (at the end)<br><input class=\"gap gap-lg\" data-answer=\"bill\" placeholder=\"Type the missing word…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>I'd like / Could I have + please \\u00b7 the waiter offers with Would you like\\u2026?</p></div>\n      <div class=\"task\" data-task data-tid=\"l23s8t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">I like a coffee, please.<br><input class=\"gap gap-lg\" data-answer=\"I'd like a coffee, please.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Could I to have the menu?<br><input class=\"gap gap-lg\" data-answer=\"Could I have the menu?\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Can we to pay by card?<br><input class=\"gap gap-lg\" data-answer=\"Can we pay by card?\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>I'd like / Could I have + please \\u00b7 the waiter offers with Would you like\\u2026?</p></div>\n      <div class=\"task\" data-task data-tid=\"l23s8t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Order politely: the chicken<br><input class=\"gap gap-lg\" data-answer=\"Could I have the chicken, please?|I'd like the chicken, please.|Can I have the chicken, please?\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Ask for the bill politely.<br><input class=\"gap gap-lg\" data-answer=\"Could we have the bill, please?|Can we have the bill, please?|Could I have the bill, please?\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">You are the waiter \\u2014 offer a drink.<br><input class=\"gap gap-lg\" data-answer=\"Would you like something to drink?|Would you like a drink?\" placeholder=\"Type the new sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>I'd like / Could I have + please \\u00b7 the waiter offers with Would you like\\u2026?</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Done\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 10 &middot; Done</div>\n      <h2>Done</h2>\n    </div>\n\n  </section>\n\n"}