{"unit":6,"no":21,"title":"Food and drink","blurb":"Unit 6","VOCAB":[["yoghurt","","йогурт","йогурт",""],["bread","","хлеб","нан",""],["jam","","варенье","тосап",""],["chicken","","курица","тауық еті",""],["honey","","мёд","бал",""],["noodles","","лапша","кеспе",""],["rice","","рис","күріш",""],["olives","","оливки","зәйтүн",""],["mushrooms","","грибы","саңырауқұлақ",""],["pear","","груша","алмұрт",""],["kettle","","чайник","шәйнек",""],["frying pan","","сковорода","таба",""],["saucepan","","кастрюля","кастрөл",""],["oven","","духовка","пеш",""],["microwave","","микроволновка","микротолқынды пеш",""],["bowl","","миска","кесе",""]],"SLIDES":[["🍜","It comes with some noodles."]],"PICWORDS":["yoghurt","bread","jam","chicken","honey","noodles","rice","olives","mushrooms","pear","kettle","frying pan","saucepan","oven","microwave","bowl"],"DEFS":[],"CTX":{},"COLLOC":{},"IMG":{},"NOTES":{},"TIMING":{},"tracks":{"9_1":"A1_L21_9_1.mp3","9_8":"A1_L21_9_8.mp3","9_3":"A1_L21_9_3.mp3","9_2":"A1_L21_9_2.mp3","9_4":"A1_L21_9_4.mp3","9_7":"A1_L21_9_7.mp3"},"SEGS":{"9_1":[3.6,null],"9_8":[3.51,null],"9_3":[3.46,null],"9_2":[4.33,null],"9_4":[3.58,null],"9_7":[3.39,null]},"html":"\n  <section class=\"stage on\" data-stage=\"Intro\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 1 &middot; Intro</div>\n      <h2>Food and drink</h2>\n      <p>Talk about food — and say what there is and isn't in your kitchen.</p>\n    </div>\n\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"self\"><div class=\"blab\">In other words</div><div><b>How to study</b> — about 25 minutes, top to bottom.</div><div>Headphones on. This lesson has real audio — tap ▶ to listen.</div><div>After each <b>Check answers</b>, read the note — that is your teacher.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with a partner. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with your teacher. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Warm-up\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 2 &middot; Warm-up</div>\n      <h2>Warm-up</h2>\n    </div>\n\n      <div class=\"instruction\">Open your fridge (in your head). What is always there?</div>\n      <p class=\"subline\">Tap everything that is in your kitchen right now.</p>\n      <div class=\"grid3\" style=\"margin-top:16px\"><div class=\"card\"><b>🍚</b> &nbsp;rice</div><div class=\"card\"><b>🍞</b> &nbsp;bread</div><div class=\"card\"><b>🥛</b> &nbsp;yoghurt</div><div class=\"card\"><b>🍯</b> &nbsp;honey</div><div class=\"card\"><b>🍄</b> &nbsp;mushrooms</div><div class=\"card\"><b>🫒</b> &nbsp;olives</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Words\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 3 &middot; Words</div>\n      <h2>Words</h2>\n    </div>\n\n      <div class=\"vbar\">\n        <div class=\"instruction\" style=\"margin:0\">Read the words. Click a card to see an example.</div>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"trToggle\"><span class=\"track\"></span><span>Show translation</span></label>\n      </div>\n      <div class=\"words\" id=\"words\"></div>\n\n      <div class=\"instruction\">Food — and the kitchen things you cook it with.</div>\n      <p class=\"subline\">Tap 🔊 to listen. Turn on translations only if you need them.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_1',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.1 — the food word bank</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">yoghurt · bread · a bottle of lemonade · salad · jam · chicken · honey · noodles · lemons · beef · rice · olives · sweetcorn · pasta · mushrooms · a pear</div></details>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_8',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.8 — kitchen equipment</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">an oven · a food-processor · a frying pan · a saucepan · a microwave · a kettle · a fork · a knife · a spoon · plates · bowls</div></details>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Recall\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 4 &middot; Recall</div>\n      <h2>Recall</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Choose the correct word.</div>\n      <div class=\"task\" data-task data-tid=\"l21s3SSt1\" data-only=\"self\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">You boil water for tea in a ___.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">bowl</button><button class=\"opt\" data-val=\"b\">microwave</button><button class=\"opt\" data-val=\"c\">kettle</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">You fry eggs in a ___.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">microwave</button><button class=\"opt\" data-val=\"b\">bowl</button><button class=\"opt\" data-val=\"c\">frying pan</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">You roast chicken in a very hot ___.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">oven</button><button class=\"opt\" data-val=\"b\">saucepan</button><button class=\"opt\" data-val=\"c\">kettle</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">Soup goes in a ___.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">frying pan</button><button class=\"opt\" data-val=\"b\">microwave</button><button class=\"opt\" data-val=\"c\">bowl</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">Bees make ___.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">jam</button><button class=\"opt\" data-val=\"b\">kettle</button><button class=\"opt\" data-val=\"c\">honey</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">Which is a fruit?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">a pear</button><button class=\"opt\" data-val=\"b\">a mushroom</button><button class=\"opt\" data-val=\"c\">an mushroom</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\" data-only=\"self\"><div class=\"blab\">Why</div><p>kettle → tea · frying pan → eggs · oven → roast · bowl → soup · honey — from bees · a pear is a fruit.</p></div>\n      <div class=\"instruction\" data-only=\"group\">Match the kitchen thing to its job.</div>\n      <p class=\"subline\" data-only=\"group\">Tap a thing, then tap what you do with it.</p>\n      <p class=\"subline\" data-only=\"group\"><b>Thing</b> &rarr; <b>Its job</b></p>\n      <div class=\"task\" data-task data-tid=\"l21s3GRt3\" data-only=\"group\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>kettle</b> <select data-answer=\"boil water for tea\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>frying pan</b> <select data-answer=\"fry eggs\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>oven</b> <select data-answer=\"roast a chicken\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>knife</b> <select data-answer=\"chop the onions\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>bowl</b> <select data-answer=\"mix a salad\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>microwave</b> <select data-answer=\"warm it in one minute\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"instruction\" data-only=\"solo\">Match the kitchen thing to its job.</div>\n      <p class=\"subline\" data-only=\"solo\">Tap a thing, then tap what you do with it.</p>\n      <p class=\"subline\" data-only=\"solo\"><b>Thing</b> &rarr; <b>Its job</b></p>\n      <div class=\"task\" data-task data-tid=\"l21s3OOt5\" data-only=\"solo\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>kettle</b> <select data-answer=\"boil water for tea\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>frying pan</b> <select data-answer=\"fry eggs\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>oven</b> <select data-answer=\"roast a chicken\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>knife</b> <select data-answer=\"chop the onions\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>bowl</b> <select data-answer=\"mix a salad\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>microwave</b> <select data-answer=\"warm it in one minute\"><option value=\"\">choose&hellip;</option><option value=\"boil water for tea\">boil water for tea</option><option value=\"fry eggs\">fry eggs</option><option value=\"roast a chicken\">roast a chicken</option><option value=\"chop the onions\">chop the onions</option><option value=\"mix a salad\">mix a salad</option><option value=\"warm it in one minute\">warm it in one minute</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Grammar\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 5 &middot; Grammar</div>\n      <h2>Grammar</h2>\n    </div>\n\n      <div class=\"instruction\">some rice, any bread — countable and uncountable.</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_3',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.3 — six sentences</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 It comes with some noodles. 2 Is there any bread? 3 We don't have any bread. 4 We have some rice. 5 Would you like any drinks? 6 We don't have any bottles of lemonade.</div></details>\n      <div class=\"task\" data-task data-tid=\"l21s4t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">1 — “It comes with ___ noodles.”\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">any</button><button class=\"opt\" data-val=\"b\">a</button><button class=\"opt\" data-val=\"c\">some</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">2 — “Is there ___ bread?”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">some</button><button class=\"opt\" data-val=\"b\">any</button><button class=\"opt\" data-val=\"c\">a</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">4 — “We have ___ rice.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">any</button><button class=\"opt\" data-val=\"b\">some</button><button class=\"opt\" data-val=\"c\">a</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">6 — “We don't have ___ bottles of lemonade.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">some</button><button class=\"opt\" data-val=\"b\">any</button><button class=\"opt\" data-val=\"c\">a</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>positive → some · question / negative → any.</p></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>“It comes with <b>some noodles</b>.”</div><div>“Is there <b>any bread</b>?”</div><div>“We don't have <b>any bread</b>, sorry. But we have <b>some rice</b>.”</div><div>“Would you like <b>any drinks</b>?”</div></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Notice:</span> when do the speakers use <b>some</b> — and when <b>any</b>?</p></div>\n      <div style=\"margin-top:18px;overflow-x:auto\"><table class=\"gtable\"><tbody><tr><th>Type</th><th>What it is</th><th>Example</th></tr><tr><td>Countable</td><td class=\"pos\">you can count them: a…, two…</td><td><b>a</b> lemon, two lemon<b>s</b> · <b>a</b> pear · mushroom<b>s</b></td></tr><tr><td>Uncountable</td><td class=\"pos\">no plural, no a/an</td><td>rice · bread · honey · water · beef</td></tr><tr><td>some</td><td>positive sentences</td><td>We have <b>some</b> rice. · <b>some</b> noodles</td></tr><tr><td>any</td><td>questions and negatives</td><td>Is there <b>any</b> bread? · We don't have <b>any</b> lemonade.</td></tr></tbody></table></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>Countable things have a plural: two lemons. Uncountable things don't: rice, honey, bread.</div><div><b>some</b> → positive sentences: We have some rice.</div><div><b>any</b> → questions and negatives: Is there any bread? We don't have any.</div><div>Uncountable = singular verb: “There <b>is</b> some honey.”</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Practice\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 6 &middot; Practice</div>\n      <h2>Practice</h2>\n    </div>\n\n      <div class=\"instruction\">Part 1 — a, some or any?</div>\n      <div class=\"task\" data-task data-tid=\"l21s5t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Can I have ___ pear?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">some</button><button class=\"opt\" data-val=\"b\">any</button><button class=\"opt\" data-val=\"c\">a</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">We have ___ rice in the cupboard.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">a</button><button class=\"opt\" data-val=\"b\">some</button><button class=\"opt\" data-val=\"c\">any</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">I don't want ___ olives.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">any</button><button class=\"opt\" data-val=\"b\">some</button><button class=\"opt\" data-val=\"c\">a</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">Do you have ___ mushrooms?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">any</button><button class=\"opt\" data-val=\"b\">some</button><button class=\"opt\" data-val=\"c\">a</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">There's ___ honey on the shelf.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">any</button><button class=\"opt\" data-val=\"b\">a</button><button class=\"opt\" data-val=\"c\">some</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">Would you like ___ drinks?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">a</button><button class=\"opt\" data-val=\"b\">the</button><button class=\"opt\" data-val=\"c\">any</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>a + one countable thing · some in positives · any in questions and negatives.</p></div>\n      <div class=\"task\" data-task data-tid=\"l21s5t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">❌ “I'd like a rice, please.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">I'd like a rices, please.</button><button class=\"opt\" data-val=\"b\">I'd like some rice, please.</button><button class=\"opt\" data-val=\"c\">I'd like an rices, please.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">❌ “We don't have some bread.”\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">We don't have a bread.</button><button class=\"opt\" data-val=\"b\">We don't has any bread.</button><button class=\"opt\" data-val=\"c\">We don't have any bread.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">❌ “There are some honey in the cupboard.”\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">There are any honey in the cupboard.</button><button class=\"opt\" data-val=\"b\">There are some honey in the cupboard.</button><button class=\"opt\" data-val=\"c\">There is some honey in the cupboard.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>rice is uncountable → <b>some rice</b> · negative → <b>any</b> · honey → there <b>is</b>.</p></div>\n      <div class=\"task\" data-task data-tid=\"l21s5t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">a ___ of lemonade\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">kilo</button><button class=\"opt\" data-val=\"b\">bottle</button><button class=\"opt\" data-val=\"c\">piece</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">a ___ of beef cubes — about 1,000 grams\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">piece</button><button class=\"opt\" data-val=\"b\">bottle</button><button class=\"opt\" data-val=\"c\">kilo</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">a ___ of noodles from the shop\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">packet</button><button class=\"opt\" data-val=\"b\">bottle</button><button class=\"opt\" data-val=\"c\">kilo</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">There ___ two bottles of water in the fridge.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">are</button><button class=\"opt\" data-val=\"b\">is</button><button class=\"opt\" data-val=\"c\">am</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>a bottle of lemonade · a kilo of beef · a packet of noodles · two bottles → there <b>are</b>.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Listen\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 7 &middot; Listen</div>\n      <h2>Listen</h2>\n    </div>\n\n      <div class=\"instruction\">Two friends at a food market — “I can't decide what I want!”</div>\n      <p class=\"subline\">Listen once. Then choose the correct answers.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_2',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.2 — at the food market</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">L: Wow! Look at all this different food! C: I know. I can't decide what I want. L: Well there's some pizza over there. C: No! We can have pizza any day. Let's try something different. L: OK, what about this place? C: Mmm… that looks delicious, but what is it? L: Excuse me, what is this? M: It's Kung Pao chicken. C: It smells so good! What does it come with? M: It comes with some noodles. C: I don't really like noodles. Is there any bread? M: No, we don't have any bread, sorry. But we have some rice. C: Great. So could I have a small Kung Pao chicken with some rice, please? L: And the same for me, but I'd like some noodles, please. M: OK, and would you like any drinks? L: Can I have a bottle of lemonade? M: We don't have any bottles of lemonade, I'm afraid. We have Coke or water. L: OK. Well, just a Coke, please. C: And for me, too.</div></details>\n      <div class=\"task\" data-task data-tid=\"l21s6t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">What is the dish they ask about?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Pizza</button><button class=\"opt\" data-val=\"b\">Rice salad</button><button class=\"opt\" data-val=\"c\">Kung Pao chicken</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">What does it come with?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Some noodles</button><button class=\"opt\" data-val=\"b\">Some bread</button><button class=\"opt\" data-val=\"c\">Some olives</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Is there any bread?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">No — but there's some rice.</button><button class=\"opt\" data-val=\"b\">Yes, fresh bread.</button><button class=\"opt\" data-val=\"c\">No — but there've some rice.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">Can they have a bottle of lemonade?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">No — only Coke or water.</button><button class=\"opt\" data-val=\"b\">Yes, of course.</button><button class=\"opt\" data-val=\"c\">Kung Pao chicken</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">What do they both drink in the end?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Water</button><button class=\"opt\" data-val=\"b\">Lemonade</button><button class=\"opt\" data-val=\"c\">Coke</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Kung Pao chicken with noodles · no bread, some rice · no lemonade → two Cokes.</p></div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_4',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.4 — at the butcher's</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">S: Hello. Can I help you? C: Do you have any beef? A: Yes, we have some nice steaks and some small beef cubes. B: Can I have some beef cubes? About a kilo, please. And I'd also like a small steak. Also, do you have any yoghurt? A: No, I'm afraid we don't. B: What about rice? A: Yes, we have some bags of rice. B: I'll have a bag of rice, please. Do you have any lemons? A: No, we don't sell any fruit or vegetables, I'm afraid.</div></details>\n      <div class=\"task\" data-task data-tid=\"l21s6t6\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">How much beef does she want?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">About a kilo of cubes</button><button class=\"opt\" data-val=\"b\">Two steaks</button><button class=\"opt\" data-val=\"c\">Half a kilo</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">What DOESN'T the butcher's sell?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Rice</button><button class=\"opt\" data-val=\"b\">Beef</button><button class=\"opt\" data-val=\"c\">Fruit and vegetables</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>A kilo of beef cubes + one small steak. No fruit or vegetables at the butcher's.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Write\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 8 &middot; Write</div>\n      <h2>Write</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Three people describe their kitchens. Listen — then write about yours.</div>\n      <p class=\"subline\" data-only=\"self\">5–6 sentences with some / any and there is / there are.</p>\n      <div class=\"player\" data-only=\"self\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_7',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.7 — three kitchens</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\" data-only=\"self\"><summary>Show transcript</summary><div class=\"gref-body\">B: What do I have in my kitchen? Not much really! I have a kettle because I make a lot of tea. And I have one frying pan and two saucepans. Oh! I forgot the most important thing — the microwave! — L: There's nothing special about my kitchen. But I have a beautiful old set of plates and bowls for when people come for dinner. I have a lot of dinner parties! — J: I love my kitchen. It's my favourite room in the house! I have a very modern oven and an expensive food-processor — I use it to make soup. My flatmates sometimes get angry because I spend hours in the kitchen!</div></details>\n      <div class=\"task\" data-task data-tid=\"l21s7SSt3\" data-only=\"self\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">The most important thing in B's kitchen is…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">the kettle</button><button class=\"opt\" data-val=\"b\">the kettles</button><button class=\"opt\" data-val=\"c\">the microwave</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">J's flatmates get angry because…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">J never cooks.</button><button class=\"opt\" data-val=\"b\">J spends hours in the kitchen.</button><button class=\"opt\" data-val=\"c\">the microwave</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\" data-only=\"self\"><div class=\"blab\">Why</div><p>B forgot the microwave! J cooks for hours — and the flatmates wait.</p></div>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"self\"><div class=\"blab\">Useful language</div><ul><li>In my kitchen there's…</li><li>There are some…</li><li>There isn't any…</li><li>We always have some…</li><li>We don't have a…</li><li>My favourite thing is…</li></ul></div>\n      <div class=\"instruction\" data-only=\"group\">The food market. One seller, one customer. Then swap.</div>\n      <p class=\"subline\" data-only=\"group\">The seller has some things — and doesn't have others.</p>\n      <div class=\"player\" data-only=\"group\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_7',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.7 — three kitchens (listen for ideas)</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\" data-only=\"group\"><summary>Show transcript</summary><div class=\"gref-body\">B: What do I have in my kitchen? Not much really! I have a kettle because I make a lot of tea. And I have one frying pan and two saucepans. Oh! I forgot the microwave! — L: I have a beautiful old set of plates and bowls for dinner parties. — J: I love my kitchen. I have a very modern oven and an expensive food-processor. My flatmates sometimes get angry because I spend hours in the kitchen!</div></details>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"group\"><div class=\"blab\">Useful language</div><ul><li>Do you have any…?</li><li>Could I have some…?</li><li>A kilo of… / a bottle of…</li><li>We have some…</li><li>I'm afraid we don't have any…</li><li>Anything else?</li></ul></div>\n      <div class=\"instruction\" data-only=\"solo\">The food market. One seller, one customer. Then swap roles.</div>\n      <p class=\"subline\" data-only=\"solo\">The seller has some things — and doesn't have others.</p>\n      <div class=\"player\" data-only=\"solo\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('9_7',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 9.7 — three kitchens (listen for ideas)</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\" data-only=\"solo\"><summary>Show transcript</summary><div class=\"gref-body\">B: What do I have in my kitchen? Not much really! I have a kettle because I make a lot of tea. And I have one frying pan and two saucepans. Oh! I forgot the microwave! — L: I have a beautiful old set of plates and bowls for dinner parties. — J: I love my kitchen. I have a very modern oven and an expensive food-processor. My flatmates sometimes get angry because I spend hours in the kitchen!</div></details>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"solo\"><div class=\"blab\">Useful language</div><ul><li>Do you have any…?</li><li>Could I have some…?</li><li>A kilo of… / a bottle of…</li><li>We have some…</li><li>I'm afraid we don't have any…</li><li>Anything else?</li></ul></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — the seller secretly chooses THREE things they don't have today (no bread? no lemons?).</div><div><b>Step 2</b> — the customer shops for a dinner for four: “Do you have any…? Could I have some… / a kilo of…?” The seller answers: “We have some… / I'm afraid we don't have any…”.</div><div><b>Step 3</b> — swap roles with a new secret list.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — the seller secretly chooses THREE things they don't have today (no bread? no lemons?).</div><div><b>Step 2</b> — the customer shops for a dinner for four: “Do you have any…? Could I have some… / a kilo of…?” The seller answers: “We have some… / I'm afraid we don't have any…”.</div><div><b>Step 3</b> — swap roles with a new secret list.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Type it\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 9 &middot; Type it</div>\n      <h2>Type it</h2>\n    </div>\n\n      <div class=\"instruction\">Now produce it — type, don’t tap.</div>\n      <p class=\"subline\">Spelling counts. Type the answers, then check.</p>\n      <div class=\"task\" data-task data-tid=\"l21s8t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">There is ___ milk in the fridge. (+)<br><input class=\"gap gap-lg\" data-answer=\"some\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">We don't have ___ eggs. (\\u2013)<br><input class=\"gap gap-lg\" data-answer=\"any\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">There ___ any bread. (\\u2013)<br><input class=\"gap gap-lg\" data-answer=\"isn't\" placeholder=\"Type the missing word…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>+ some \\u00b7 \\u2013 and ? any \\u00b7 milk/bread/rice are uncountable \\u2192 is.</p></div>\n      <div class=\"task\" data-task data-tid=\"l21s8t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">There is some apples.<br><input class=\"gap gap-lg\" data-answer=\"There are some apples.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">I don't have some milk.<br><input class=\"gap gap-lg\" data-answer=\"I don't have any milk.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Is there any eggs?<br><input class=\"gap gap-lg\" data-answer=\"Are there any eggs?\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>+ some \\u00b7 \\u2013 and ? any \\u00b7 milk/bread/rice are uncountable \\u2192 is.</p></div>\n      <div class=\"task\" data-task data-tid=\"l21s8t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Make it negative: There is some bread.<br><input class=\"gap gap-lg\" data-answer=\"There isn't any bread.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Make a question: We have some rice.<br><input class=\"gap gap-lg\" data-answer=\"Do we have any rice?\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Write it with some: coffee (+)<br><input class=\"gap gap-lg\" data-answer=\"There is some coffee.\" placeholder=\"Type the new sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>+ some \\u00b7 \\u2013 and ? any \\u00b7 milk/bread/rice are uncountable \\u2192 is.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Done\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 10 &middot; Done</div>\n      <h2>Done</h2>\n    </div>\n\n  </section>\n\n"}