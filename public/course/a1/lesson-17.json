{"unit":5,"no":17,"title":"What you could and couldn't do","blurb":"Unit 5","VOCAB":[["baker's","","булочная","наубайхана",""],["butcher's","","мясная лавка","ет дүкені",""],["newsagent's","","газетный киоск","газет дүңгіршегі",""],["shopping centre","","торговый центр","сауда орталығы",""],["shop assistant","","продавец","сатушы",""],["customer","","покупатель","тұтынушы",""],["online","","онлайн","онлайн",""],["vending machine","","торговый автомат","сауда автоматы",""],["spend","","тратить","жұмсау",""],["order","","заказывать","тапсырыс беру",""],["chat","","болтать","әңгімелесу",""],["possible","","возможно","мүмкін",""],["impossible","","невозможно","мүмкін емес",""],["ski","","кататься на лыжах","шаңғы тебу",""]],"SLIDES":[["📱","You can pay with your phone."]],"PICWORDS":["baker's","butcher's","newsagent's","shopping centre","shop assistant","customer","online","vending machine","spend","order","chat","possible","impossible","ski"],"DEFS":[],"CTX":{},"COLLOC":{},"IMG":{},"NOTES":{},"TIMING":{},"tracks":{"5_4":"A1_L17_5_4.mp3","5_5":"A1_L17_5_5.mp3","5_2":"A1_L17_5_2.mp3"},"SEGS":{"5_4":[3.62,null],"5_5":[3.41,null],"5_2":[3.47,null]},"html":"\n  <section class=\"stage on\" data-stage=\"Intro\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 1 &middot; Intro</div>\n      <h2>What you could and couldn't do</h2>\n      <p>Talk about ability and possibility — now and in the past.</p>\n    </div>\n\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"self\"><div class=\"blab\">In other words</div><div><b>How to study</b> — about 25 minutes, top to bottom.</div><div>Headphones on. This lesson has real audio — tap ▶ to listen.</div><div>After each <b>Check answers</b>, read the note — that is your teacher.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with a partner. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with your teacher. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Warm-up\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 2 &middot; Warm-up</div>\n      <h2>Warm-up</h2>\n    </div>\n\n      <div class=\"instruction\">Which of these can you do?</div>\n      <p class=\"subline\">Tap the ones you can do.</p>\n      <div class=\"grid3\" style=\"margin-top:16px\"><div class=\"card\"><b>🏊</b> &nbsp;swim</div><div class=\"card\"><b>🚗</b> &nbsp;drive</div><div class=\"card\"><b>🍳</b> &nbsp;cook a real dinner</div><div class=\"card\"><b>⛷️</b> &nbsp;ski</div><div class=\"card\"><b>💻</b> &nbsp;use Excel</div><div class=\"card\"><b>🗣️</b> &nbsp;speak three languages</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Words\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 3 &middot; Words</div>\n      <h2>Words</h2>\n    </div>\n\n      <div class=\"vbar\">\n        <div class=\"instruction\" style=\"margin:0\">Read the words. Click a card to see an example.</div>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"trToggle\"><span class=\"track\"></span><span>Show translation</span></label>\n      </div>\n      <div class=\"words\" id=\"words\"></div>\n\n      <div class=\"instruction\">These are your shopping words for this lesson.</div>\n      <p class=\"subline\">Tap 🔊 to listen. Turn on translations only if you need them.</p>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Recall\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 4 &middot; Recall</div>\n      <h2>Recall</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Where do you buy it? Choose.</div>\n      <div class=\"task\" data-task data-tid=\"l17s3SSt1\" data-only=\"self\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Fresh bread →\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">the newsagent's</button><button class=\"opt\" data-val=\"b\">the baker's</button><button class=\"opt\" data-val=\"c\">the newsagent've</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Meat →\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">the baker's</button><button class=\"opt\" data-val=\"b\">the butcher've</button><button class=\"opt\" data-val=\"c\">the butcher's</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">A newspaper →\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">the butcher's</button><button class=\"opt\" data-val=\"b\">the newsagent's</button><button class=\"opt\" data-val=\"c\">the newsagent've</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">An umbrella from a machine in Japan →\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">a vending machine</button><button class=\"opt\" data-val=\"b\">a shop assistant</button><button class=\"opt\" data-val=\"c\">an vending machine</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">The person who helps you in a shop is…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">a customer</button><button class=\"opt\" data-val=\"b\">an shop assistant</button><button class=\"opt\" data-val=\"c\">a shop assistant</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">The person who buys is…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">a baker</button><button class=\"opt\" data-val=\"b\">an customer</button><button class=\"opt\" data-val=\"c\">a customer</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\" data-only=\"self\"><div class=\"blab\">Why</div><p>baker's — bread · butcher's — meat · newsagent's — newspapers · vending machine · shop assistant helps, customer buys.</p></div>\n      <div class=\"instruction\" data-only=\"group\">Match each shop to what you buy there.</div>\n      <p class=\"subline\" data-only=\"group\">Tap a shop, then tap the thing.</p>\n      <p class=\"subline\" data-only=\"group\"><b>Shop</b> &rarr; <b>You buy…</b></p>\n      <div class=\"task\" data-task data-tid=\"l17s3GRt3\" data-only=\"group\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>the baker's</b> <select data-answer=\"fresh bread\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>the butcher's</b> <select data-answer=\"meat\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>the newsagent's</b> <select data-answer=\"a newspaper\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>a vending machine</b> <select data-answer=\"a quick drink\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>the shopping centre</b> <select data-answer=\"everything at once\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>online</b> <select data-answer=\"almost anything\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"instruction\" data-only=\"solo\">Match each shop to what you buy there.</div>\n      <p class=\"subline\" data-only=\"solo\">Tap a shop, then tap the thing.</p>\n      <p class=\"subline\" data-only=\"solo\"><b>Shop</b> &rarr; <b>You buy…</b></p>\n      <div class=\"task\" data-task data-tid=\"l17s3OOt5\" data-only=\"solo\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>the baker's</b> <select data-answer=\"fresh bread\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>the butcher's</b> <select data-answer=\"meat\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>the newsagent's</b> <select data-answer=\"a newspaper\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>a vending machine</b> <select data-answer=\"a quick drink\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>the shopping centre</b> <select data-answer=\"everything at once\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>online</b> <select data-answer=\"almost anything\"><option value=\"\">choose&hellip;</option><option value=\"fresh bread\">fresh bread</option><option value=\"meat\">meat</option><option value=\"a newspaper\">a newspaper</option><option value=\"a quick drink\">a quick drink</option><option value=\"everything at once\">everything at once</option><option value=\"almost anything\">almost anything</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Grammar\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 5 &middot; Grammar</div>\n      <h2>Grammar</h2>\n    </div>\n\n      <div class=\"instruction\">can and could — now and then.</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('5_4',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 5.4 — weak and strong can</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">Can you use euros in Norway and Sweden? — Yes, you can. — I think you can use them in Sweden but not in Norway.</div></details>\n      <div class=\"task\" data-task data-tid=\"l17s4t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">“Can you use euros…?” — can sounds…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">strong /kæn/</button><button class=\"opt\" data-val=\"b\">silent — not pronounced</button><button class=\"opt\" data-val=\"c\">weak /kən/</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">“Yes, you can.” — can sounds…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">weak /kən/</button><button class=\"opt\" data-val=\"b\">strong /kæn/</button><button class=\"opt\" data-val=\"c\">silent — not pronounced</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>In the middle of a sentence can is a little /kən/. At the end of a short answer it is a big /kæn/.</p></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>“Today you <b>can buy</b> almost everything online.”</div><div>“The internet <b>can't cut</b> your hair.”</div><div>“In the 1970s you <b>could talk</b> to the people in the shops.”</div><div>“You <b>couldn't go</b> shopping on the internet.”</div></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Notice:</span> which sentences are about <b>now</b> — and which about <b>the past</b>?</p></div>\n      <div style=\"margin-top:18px;overflow-x:auto\"><table class=\"gtable\"><tbody><tr><th>Time</th><th>Positive</th><th>Negative</th><th>Question</th></tr><tr><td>now</td><td class=\"pos\">You <b>can buy</b> everything online.</td><td>The internet <b>can't cut</b> your hair.</td><td><b>Can you ski?</b> — Yes, I can.</td></tr><tr><td>then</td><td class=\"pos\">You <b>could talk</b> to people in every shop.</td><td>You <b>couldn't shop</b> online in 1990.</td><td><b>Could people buy</b> things from machines? — Yes, they could.</td></tr></tbody></table></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div><b>can / can't</b> = ability and possibility now. <b>could / couldn't</b> = the same, in the past.</div><div>After can/could — base verb, same for all persons: she can swim, they could buy.</div><div>Questions: put can/could first — Can you drive? Could people pay online?</div><div>Short answers: Yes, I can. / No, they couldn't.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Practice\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 6 &middot; Practice</div>\n      <h2>Practice</h2>\n    </div>\n\n      <div class=\"instruction\">Part 1 — can, can't, could or couldn't?</div>\n      <div class=\"task\" data-task data-tid=\"l17s5t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">In 1990 you ___ shop online.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">can't</button><button class=\"opt\" data-val=\"b\">don't</button><button class=\"opt\" data-val=\"c\">couldn't</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Today you ___ pay with your phone.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">could</button><button class=\"opt\" data-val=\"b\">cans</button><button class=\"opt\" data-val=\"c\">can</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">My grandfather ___ ride a horse when he was ten.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">could</button><button class=\"opt\" data-val=\"b\">can</button><button class=\"opt\" data-val=\"c\">cans</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">I ___ ski — I always fall!\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">can't</button><button class=\"opt\" data-val=\"b\">couldn't</button><button class=\"opt\" data-val=\"c\">don't</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">___ people buy things from machines in 1890?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Could</button><button class=\"opt\" data-val=\"b\">Can</button><button class=\"opt\" data-val=\"c\">couldn't</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">Machines ___ give you a good chat.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">couldn't</button><button class=\"opt\" data-val=\"b\">don't</button><button class=\"opt\" data-val=\"c\">can't</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>now → can/can't · past (1990, when he was ten, in 1890) → could/couldn't.</p></div>\n      <div class=\"task\" data-task data-tid=\"l17s5t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">❌ “I can to swim very well.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">I can swim very well.</button><button class=\"opt\" data-val=\"b\">I can swimming very well.</button><button class=\"opt\" data-val=\"c\">I cans swimming very well.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">❌ “She cans drive.”\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">She can drives.</button><button class=\"opt\" data-val=\"b\">She cans drives.</button><button class=\"opt\" data-val=\"c\">She can drive.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">❌ “Do you can cook?”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Can you cook?</button><button class=\"opt\" data-val=\"b\">You can cook?</button><button class=\"opt\" data-val=\"c\">You cans cook?</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>can + base verb (no “to”) · can never takes -s · questions: <b>Can you…?</b></p></div>\n      <div class=\"task\" data-task data-tid=\"l17s5t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Supermarkets ___ to sell petrol in the 1970s. (start)\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">start</button><button class=\"opt\" data-val=\"b\">sold</button><button class=\"opt\" data-val=\"c\">started</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">The first vending machines ___ postcards. (sell → sold)\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">sold</button><button class=\"opt\" data-val=\"b\">selled</button><button class=\"opt\" data-val=\"c\">started</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Shopping ___ a long time in the 1970s. (take → took)\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">taked</button><button class=\"opt\" data-val=\"b\">took</button><button class=\"opt\" data-val=\"c\">started</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>started · sold · took — the Past Simple works next to could/couldn't.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Read\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 7 &middot; Read</div>\n      <h2>Read</h2>\n    </div>\n\n      <div class=\"instruction\">Shopping and travel — thirty years ago and today.</div>\n      <div class=\"task\" data-task data-tid=\"l17s6t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">The texts say…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">the past was better.</button><button class=\"opt\" data-val=\"b\">shops are cheaper today.</button><button class=\"opt\" data-val=\"c\">today is easier, but machines can't do everything.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>You can do almost everything online — but a machine can't cut your hair or chat.</p></div>\n      <div class=\"task\" data-task data-tid=\"l17s6t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Thirty years ago you could pay with your phone.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">You could book a holiday only at a travel agent's.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The maps in cars were made of paper.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">Today the internet can cut your hair.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">People in the shops had time for a chat.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Cash or cheque only · paper maps · and no, the internet still <b>can't</b> cut your hair.</p></div>\n      <div class=\"task\" data-task data-tid=\"l17s6t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">“You ___ compare prices at home.” (text 1)\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">couldn't</button><button class=\"opt\" data-val=\"b\">can't</button><button class=\"opt\" data-val=\"c\">don't</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">“You ___ order dinner in one minute.” (text 2)\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">could</button><button class=\"opt\" data-val=\"b\">can</button><button class=\"opt\" data-val=\"c\">cans</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Find the word that means “a friendly talk”.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">chat</button><button class=\"opt\" data-val=\"b\">order</button><button class=\"opt\" data-val=\"c\">advice</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>then → could<b>n't</b> · now → can · a friendly talk = a <b>chat</b>.</p></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Before you read:</span> what do you think was BETTER thirty years ago?</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Listen\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 8 &middot; Listen</div>\n      <h2>Listen</h2>\n    </div>\n\n      <div class=\"instruction\">Surprising facts about what you can and could buy.</div>\n      <p class=\"subline\">Listen once. Then choose the correct answers.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('5_5',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 5.5 — can/could shopping facts</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 People could buy things online in 1994. The first thing they could buy was pizza. 2 In the 1990s, rich people couldn't buy trips into space. But in 2001 Dennis Tito paid to visit the International Space Station. 3 Today you can buy eggs from vending machines in Japan. And you can also buy flowers, fruit and umbrellas. 4 You can buy a bottle of rainwater for $11 these days. 5 You can't use euros in Norway and Sweden. 6 People could buy things from machines in 1890. The first vending machines were in London in the 1880s and they sold postcards. 7 In the 1960s, you couldn't buy petrol at supermarkets. They started to sell petrol in the 1970s.</div></details>\n      <div class=\"task\" data-task data-tid=\"l17s7t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">What was the first thing people could buy online in 1994?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Pizza</button><button class=\"opt\" data-val=\"b\">Books</button><button class=\"opt\" data-val=\"c\">Music</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">When could a rich person first pay for a trip into space?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">1990</button><button class=\"opt\" data-val=\"b\">2010</button><button class=\"opt\" data-val=\"c\">2001</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">In Japan you can buy ___ from vending machines.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">only drinks</button><button class=\"opt\" data-val=\"b\">only tickets</button><button class=\"opt\" data-val=\"c\">eggs, flowers and umbrellas</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">Can you use euros in Norway and Sweden?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Yes, you can.</button><button class=\"opt\" data-val=\"b\">No, you can't.</button><button class=\"opt\" data-val=\"c\">Pizza</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">The first vending machines in London sold…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">eggs</button><button class=\"opt\" data-val=\"b\">postcards</button><button class=\"opt\" data-val=\"c\">petrol</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Pizza in 1994 · Dennis Tito, 2001 · eggs, flowers, umbrellas · no euros — Krone and Krona · postcards in the 1880s.</p></div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('5_2',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 5.2 — the town centre in the 1970s</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">Today the typical town centre is very different from in the 1970s. Then, you couldn't buy everything from one shop. People needed to go to different shops: the butcher's for meat, the baker's for bread and the newsagent's for their newspapers. Shopping took a long time! But there were good things. You could TALK to the people in the shops. Now it's easy to buy everything in the supermarket and in the shopping centre. But customers can't ask for information and chat to the shop assistant like they could in the past. In the 1970s you couldn't go shopping on the internet, but now you can buy almost everything online. The internet can't cut your hair, for example, and it can't give you a cup of coffee. In the 1970s you couldn't get a cup of coffee on the high street, but there are five cafés here now — and three hairdresser's!</div></details>\n      <div class=\"task\" data-task data-tid=\"l17s7t6\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">In the 1970s you could buy everything from one shop.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">In the 1970s you could get a coffee on the high street.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Different shops for everything — and no cafés then. Now: five cafés and three hairdresser's!</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Write\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 9 &middot; Write</div>\n      <h2>Write</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Write about your grandparents at your age — and you today.</div>\n      <p class=\"subline\" data-only=\"self\">5–6 sentences with could / couldn't and can / can't.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"self\"><div class=\"blab\">Useful language</div><ul><li>At my age, my grandmother could…</li><li>She couldn't…</li><li>Today I can…</li><li>I can't…, but I can…</li><li>It was impossible to…</li><li>Now it's easy to…</li></ul></div>\n      <div class=\"instruction\" data-only=\"group\">Now and when you were seven.</div>\n      <p class=\"subline\" data-only=\"group\">Interview your partner. Then report to another pair.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"group\"><div class=\"blab\">Useful language</div><ul><li>Can you…?</li><li>Could you… when you were seven?</li><li>Yes, I can. / No, I can't.</li><li>I could… but I couldn't…</li><li>She can…</li><li>He couldn't…</li></ul></div>\n      <div class=\"instruction\" data-only=\"solo\">Now and when you were seven.</div>\n      <p class=\"subline\" data-only=\"solo\">Interview your teacher. Then report to your teacher.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"solo\"><div class=\"blab\">Useful language</div><ul><li>Can you…?</li><li>Could you… when you were seven?</li><li>Yes, I can. / No, I can't.</li><li>I could… but I couldn't…</li><li>She can…</li><li>He couldn't…</li></ul></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — ask five questions: “Can you ski / cook / drive / swim / speak three languages?”</div><div><b>Step 2</b> — now the past: “Could you swim when you were seven? Could you cook?”</div><div><b>Step 3</b> — report to another pair with he/she: “She can drive, but she couldn't ride a bike at seven!”</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — ask five questions: “Can you ski / cook / drive / swim / speak three languages?”</div><div><b>Step 2</b> — now the past: “Could you swim when you were seven? Could you cook?”</div><div><b>Step 3</b> — report to your teacher with he/she: “She can drive, but she couldn't ride a bike at seven!”</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Type it\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 10 &middot; Type it</div>\n      <h2>Type it</h2>\n    </div>\n\n      <div class=\"instruction\">Now produce it — type, don’t tap.</div>\n      <p class=\"subline\">Spelling counts. Type the answers, then check.</p>\n      <div class=\"task\" data-task data-tid=\"l17s9t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">She ___ drive \\u2014 she has a licence.<br><input class=\"gap gap-lg\" data-answer=\"can\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">I ___ ski when I was five. (negative past)<br><input class=\"gap gap-lg\" data-answer=\"couldn't\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">He ___ read at the age of four. (past)<br><input class=\"gap gap-lg\" data-answer=\"could\" placeholder=\"Type the missing word…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>can/could + base verb \\u2014 no -s, no to \\u00b7 past: could/couldn't.</p></div>\n      <div class=\"task\" data-task data-tid=\"l17s9t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">She cans drive.<br><input class=\"gap gap-lg\" data-answer=\"She can drive.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">I can to swim.<br><input class=\"gap gap-lg\" data-answer=\"I can swim.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">He could ride a horse when he were ten.<br><input class=\"gap gap-lg\" data-answer=\"He could ride a horse when he was ten.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>can/could + base verb \\u2014 no -s, no to \\u00b7 past: could/couldn't.</p></div>\n      <div class=\"task\" data-task data-tid=\"l17s9t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Change to the past: I can't ski. (when I was five)<br><input class=\"gap gap-lg\" data-answer=\"I couldn't ski when I was five.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Make a question: You can cook.<br><input class=\"gap gap-lg\" data-answer=\"Can you cook?\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Make it negative: She could read at four.<br><input class=\"gap gap-lg\" data-answer=\"She couldn't read at four.\" placeholder=\"Type the new sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>can/could + base verb \\u2014 no -s, no to \\u00b7 past: could/couldn't.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Done\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 11 &middot; Done</div>\n      <h2>Done</h2>\n    </div>\n\n  </section>\n\n"}