{"unit":7,"no":25,"title":"A changing climate","blurb":"Unit 7","VOCAB":[["snow → snowy","","снег → снежный","қар → қарлы",""],["rain → rainy","","дождь → дождливый","жаңбыр → жаңбырлы",""],["sun → sunny","","солнце → солнечный","күн → күнді",""],["wind → windy","","ветер → ветреный","жел → желді",""],["ice → icy","","лёд → ледяной","мұз → мұзды",""],["fog → foggy","","туман → туманный","тұман → тұманды",""],["freezing","","ледяной (мороз)","аяз",""],["boiling","","очень жарко","ыстық (қайнаған)",""],["dry","","сухой","құрғақ",""],["wet","","мокрый","дымқыл",""],["temperature","","температура","температура",""],["forecast","","прогноз","болжам",""],["climate","","климат","климат",""],["pollution","","загрязнение","ластану",""]],"SLIDES":[["🔥","Summers are hotter than before."]],"PICWORDS":["snow → snowy","rain → rainy","sun → sunny","wind → windy","ice → icy","fog → foggy","freezing","boiling","dry","wet","temperature","forecast","climate","pollution"],"DEFS":[],"CTX":{},"COLLOC":{},"IMG":{},"NOTES":{},"TIMING":{},"tracks":{"10_2":"A1_L25_10_2.mp3","10_1":"A1_L25_10_1.mp3","10_4":"A1_L25_10_4.mp3","10_6":"A1_L25_10_6.mp3","10_16":"A1_L25_10_16.mp3"},"SEGS":{"10_2":[3.55,null],"10_1":[3.45,null],"10_4":[3.48,null],"10_6":[3.56,null],"10_16":[3.57,null]},"html":"\n  <section class=\"stage on\" data-stage=\"Intro\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 1 &middot; Intro</div>\n      <h2>A changing climate</h2>\n      <p>Compare two places, two times or two things — and describe the weather.</p>\n    </div>\n\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"self\"><div class=\"blab\">In other words</div><div><b>How to study</b> — about 25 minutes, top to bottom.</div><div>Headphones on. This lesson has real audio — tap ▶ to listen.</div><div>After each <b>Check answers</b>, read the note — that is your teacher.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with a partner. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with your teacher. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Warm-up\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 2 &middot; Warm-up</div>\n      <h2>Warm-up</h2>\n    </div>\n\n      <div class=\"instruction\">Today's weather, right now — what is true?</div>\n      <p class=\"subline\">Tap everything that is true outside your window.</p>\n      <div class=\"grid3\" style=\"margin-top:16px\"><div class=\"card\"><b>☀️</b> &nbsp;it's sunny</div><div class=\"card\"><b>🌧️</b> &nbsp;it's rainy</div><div class=\"card\"><b>💨</b> &nbsp;it's windy</div><div class=\"card\"><b>❄️</b> &nbsp;it's snowy</div><div class=\"card\"><b>🌫️</b> &nbsp;it's foggy</div><div class=\"card\"><b>🥶</b> &nbsp;it's freezing</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Words\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 3 &middot; Words</div>\n      <h2>Words</h2>\n    </div>\n\n      <div class=\"vbar\">\n        <div class=\"instruction\" style=\"margin:0\">Read the words. Click a card to see an example.</div>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"trToggle\"><span class=\"track\"></span><span>Show translation</span></label>\n      </div>\n      <div class=\"words\" id=\"words\"></div>\n\n      <div class=\"instruction\">Weather word families: snow → to snow → snowy.</div>\n      <p class=\"subline\">Tap 🔊 to listen. Turn on translations only if you need them.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('10_2',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 10.2 — weather word families</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">snow, to snow, snowy · rain, to rain, rainy · sun, to shine, sunny · wind, to blow, windy · ice, to freeze, icy/freezing · fog, foggy</div></details>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Recall\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 4 &middot; Recall</div>\n      <h2>Recall</h2>\n    </div>\n\n      <div class=\"instruction\">Three weather reports. Listen and choose.</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('10_1',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 10.1 — three cities, three skies</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 In Lisbon today it's cloudy this morning but dry, and we don't expect any rain. By the afternoon it's going to be warm and sunny, but not really hot — around 20 degrees Celsius. 2 We loved Malaysia. We went in the wet season, so we had some storms — really windy, with very loud thunder and lightning. But most of the time it was lovely. 3 In Chicago it's freezing today. There was a lot of snow last night and the roads are very icy. It's cold and foggy now, and there is more snow to come.</div></details>\n      <div class=\"task\" data-task data-tid=\"l25s3t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Lisbon this morning is…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">rainy</button><button class=\"opt\" data-val=\"b\">cloudy but dry</button><button class=\"opt\" data-val=\"c\">snowy</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">In Malaysia they had storms because…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">it was winter</button><button class=\"opt\" data-val=\"b\">it was the wet season</button><button class=\"opt\" data-val=\"c\">it were the wet season</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">In Chicago the roads are…\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">very icy</button><button class=\"opt\" data-val=\"b\">dry and warm</button><button class=\"opt\" data-val=\"c\">cloudy but dry</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Lisbon — cloudy but dry, ~20°C · Malaysia — wet season storms · Chicago — freezing, icy, foggy.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Grammar\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 5 &middot; Grammar</div>\n      <h2>Grammar</h2>\n    </div>\n\n      <div class=\"instruction\">hotter, drier, better — comparing things.</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('10_4',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 10.4 — two fast questions</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 Is Dublin drier than Paris? 2 Is Sydney bigger than Cairo?</div></details>\n      <div class=\"task\" data-task data-tid=\"l25s4t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Question 1 was…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Is Dublin dirtier than Paris?</button><button class=\"opt\" data-val=\"b\">Is Dublin driers than Paris?</button><button class=\"opt\" data-val=\"c\">Is Dublin drier than Paris?</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Question 2 was…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Is Sydney better than Cairo?</button><button class=\"opt\" data-val=\"b\">Is Sydney biggers than Cairo?</button><button class=\"opt\" data-val=\"c\">Is Sydney bigger than Cairo?</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>than almost disappears — /ðən/ — but the meaning stays.</p></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>“Bangkok is <b>hotter than</b> Cairo.”</div><div>“Dublin is <b>wetter than</b> Paris.”</div><div>“Tokyo is <b>more expensive than</b> Singapore.”</div><div>“My new job is <b>better than</b> my old one.”</div></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Notice:</span> short adjectives take <b>-er</b>. What do LONG adjectives take?</p></div>\n      <div style=\"margin-top:18px;overflow-x:auto\"><table class=\"gtable\"><tbody><tr><th>Adjective type</th><th>Rule</th><th>Example</th></tr><tr><td>short</td><td class=\"pos\">+ er</td><td>cold → cold<b>er</b> · warm → warm<b>er</b></td></tr><tr><td>one vowel + one consonant</td><td class=\"pos\">double + er</td><td>hot → ho<b>tter</b> · wet → we<b>tter</b> · big → bi<b>gger</b></td></tr><tr><td>-y</td><td class=\"pos\">y → ier</td><td>dry → dr<b>ier</b> · foggy → fogg<b>ier</b> · snowy → snow<b>ier</b></td></tr><tr><td>long adjectives</td><td class=\"pos\">more + adjective</td><td><b>more</b> expensive · <b>more</b> famous</td></tr><tr><td>irregular</td><td class=\"pos\">new word</td><td>good → <b>better</b> · bad → <b>worse</b> · far → <b>further</b></td></tr><tr><td colspan=\"3\">+ <b>than</b>: Bangkok is hotter <b>than</b> Cairo. The same? → <b>as … as</b>: Today is as cold as yesterday.</td></tr></tbody></table></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>Short → <b>-er</b> (colder). Spelling: hot → ho<b>tt</b>er, dry → dr<b>ier</b>.</div><div>Long → <b>more</b> + adjective (more expensive). Never both: “more hotter” ✗.</div><div>Irregular: good → <b>better</b>, bad → <b>worse</b>, far → <b>further</b>.</div><div>Compare with <b>than</b>: hotter than Cairo. The same? <b>as … as</b>.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Practice\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 6 &middot; Practice</div>\n      <h2>Practice</h2>\n    </div>\n\n      <div class=\"instruction\">Part 1 — Make the comparative.</div>\n      <div class=\"task\" data-task data-tid=\"l25s5t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">hot →\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">more hot</button><button class=\"opt\" data-val=\"b\">more hotter</button><button class=\"opt\" data-val=\"c\">hotter</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">dry →\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">drier</button><button class=\"opt\" data-val=\"b\">dryier</button><button class=\"opt\" data-val=\"c\">hotter</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">expensive →\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">expensiver</button><button class=\"opt\" data-val=\"b\">more expensiver</button><button class=\"opt\" data-val=\"c\">more expensive</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">good →\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">gooder</button><button class=\"opt\" data-val=\"b\">hotter</button><button class=\"opt\" data-val=\"c\">better</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">bad →\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">badder</button><button class=\"opt\" data-val=\"b\">hotter</button><button class=\"opt\" data-val=\"c\">worse</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">big →\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">biger</button><button class=\"opt\" data-val=\"b\">bigger</button><button class=\"opt\" data-val=\"c\">hotter</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>ho<b>tt</b>er · dr<b>ier</b> · <b>more</b> expensive · <b>better</b> · <b>worse</b> · bi<b>gg</b>er.</p></div>\n      <div class=\"task\" data-task data-tid=\"l25s5t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">❌ “Summer is more hotter than spring.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Summer is more hot than spring.</button><button class=\"opt\" data-val=\"b\">Summer is hotter than spring.</button><button class=\"opt\" data-val=\"c\">Summer are more hot than spring.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">❌ “Winter is colder then summer.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Winter is colder that summer.</button><button class=\"opt\" data-val=\"b\">Winter is colder than summer.</button><button class=\"opt\" data-val=\"c\">Winter are colder than summer.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">❌ “The pollution is badder in big cities.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">The pollution is worse in big cities.</button><button class=\"opt\" data-val=\"b\">The pollution is more bad in big cities.</button><button class=\"opt\" data-val=\"c\">The pollution are more bad in big cities.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>never “more + -er” · compare with <b>than</b> · bad → <b>worse</b>.</p></div>\n      <div class=\"task\" data-task data-tid=\"l25s5t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">The winters ___ longer in the 1990s.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">are</button><button class=\"opt\" data-val=\"b\">is</button><button class=\"opt\" data-val=\"c\">were</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Now the summers ___ hotter and drier.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">were</button><button class=\"opt\" data-val=\"b\">is</button><button class=\"opt\" data-val=\"c\">are</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The snow ___ in November in those years. (come → came)\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">comes</button><button class=\"opt\" data-val=\"b\">were</button><button class=\"opt\" data-val=\"c\">came</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>the 1990s → were / came · now → are.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Read\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 7 &middot; Read</div>\n      <h2>Read</h2>\n    </div>\n\n      <div class=\"instruction\">The weather here — thirty years ago and today.</div>\n      <p class=\"subline\">Read the two texts. Then listen to the short story of the same idea.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"sayText(this)\" data-say=\"Thirty years ago, the weather here was different. The winters were colder and longer than now. The snow came early and stayed for months. Today the summers are hotter and drier, and the storms are stronger. The climate is changing faster than we think.\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>The same story, out loud</b>Read aloud by your device</div>\n      </div>\n      <div class=\"task\" data-task data-tid=\"l25s6t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">The texts say…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">the weather never changes.</button><button class=\"opt\" data-val=\"b\">winters are warmer and summers hotter than 30 years ago.</button><button class=\"opt\" data-val=\"c\">the 1990s were warmer.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Warmer winters, hotter and drier summers, stronger storms.</p></div>\n      <div class=\"task\" data-task data-tid=\"l25s6t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">In the 1990s the snow came in November.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Minus thirty was unusual then.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Today the snow often leaves in February.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">True</button><button class=\"opt\" data-val=\"b\">False</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">The storms are weaker now.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">False</button><button class=\"opt\" data-val=\"b\">True</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Minus thirty was <b>normal</b> · the storms are <b>stronger</b> now.</p></div>\n      <div class=\"task\" data-task data-tid=\"l25s6t4\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">“The ice was ___ than a wall.”\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">more thick</button><button class=\"opt\" data-val=\"b\">more thicker</button><button class=\"opt\" data-val=\"c\">thicker</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">“The climate is changing ___ than the old people can believe.”\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">more fast</button><button class=\"opt\" data-val=\"b\">more faster</button><button class=\"opt\" data-val=\"c\">faster</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Find the word that means “dirty air in cities”.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">pollution</button><button class=\"opt\" data-val=\"b\">forecast</button><button class=\"opt\" data-val=\"c\">climate</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>thick<b>er</b> · fast<b>er</b> · <b>pollution</b>.</p></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Before you read:</span> ask someone older — were the winters really colder before?</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Listen\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 8 &middot; Listen</div>\n      <h2>Listen</h2>\n    </div>\n\n      <div class=\"instruction\">Which is bigger, faster, colder? Listen and learn.</div>\n      <p class=\"subline\">Listen once. Then choose the correct answers.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('10_6',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 10.6 — five comparative questions</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 Are Indian elephants heavier than African elephants? — No. African elephants are heavier. 2 Is Tokyo more expensive than Singapore? — Yes, it is. 3 Are giraffes faster than humans? — Yes — 35 miles an hour. 4 Is Canada bigger or smaller than the USA? — Canada is slightly bigger. 5 Is the North Pole colder than the South Pole? — No, it's warmer. The South Pole is colder.</div></details>\n      <div class=\"task\" data-task data-tid=\"l25s7t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Which elephants are heavier?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Indian</button><button class=\"opt\" data-val=\"b\">Atlantic</button><button class=\"opt\" data-val=\"c\">African</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Is Tokyo more expensive than Singapore?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">No, it isn't.</button><button class=\"opt\" data-val=\"b\">Yes, it is.</button><button class=\"opt\" data-val=\"c\">African</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Canada is ___ than the USA.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">much smaller</button><button class=\"opt\" data-val=\"b\">exactly the same</button><button class=\"opt\" data-val=\"c\">slightly bigger</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">Which Pole is colder?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">The North Pole</button><button class=\"opt\" data-val=\"b\">The South Pole</button><button class=\"opt\" data-val=\"c\">The Souths Pole</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>African elephants · Tokyo yes · Canada slightly bigger · the South Pole is colder.</p></div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('10_16',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 10.16 — the comparison quiz</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 Bangkok is hotter than Cairo. 2 Canberra is foggier than London. 3 The pollution is worse in New Delhi than in Beijing. 4 Damascus is older than Rome. 5 Ottawa is snowier than Moscow. 6 Tokyo has a bigger population than Mexico City.</div></details>\n      <div class=\"task\" data-task data-tid=\"l25s7t6\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">“Bangkok is ___ than Cairo.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">hotter</button><button class=\"opt\" data-val=\"b\">colder</button><button class=\"opt\" data-val=\"c\">older</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">“Damascus is ___ than Rome.”\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">newer</button><button class=\"opt\" data-val=\"b\">hotter</button><button class=\"opt\" data-val=\"c\">older</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>hotter · older — and yes, Ottawa really is snowier than Moscow.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Write\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 9 &middot; Write</div>\n      <h2>Write</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Write about the weather in YOUR city — thirty years ago and today.</div>\n      <p class=\"subline\" data-only=\"self\">5–6 sentences with comparatives.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"self\"><div class=\"blab\">Useful language</div><ul><li>The winters were … than now</li><li>Today the summers are hotter / drier</li><li>… is changing faster than…</li><li>better · worse</li><li>as … as</li><li>The forecast says…</li></ul></div>\n      <div class=\"instruction\" data-only=\"group\">Two cities, one winner.</div>\n      <p class=\"subline\" data-only=\"group\">Compare two cities you both know. Then present your verdict.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"group\"><div class=\"blab\">Useful language</div><ul><li>… is bigger / hotter than…</li><li>… is more beautiful than…</li><li>… is as … as …</li><li>better · worse</li><li>I agree / I don't agree</li><li>The winner is…!</li></ul></div>\n      <div class=\"instruction\" data-only=\"solo\">Two cities, one winner.</div>\n      <p class=\"subline\" data-only=\"solo\">Compare two cities you both know. Then present your verdict.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"solo\"><div class=\"blab\">Useful language</div><ul><li>… is bigger / hotter than…</li><li>… is more beautiful than…</li><li>… is as … as …</li><li>better · worse</li><li>I agree / I don't agree</li><li>The winner is…!</li></ul></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>📱 <b>Option 1:</b> open the weather app on your phone — use the REAL forecast for your two cities. 🗺️ <b>Option 2:</b> use the weather board below and compare: <b>Dubai is hotter than London today.</b></div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — choose two cities you both know (your city + one more).</div><div><b>Step 2</b> — compare them in five ways: bigger? hotter? more beautiful? cheaper? better for food? Agree on each point.</div><div><b>Step 3</b> — present your verdict to another pair: “X is better than Y because… but Y is greener.”</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — choose two cities you both know (your city + one more).</div><div><b>Step 2</b> — compare them in five ways: bigger? hotter? more beautiful? cheaper? better for food? Agree on each point.</div><div><b>Step 3</b> — present your verdict to your teacher: “X is better than Y because… but Y is greener.”</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Type it\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 10 &middot; Type it</div>\n      <h2>Type it</h2>\n    </div>\n\n      <div class=\"instruction\">Now produce it — type, don’t tap.</div>\n      <p class=\"subline\">Spelling counts. Type the answers, then check.</p>\n      <div class=\"task\" data-task data-tid=\"l25s9t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Bangkok is ___ than Cairo. (hot)<br><input class=\"gap gap-lg\" data-answer=\"hotter\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Dublin is wetter ___ Paris.<br><input class=\"gap gap-lg\" data-answer=\"than\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">My new job is ___ than my old one. (good)<br><input class=\"gap gap-lg\" data-answer=\"better\" placeholder=\"Type the missing word…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Short + -er (hotter) \\u00b7 long \\u2192 more + adjective \\u00b7 good \\u2192 better \\u00b7 + than.</p></div>\n      <div class=\"task\" data-task data-tid=\"l25s9t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Rio is more hot than London.<br><input class=\"gap gap-lg\" data-answer=\"Rio is hotter than London.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">This is more better.<br><input class=\"gap gap-lg\" data-answer=\"This is better.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Dublin is wetter that Paris.<br><input class=\"gap gap-lg\" data-answer=\"Dublin is wetter than Paris.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Short + -er (hotter) \\u00b7 long \\u2192 more + adjective \\u00b7 good \\u2192 better \\u00b7 + than.</p></div>\n      <div class=\"task\" data-task data-tid=\"l25s9t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Compare with HOT: Bangkok / Cairo<br><input class=\"gap gap-lg\" data-answer=\"Bangkok is hotter than Cairo.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Compare with EXPENSIVE: Tokyo / Singapore<br><input class=\"gap gap-lg\" data-answer=\"Tokyo is more expensive than Singapore.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Compare with GOOD: this caf\\u00e9 / that caf\\u00e9<br><input class=\"gap gap-lg\" data-answer=\"This caf\\u00e9 is better than that caf\\u00e9.\" placeholder=\"Type the new sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Short + -er (hotter) \\u00b7 long \\u2192 more + adjective \\u00b7 good \\u2192 better \\u00b7 + than.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Done\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 11 &middot; Done</div>\n      <h2>Done</h2>\n    </div>\n\n  </section>\n\n"}