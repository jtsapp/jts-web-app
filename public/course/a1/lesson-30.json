{"unit":8,"no":30,"title":"A day of helping","blurb":"Unit 8","VOCAB":[["organize a party","","организовать праздник","кеш ұйымдастыру",""],["give a present","","подарить подарок","сыйлық беру",""],["repair","","починить","жөндеу",""],["visit someone in hospital","","навестить в больнице","ауруханада көру",""],["make a cake","","испечь торт","торт пісіру",""],["help with homework","","помочь с уроками","сабаққа көмектесу",""],["collect money","","собирать деньги","ақша жинау",""],["volunteer","","волонтёрить","волонтёр болу",""],["plant flowers","","посадить цветы","гүл егу",""],["look after","","присматривать","қарау (күтім)",""],["homeless","","бездомный","баспанасыз",""],["local","","местный","жергілікті",""],["rubbish","","мусор","қоқыс",""]],"SLIDES":[],"PICWORDS":["organize a party","give a present","repair","visit someone in hospital","make a cake","help with homework","collect money","volunteer","plant flowers","look after","homeless","local","rubbish"],"DEFS":[],"CTX":{},"COLLOC":{},"IMG":{},"NOTES":{},"TIMING":{},"tracks":{"11_1":"A1_L30_11_1.mp3","11_14":"A1_L30_11_14.mp3","11_12":"A1_L30_11_12.mp3","11_3":"A1_L30_11_3.mp3","11_11":"A1_L30_11_11.mp3"},"SEGS":{"11_1":[3.47,null],"11_14":[3.63,null],"11_12":[3.67,null],"11_3":[3.64,null],"11_11":[3.54,null]},"html":"\n  <section class=\"stage on\" data-stage=\"Intro\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 1 &middot; Intro</div>\n      <h2>A day of helping</h2>\n      <p>Explain why you are doing something — and offer to help.</p>\n    </div>\n\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"self\"><div class=\"blab\">In other words</div><div><b>How to study</b> — about 25 minutes, top to bottom.</div><div>Headphones on. This lesson has real audio — tap ▶ to listen.</div><div>After each <b>Check answers</b>, read the note — that is your teacher.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with a partner. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with your teacher. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Warm-up\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 2 &middot; Warm-up</div>\n      <h2>Warm-up</h2>\n    </div>\n\n      <div class=\"instruction\">Mandela Day: 67 minutes for other people. What would you do?</div>\n      <p class=\"subline\">Tap the ones you'd enjoy.</p>\n      <div class=\"grid3\" style=\"margin-top:16px\"><div class=\"card\"><b>🍲</b> &nbsp;make soup for someone</div><div class=\"card\"><b>🌸</b> &nbsp;plant some flowers</div><div class=\"card\"><b>🚲</b> &nbsp;repair a friend's bike</div><div class=\"card\"><b>🏥</b> &nbsp;visit someone in hospital</div><div class=\"card\"><b>📚</b> &nbsp;help with homework</div><div class=\"card\"><b>🗑️</b> &nbsp;clean the local park</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Words\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 3 &middot; Words</div>\n      <h2>Words</h2>\n    </div>\n\n      <div class=\"vbar\">\n        <div class=\"instruction\" style=\"margin:0\">Read the words. Click a card to see an example.</div>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"trToggle\"><span class=\"track\"></span><span>Show translation</span></label>\n      </div>\n      <div class=\"words\" id=\"words\"></div>\n\n      <div class=\"instruction\">These are your helping words for this lesson.</div>\n      <p class=\"subline\">Tap 🔊 to listen. Turn on translations only if you need them.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('11_1',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 11.1 — the helping word bank</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 organize a party. 2 give a present to someone. 3 repair your friend's bike. 4 visit someone in hospital. 5 make a cake for a colleague's birthday. 6 help a classmate with their homework. 7 plant some flowers. 8 look after a friend's children for the evening. 9 teach someone to drive. 10 improve your local area by picking up rubbish.</div></details>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Recall\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 4 &middot; Recall</div>\n      <h2>Recall</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Choose the correct word.</div>\n      <div class=\"task\" data-task data-tid=\"l30s3SSt1\" data-only=\"self\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">His bike is broken — I'm going to ___ it.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">plant</button><button class=\"opt\" data-val=\"b\">repair</button><button class=\"opt\" data-val=\"c\">visit</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">She's ill, so we're going to ___ her in hospital.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">collect</button><button class=\"opt\" data-val=\"b\">repair</button><button class=\"opt\" data-val=\"c\">visit</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">We're going to ___ money for the local hospital.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">organize</button><button class=\"opt\" data-val=\"b\">repair</button><button class=\"opt\" data-val=\"c\">collect</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">I'm going to ___ my neighbour's children this evening.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">give</button><button class=\"opt\" data-val=\"b\">take</button><button class=\"opt\" data-val=\"c\">look after</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">The park is full of ___ — let's clean it.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">flowers</button><button class=\"opt\" data-val=\"b\">repair</button><button class=\"opt\" data-val=\"c\">rubbish</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">People with no home are ___.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">local</button><button class=\"opt\" data-val=\"b\">homeless</button><button class=\"opt\" data-val=\"c\">repair</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\" data-only=\"self\"><div class=\"blab\">Why</div><p>repair · visit · collect money · look after · rubbish · homeless.</p></div>\n      <div class=\"instruction\" data-only=\"group\">Match the action to the person who needs it.</div>\n      <p class=\"subline\" data-only=\"group\">Tap an action, then tap the person.</p>\n      <p class=\"subline\" data-only=\"group\"><b>Action</b> &rarr; <b>Who needs it</b></p>\n      <div class=\"task\" data-task data-tid=\"l30s3GRt3\" data-only=\"group\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>repair the bike</b> <select data-answer=\"a friend with a broken bike\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>visit in hospital</b> <select data-answer=\"someone who is ill\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>help with homework</b> <select data-answer=\"a classmate\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>look after the children</b> <select data-answer=\"busy parents\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>collect money</b> <select data-answer=\"the local hospital\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>pick up rubbish</b> <select data-answer=\"the local park\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"instruction\" data-only=\"solo\">Match the action to the person who needs it.</div>\n      <p class=\"subline\" data-only=\"solo\">Tap an action, then tap the person.</p>\n      <p class=\"subline\" data-only=\"solo\"><b>Action</b> &rarr; <b>Who needs it</b></p>\n      <div class=\"task\" data-task data-tid=\"l30s3OOt5\" data-only=\"solo\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>repair the bike</b> <select data-answer=\"a friend with a broken bike\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>visit in hospital</b> <select data-answer=\"someone who is ill\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>help with homework</b> <select data-answer=\"a classmate\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>look after the children</b> <select data-answer=\"busy parents\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>collect money</b> <select data-answer=\"the local hospital\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>pick up rubbish</b> <select data-answer=\"the local park\"><option value=\"\">choose&hellip;</option><option value=\"a friend with a broken bike\">a friend with a broken bike</option><option value=\"someone who is ill\">someone who is ill</option><option value=\"a classmate\">a classmate</option><option value=\"busy parents\">busy parents</option><option value=\"the local hospital\">the local hospital</option><option value=\"the local park\">the local park</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Grammar\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 5 &middot; Grammar</div>\n      <h2>Grammar</h2>\n    </div>\n\n      <div class=\"instruction\">Why? — to help. Who? — I'll do it!</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('11_14',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 11.14 — eight purpose sentences</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 He got up early to paint the living room. 2 She's going to move to Greece to teach English. 3 I go to Bob's house every weekend to look after his dog. 4 I went to my parents' house to repair my Mum's car. 5 I'm going to call all our friends to organize a birthday party. 6 We're going to buy some eggs and sugar to make a cake. 7 I'm going to take the afternoon off work to visit my aunt in hospital. 8 I went to the garden to plant some flowers.</div></details>\n      <div class=\"task\" data-task data-tid=\"l30s4t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">He got up early ___ the living room.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">for paint</button><button class=\"opt\" data-val=\"b\">to paint</button><button class=\"opt\" data-val=\"c\">for to paint</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">She's going to move to Greece ___ English.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">for teaching</button><button class=\"opt\" data-val=\"b\">for to teach</button><button class=\"opt\" data-val=\"c\">to teach</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">We're going to buy eggs and sugar ___ a cake.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">for make</button><button class=\"opt\" data-val=\"b\">for to make</button><button class=\"opt\" data-val=\"c\">to make</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>WHY? → <b>to + verb</b>: to paint · to teach · to make.</p></div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('11_12',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 11.12 — the offer bank</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 Shall I write that down? 2 Why don't I give him the list then? 3 I'll take notes so we don't forget. 4 Let me help you with that. 5 Would you like me to ask them?</div></details>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>“We're going to buy some eggs <b>to make</b> a cake.”</div><div>“<b>I'll take</b> notes so we don't forget.”</div><div>“<b>Shall I</b> write that down?”</div><div>“<b>Would you like me to</b> ask them?” · “<b>Let me</b> help you with that.”</div></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Notice:</span> which little word answers the question “WHY?” in the first sentence?</p></div>\n      <div style=\"margin-top:18px;overflow-x:auto\"><table class=\"gtable\"><tbody><tr><th>What</th><th>Say</th><th>Example</th></tr><tr><td>say WHY (purpose)</td><td class=\"pos\">to + base verb</td><td>I do it <b>to keep fit</b>. · We're going to buy eggs <b>to make a cake</b>.</td></tr><tr><td>offer, fast</td><td class=\"pos\">I'll…</td><td><b>I'll take</b> notes so we don't forget.</td></tr><tr><td>offer, as a question</td><td class=\"pos\">Shall I…? / Why don't I…?</td><td><b>Shall I write</b> that down? · <b>Why don't I give</b> him the list?</td></tr><tr><td>offer, polite</td><td class=\"pos\">Would you like me to…? / Let me…</td><td><b>Would you like me to ask</b> them? · <b>Let me help</b> you with that.</td></tr><tr><td>reply</td><td class=\"pos\">Thank you, that's very helpful. / Yes, good idea.</td><td></td></tr></tbody></table></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>Purpose: <b>to + base verb</b> answers WHY — I do it to keep fit.</div><div>Offers: <b>I'll…</b> (fast decision), <b>Shall I…?</b> (asking), <b>Would you like me to…? / Let me…</b> (polite).</div><div>Never “for to”: “for to make a cake” ✗ → “to make a cake” ✓.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Practice\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 6 &middot; Practice</div>\n      <h2>Practice</h2>\n    </div>\n\n      <div class=\"instruction\">Part 1 — Purpose and offers. Choose.</div>\n      <div class=\"task\" data-task data-tid=\"l30s5t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">I'm learning English ___ a better job.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">for find</button><button class=\"opt\" data-val=\"b\">to find</button><button class=\"opt\" data-val=\"c\">for to find</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">She went to the garden ___ some flowers.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">for planting</button><button class=\"opt\" data-val=\"b\">for to plant</button><button class=\"opt\" data-val=\"c\">to plant</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">___ I open the window?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Will you</button><button class=\"opt\" data-val=\"b\">Shall</button><button class=\"opt\" data-val=\"c\">Do</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">___ me help you with that bag.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Shall</button><button class=\"opt\" data-val=\"b\">Let</button><button class=\"opt\" data-val=\"c\">'ll</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">I ___ take notes so we don't forget.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">'m</button><button class=\"opt\" data-val=\"b\">'ll</button><button class=\"opt\" data-val=\"c\">Shall</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">Would you like me ___ ask them?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">to</button><button class=\"opt\" data-val=\"b\">for</button><button class=\"opt\" data-val=\"c\">at</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>to + verb for WHY · Shall I…? · Let me… · I'll… · Would you like me <b>to</b>…</p></div>\n      <div class=\"task\" data-task data-tid=\"l30s5t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">❌ “I'll to help you tomorrow.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">I'll helping you tomorrow.</button><button class=\"opt\" data-val=\"b\">I'll help you tomorrow.</button><button class=\"opt\" data-val=\"c\">I'll helps you tomorrow.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">❌ “Shall I to write that down?”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Shall I write that down?</button><button class=\"opt\" data-val=\"b\">Shall I writing that down?</button><button class=\"opt\" data-val=\"c\">Shall I writes that down?</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">❌ “We bought eggs for to make a cake.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">We bought eggs to make a cake.</button><button class=\"opt\" data-val=\"b\">We bought eggs for make a cake.</button><button class=\"opt\" data-val=\"c\">We bought eggs for make an cake.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>I'll <b>help</b> (base verb) · Shall I <b>write</b> · never “for to” — just <b>to</b>.</p></div>\n      <div class=\"task\" data-task data-tid=\"l30s5t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">We ___ going to give the money to charity.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">'re</button><button class=\"opt\" data-val=\"b\">'ll</button><button class=\"opt\" data-val=\"c\">Could</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">___ you help me with the tickets, please? (request)\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Shall</button><button class=\"opt\" data-val=\"b\">'re</button><button class=\"opt\" data-val=\"c\">Could</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">He isn't going to ___ for 24 hours.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">eats</button><button class=\"opt\" data-val=\"b\">eat</button><button class=\"opt\" data-val=\"c\">'re</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>we<b>'re</b> going to · a request → Could you · going to + base verb.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Listen\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 7 &middot; Listen</div>\n      <h2>Listen</h2>\n    </div>\n\n      <div class=\"instruction\">How the world is going to spend its 67 minutes.</div>\n      <p class=\"subline\">Listen once. Then choose the correct answers.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('11_3',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 11.3 — Mandela Day around the world</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">I: So, how are the plans for this year's Mandela Day? O: Great, thanks! We're getting emails from people all around the world telling us how they're going to celebrate the day. I: So what is everyone going to do? O: All sorts of things. A lot of people are going to make soup and sandwiches and give them to homeless people. I had an email from a man yesterday — he isn't going to eat for 24 hours and he's going to collect money for his local hospital. And, of course, we're going to post everything on our website for people to see. I: Are you going to have time to do something yourself? O: No, I'm afraid I'm not going to have much time at all. But we are going to have a big party here at the office and everyone needs to buy a ticket. And all the money goes to charity, of course.</div></details>\n      <div class=\"task\" data-task data-tid=\"l30s6t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">What are a lot of people going to make for homeless people?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Cakes</button><button class=\"opt\" data-val=\"b\">Soup and sandwiches</button><button class=\"opt\" data-val=\"c\">Tea</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">What is the man who isn't going to eat for 24 hours going to do?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Sleep all day</button><button class=\"opt\" data-val=\"b\">Run a marathon</button><button class=\"opt\" data-val=\"c\">Collect money for his local hospital</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">What is the office going to do?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Close for the day</button><button class=\"opt\" data-val=\"b\">Paint the school</button><button class=\"opt\" data-val=\"c\">Have a party — all ticket money to charity</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Soup and sandwiches · 24 hours without food to collect money · an office party for charity.</p></div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('11_11',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 11.11 — the meeting</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">Conversation 2 — A: I'll read the list, and if anyone would like to do something, please just say. B: I'll take notes so we don't forget. A: Thank you. That's very helpful. First there's the problem with rubbish in the park. C: Oh, shall I do that? I go to the park every day anyway. A: Thank you, Janek. B: Let me help you with that, Janek. It's a big park. C: Thanks. A: Great! What's next? We need someone to paint the walls of the school. D: My husband and his brother could probably do that. Would you like me to ask them? A: Yes, that would be very helpful, thank you.</div></details>\n      <div class=\"task\" data-task data-tid=\"l30s6t6\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Who says “I'll take notes so we don't forget”?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">A</button><button class=\"opt\" data-val=\"b\">B</button><button class=\"opt\" data-val=\"c\">D</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Why does Janek offer to clean the park?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">He goes to the park every day anyway.</button><button class=\"opt\" data-val=\"b\">He loves rubbish.</button><button class=\"opt\" data-val=\"c\">He lives in the park.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Who is going to paint the school walls?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Janek</button><button class=\"opt\" data-val=\"b\">D's husband and his brother</button><button class=\"opt\" data-val=\"c\">The teacher</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>B takes notes · Janek is in the park every day anyway · D offers: “Would you like me to ask them?”</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Write\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 8 &middot; Write</div>\n      <h2>Write</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Plan your own helping day.</div>\n      <p class=\"subline\" data-only=\"self\">4–5 sentences: what you're going to do, WHY (to…), and one offer.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"self\"><div class=\"blab\">Useful language</div><ul><li>I'm going to…</li><li>…to help / to make / to collect…</li><li>I'll…</li><li>Shall I…?</li><li>Let me…</li><li>Would you like me to…?</li></ul></div>\n      <div class=\"instruction\" data-only=\"group\">The neighbourhood meeting — divide the tasks.</div>\n      <p class=\"subline\" data-only=\"group\">One of you chairs the meeting. Then swap.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"group\"><div class=\"blab\">Useful language</div><ul><li>I'll…</li><li>Shall I…?</li><li>Let me…</li><li>Would you like me to…?</li><li>…to help / to make…</li><li>Thank you, that's very helpful.</li></ul></div>\n      <div class=\"instruction\" data-only=\"solo\">The neighbourhood meeting — divide the tasks.</div>\n      <p class=\"subline\" data-only=\"solo\">One of you chairs the meeting. Then swap roles.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"solo\"><div class=\"blab\">Useful language</div><ul><li>I'll…</li><li>Shall I…?</li><li>Let me…</li><li>Would you like me to…?</li><li>…to help / to make…</li><li>Thank you, that's very helpful.</li></ul></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — the chair reads five tasks: rubbish in the park · painting the wall · soup for homeless people · a hospital visit · collecting money.</div><div><b>Step 2</b> — the other offers for at least three tasks, each time with a DIFFERENT phrase (I'll… / Shall I…? / Let me… / Would you like me to…?) and a reason (…to help, …because I go there anyway).</div><div><b>Step 3</b> — the chair thanks them politely. Then swap roles with new tasks.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — the chair reads five tasks: rubbish in the park · painting the wall · soup for homeless people · a hospital visit · collecting money.</div><div><b>Step 2</b> — the other offers for at least three tasks, each time with a DIFFERENT phrase (I'll… / Shall I…? / Let me… / Would you like me to…?) and a reason (…to help, …because I go there anyway).</div><div><b>Step 3</b> — the chair thanks them politely. Then swap roles with new tasks.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Type it\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 9 &middot; Type it</div>\n      <h2>Type it</h2>\n    </div>\n\n      <div class=\"instruction\">Now produce it — type, don’t tap.</div>\n      <p class=\"subline\">Spelling counts. Type the answers, then check.</p>\n      <div class=\"task\" data-task data-tid=\"l30s8t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Don't worry \\u2014 ___ carry the bags. (offer)<br><input class=\"gap gap-lg\" data-answer=\"I'll\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">I called you ___ ask about the party. (reason)<br><input class=\"gap gap-lg\" data-answer=\"to\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">___ I open the window? (offer question)<br><input class=\"gap gap-lg\" data-answer=\"Shall\" placeholder=\"Type the missing word…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Offers: I'll + verb / Shall I + verb? \\u00b7 reasons: to + base verb.</p></div>\n      <div class=\"task\" data-task data-tid=\"l30s8t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">I'll helping you.<br><input class=\"gap gap-lg\" data-answer=\"I'll help you.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">We go to the shop for buy bread.<br><input class=\"gap gap-lg\" data-answer=\"We go to the shop to buy bread.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Shall I opening the window?<br><input class=\"gap gap-lg\" data-answer=\"Shall I open the window?\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Offers: I'll + verb / Shall I + verb? \\u00b7 reasons: to + base verb.</p></div>\n      <div class=\"task\" data-task data-tid=\"l30s8t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Offer it: carry the bags<br><input class=\"gap gap-lg\" data-answer=\"I'll carry the bags.|Shall I carry the bags?\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Give the reason: I called you / ask about the party<br><input class=\"gap gap-lg\" data-answer=\"I called you to ask about the party.\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Offer with Shall: make tea<br><input class=\"gap gap-lg\" data-answer=\"Shall I make tea?\" placeholder=\"Type the new sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Offers: I'll + verb / Shall I + verb? \\u00b7 reasons: to + base verb.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Done\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 10 &middot; Done</div>\n      <h2>Done</h2>\n    </div>\n\n  </section>\n\n"}