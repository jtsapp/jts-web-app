{"unit":4,"no":15,"title":"Finding your way","blurb":"Unit 4","VOCAB":[["go straight on","","идти прямо","тура жүру",""],["turn left","","повернуть налево","солға бұрылу",""],["turn right","","повернуть направо","оңға бұрылу",""],["take the first turning","","первый поворот","бірінші бұрылысқа түсу",""],["go past","","пройти мимо","жанынан өту",""],["cross the road","","перейти дорогу","жолдан өту",""],["traffic lights","","светофор","бағдаршам",""],["corner","","угол","бұрыш",""],["on the left","","слева","сол жақта",""],["on the right","","справа","оң жақта",""],["between","","между","арасында",""],["behind","","за, позади","артында",""],["in front of","","перед","алдында",""],["on the corner of","","на углу","бұрышында",""]],"SLIDES":[["➡️","Go straight on for ten minutes."]],"PICWORDS":["go straight on","turn left","turn right","take the first turning","go past","cross the road","traffic lights","corner","on the left","on the right","between","behind","in front of","on the corner of"],"DEFS":[],"CTX":{},"COLLOC":{},"IMG":{},"NOTES":{},"TIMING":{},"tracks":{"4_11":"A1_L15_4_11.mp3","4_10":"A1_L15_4_10.mp3"},"SEGS":{"4_11":[3.33,null],"4_10":[4.83,null]},"html":"\n  <section class=\"stage on\" data-stage=\"Intro\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 1 &middot; Intro</div>\n      <h2>Finding your way</h2>\n      <p>Ask how to get somewhere — and explain the way to someone else.</p>\n    </div>\n\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"self\"><div class=\"blab\">In other words</div><div><b>How to study</b> — about 25 minutes, top to bottom.</div><div>Headphones on. This lesson has real audio — tap ▶ to listen.</div><div>After each <b>Check answers</b>, read the note — that is your teacher.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with a partner. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>How this lesson works</b> — you work with your teacher. Say your answers out loud.</div><div>This lesson has real audio — tap ▶ to listen together.</div><div>Check your answers after each task.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Warm-up\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 2 &middot; Warm-up</div>\n      <h2>Warm-up</h2>\n    </div>\n\n      <div class=\"instruction\">You are lost in a new city. What do you do?</div>\n      <p class=\"subline\">Tap one. Be honest!</p>\n      <div class=\"grid3\" style=\"margin-top:16px\"><div class=\"card\"><b>📱</b> &nbsp;open the map app</div><div class=\"card\"><b>🗣️</b> &nbsp;ask a person</div><div class=\"card\"><b>🚶</b> &nbsp;walk and hope</div><div class=\"card\"><b>🚕</b> &nbsp;take a taxi and give up</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Words\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 3 &middot; Words</div>\n      <h2>Words</h2>\n    </div>\n\n      <div class=\"vbar\">\n        <div class=\"instruction\" style=\"margin:0\">Read the words. Click a card to see an example.</div>\n        <label class=\"switch\"><input type=\"checkbox\" id=\"trToggle\"><span class=\"track\"></span><span>Show translation</span></label>\n      </div>\n      <div class=\"words\" id=\"words\"></div>\n\n      <div class=\"instruction\">These are your direction words for this lesson.</div>\n      <p class=\"subline\">Tap 🔊 to listen. Turn on translations only if you need them.</p>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Recall\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 4 &middot; Recall</div>\n      <h2>Recall</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">Complete each direction.</div>\n      <div class=\"task\" data-task data-tid=\"l15s3SSt1\" data-only=\"self\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Go ___ the café — don't stop!\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">behind</button><button class=\"opt\" data-val=\"b\">between</button><button class=\"opt\" data-val=\"c\">past</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">The bank is ___ the hotel and the park.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">between</button><button class=\"opt\" data-val=\"b\">through</button><button class=\"opt\" data-val=\"c\">past</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Turn right ___ Albert Street.\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">past</button><button class=\"opt\" data-val=\"b\">into</button><button class=\"opt\" data-val=\"c\">behind</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">It's on the ___ of the road, by the lights.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">corner</button><button class=\"opt\" data-val=\"b\">turning</button><button class=\"opt\" data-val=\"c\">past</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">The café is ___ the bank — on the other side of the street.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">opposite</button><button class=\"opt\" data-val=\"b\">next to</button><button class=\"opt\" data-val=\"c\">behind</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">Walk ___ the park — it's faster.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">through</button><button class=\"opt\" data-val=\"b\">between</button><button class=\"opt\" data-val=\"c\">past</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\" data-only=\"self\"><div class=\"blab\">Why</div><p>past = mimo · between = two things · into a street · corner · opposite = other side · through the park.</p></div>\n      <div class=\"instruction\" data-only=\"group\">Match each direction to its arrow.</div>\n      <p class=\"subline\" data-only=\"group\">Tap a phrase, then tap its symbol.</p>\n      <p class=\"subline\" data-only=\"group\"><b>Phrase</b> &rarr; <b>Symbol</b></p>\n      <div class=\"task\" data-task data-tid=\"l15s3GRt3\" data-only=\"group\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>go straight on</b> <select data-answer=\"⬆️\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>turn left</b> <select data-answer=\"⬅️\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>turn right</b> <select data-answer=\"➡️\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>cross the road</b> <select data-answer=\"🚸\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>traffic lights</b> <select data-answer=\"🚦\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>on the corner</b> <select data-answer=\"📐\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"instruction\" data-only=\"solo\">Match each direction to its arrow.</div>\n      <p class=\"subline\" data-only=\"solo\">Tap a phrase, then tap its symbol.</p>\n      <p class=\"subline\" data-only=\"solo\"><b>Phrase</b> &rarr; <b>Symbol</b></p>\n      <div class=\"task\" data-task data-tid=\"l15s3OOt5\" data-only=\"solo\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\"><b>go straight on</b> <select data-answer=\"⬆️\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\"><b>turn left</b> <select data-answer=\"⬅️\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\"><b>turn right</b> <select data-answer=\"➡️\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\"><b>cross the road</b> <select data-answer=\"🚸\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\"><b>traffic lights</b> <select data-answer=\"🚦\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\"><b>on the corner</b> <select data-answer=\"📐\"><option value=\"\">choose&hellip;</option><option value=\"⬆️\">⬆️</option><option value=\"⬅️\">⬅️</option><option value=\"➡️\">➡️</option><option value=\"🚸\">🚸</option><option value=\"🚦\">🚦</option><option value=\"📐\">📐</option></select></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Grammar\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 5 &middot; Grammar</div>\n      <h2>Grammar</h2>\n    </div>\n\n      <div class=\"instruction\">Where it is — and how you go.</div>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('4_11',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 4.11 — the direction phrase bank</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">1 Excuse me, is there a bank near here? 2 Excuse me, where's the library? 3 Excuse me, how do I get to the post office? 4 Go past the café. 5 It's on the left. 6 Turn right into Albert Street. 7 Take the second right. 8 Go straight on for about ten minutes. 9 Go to the end of this street. 10 It's on the corner.</div></details>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>“It's <b>on the left</b>, <b>next to</b> the supermarket.”</div><div>“It's at the end of this road, <b>on the corner</b>.”</div><div>“Go <b>past</b> the internet café and the bank.”</div><div>“Turn left <b>into</b> Raya Andong.”</div></div>\n      <div class=\"bubble am\" style=\"margin-top:18px\"><div class=\"blab\">Notice</div><p><span class=\"q\">Notice:</span> which prepositions tell you where a place <b>is</b> — and which tell you how to <b>move</b>?</p></div>\n      <div style=\"margin-top:18px;overflow-x:auto\"><table class=\"gtable\"><tbody><tr><th>Type</th><th>Prepositions</th><th>Example</th></tr><tr><td>place — where it IS</td><td class=\"pos\">opposite · between · behind · in front of · next to · on the corner of</td><td>The chemist is <b>next to</b> the supermarket.</td></tr><tr><td>movement — how you GO</td><td class=\"pos\">along · past · through · into</td><td>Go <b>past</b> the bank. Turn right <b>into</b> Albert Street.</td></tr></tbody></table></div>\n      <div class=\"bubble\" style=\"margin-top:18px\"><div class=\"blab\">In other words</div><div>Place: the chemist <b>is</b> next to / opposite / between / behind…</div><div>Movement: <b>go</b> along the street, past the café, through the park; <b>turn</b> into a street.</div><div>Ask politely: “Excuse me, how do I get to…?” · “Could you give me some directions?”</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Practice\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 6 &middot; Practice</div>\n      <h2>Practice</h2>\n    </div>\n\n      <div class=\"instruction\">Part 1 — Choose the correct preposition.</div>\n      <div class=\"task\" data-task data-tid=\"l15s5t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Go ___ the bridge and turn left.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">between</button><button class=\"opt\" data-val=\"b\">opposite</button><button class=\"opt\" data-val=\"c\">along</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">The chemist is ___ the supermarket — same side, one door away.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">opposite</button><button class=\"opt\" data-val=\"b\">behind</button><button class=\"opt\" data-val=\"c\">next to</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The car park is ___ the cinema — you can't see it from the street.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">in front of</button><button class=\"opt\" data-val=\"b\">next to</button><button class=\"opt\" data-val=\"c\">behind</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">Take the ___ turning on the right.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">two</button><button class=\"opt\" data-val=\"b\">along</button><button class=\"opt\" data-val=\"c\">second</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">Cross the road ___ the traffic lights.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">into</button><button class=\"opt\" data-val=\"b\">along</button><button class=\"opt\" data-val=\"c\">at</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">6</span><span class=\"body\">The bus stop is ___ of the school.\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">in front</button><button class=\"opt\" data-val=\"b\">between</button><button class=\"opt\" data-val=\"c\">next to</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>along the bridge · next to = beside · behind = at the back · the second turning · at the lights · in front of.</p></div>\n      <div class=\"task\" data-task data-tid=\"l15s5t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">❌ “Turn to left at the bank.”\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">Turn the left at the bank.</button><button class=\"opt\" data-val=\"b\">Turn left at the bank.</button><button class=\"opt\" data-val=\"c\">Go straight on for five minutes.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">❌ “Go on straight for five minutes.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Go straight on for five minutes.</button><button class=\"opt\" data-val=\"b\">Go straight for on five minutes.</button><button class=\"opt\" data-val=\"c\">Turn left at the bank.</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">❌ “Take the two right.”\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">Take the second right.</button><button class=\"opt\" data-val=\"b\">Take the right two.</button><button class=\"opt\" data-val=\"c\">Turn left at the bank.</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>turn <b>left</b> (no “to”) · go <b>straight on</b> · the <b>second</b> right.</p></div>\n      <div class=\"task\" data-task data-tid=\"l15s5t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Excuse me, ___ a bank near here?\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">are there</button><button class=\"opt\" data-val=\"b\">is there</button><button class=\"opt\" data-val=\"c\">iss there</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">It's next to ___ supermarket.\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">a</button><button class=\"opt\" data-val=\"b\">an</button><button class=\"opt\" data-val=\"c\">the</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">___ do I get to the station?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">How</button><button class=\"opt\" data-val=\"b\">What</button><button class=\"opt\" data-val=\"c\">the</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Is there a…? · next to <b>the</b> supermarket (we know which) · <b>How</b> do I get to…?</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Listen\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 7 &middot; Listen</div>\n      <h2>Listen</h2>\n    </div>\n\n      <div class=\"instruction\">A tourist asks the way. Follow the route in your head.</div>\n      <p class=\"subline\">Listen once for the place. Then listen again for the route.</p>\n      <div class=\"player\">\n        <button class=\"btn btn-audio segbtn\" onclick=\"playTrack('4_10',this)\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg> Play</button>\n        <div class=\"wave\"></div>\n        <div class=\"meta\"><b>Track 4.10 — could you give me some directions?</b>Original coursebook recording</div>\n      </div>\n      <details class=\"gref\" style=\"margin-top:16px\"><summary>Show transcript</summary><div class=\"gref-body\">S: Excuse me, could you give me some directions, please? A: Yes, of course! How can I help you? S: Thanks! So, is there a chemist near here? A: Yes, there is. It's in the town centre. S: How do I get there? A: OK, well go out of the main door and turn left. Then go to the end of the road and turn left again. S: OK. A: Go straight on for about five minutes. Go past the internet café and the bank, and then turn left into Raya Andong. It's on the left, next to the supermarket. S: OK, thanks. Oh, and where's the palace? A: That's easy. It's at the end of this road on the corner. Here, take one of these maps. It has all the important places on it. S: Good idea! A: And we are just here.</div></details>\n      <div class=\"task\" data-task data-tid=\"l15s6t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">What does the tourist want to find first?\n          <div class=\"opts\" data-correct=\"a\"><button class=\"opt\" data-val=\"a\">A chemist</button><button class=\"opt\" data-val=\"b\">A bank</button><button class=\"opt\" data-val=\"c\">A supermarket</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>“Is there a chemist near here?”</p></div>\n      <div class=\"task\" data-task data-tid=\"l15s6t4\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">First: go out of the main door and…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">turn right</button><button class=\"opt\" data-val=\"b\">go straight on</button><button class=\"opt\" data-val=\"c\">turn left</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Go straight on for about…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">ten minutes</button><button class=\"opt\" data-val=\"b\">one minute</button><button class=\"opt\" data-val=\"c\">five minutes</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Go past…\n          <div class=\"opts\" data-correct=\"b\"><button class=\"opt\" data-val=\"a\">the school and the park</button><button class=\"opt\" data-val=\"b\">the internet café and the bank</button><button class=\"opt\" data-val=\"c\">the theatre</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">4</span><span class=\"body\">The chemist is on the left, next to…\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">the palace</button><button class=\"opt\" data-val=\"b\">the bank</button><button class=\"opt\" data-val=\"c\">the supermarket</button></div></span></div>\n        <div class=\"row\"><span class=\"num\">5</span><span class=\"body\">Where is the palace?\n          <div class=\"opts\" data-correct=\"c\"><button class=\"opt\" data-val=\"a\">Behind the chemist</button><button class=\"opt\" data-val=\"b\">Opposite the bank</button><button class=\"opt\" data-val=\"c\">At the end of this road, on the corner</button></div></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>Turn left · five minutes · past the internet café and the bank · next to the supermarket · the palace is at the end of the road, on the corner.</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Write\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 8 &middot; Write</div>\n      <h2>Write</h2>\n    </div>\n\n      <div class=\"instruction\" data-only=\"self\">A friend is at the nearest bus stop. Write the way to your door.</div>\n      <p class=\"subline\" data-only=\"self\">4–5 steps. Use go, turn, past, next to.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"self\"><div class=\"blab\">Useful language</div><ul><li>Go out of…</li><li>Turn left / right</li><li>Go straight on for…</li><li>Go past the…</li><li>It's on the left, next to…</li><li>You can't miss it!</li></ul></div>\n      <div class=\"instruction\" data-only=\"group\">A tourist and a local — three places, three routes.</div>\n      <p class=\"subline\" data-only=\"group\">Give real directions from THIS building. Then swap.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"group\"><div class=\"blab\">Useful language</div><ul><li>Excuse me, how do I get to…?</li><li>Is there a … near here?</li><li>Go straight on…</li><li>Turn left at the…</li><li>Go past the…</li><li>It's on the right, next to…</li></ul></div>\n      <div class=\"instruction\" data-only=\"solo\">A tourist and a local — three places, three routes.</div>\n      <p class=\"subline\" data-only=\"solo\">Give real directions from THIS building. Then swap roles.</p>\n      <div class=\"bubble cy\" style=\"margin-top:20px\" data-only=\"solo\"><div class=\"blab\">Useful language</div><ul><li>Excuse me, how do I get to…?</li><li>Is there a … near here?</li><li>Go straight on…</li><li>Turn left at the…</li><li>Go past the…</li><li>It's on the right, next to…</li></ul></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"group\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — Student A is a tourist: ask the way to three real places near here (a supermarket, a chemist, a bus stop…). Start with “Excuse me…”.</div><div><b>Step 2</b> — Student B is the local: give real directions, step by step. The tourist repeats each step back.</div><div><b>Step 3</b> — swap roles with three new places.</div></div>\n      <div class=\"bubble\" style=\"margin-top:18px\" data-only=\"solo\"><div class=\"blab\">In other words</div><div><b>Step 1</b> — Student A is a tourist: ask the way to three real places near here (a supermarket, a chemist, a bus stop…). Start with “Excuse me…”.</div><div><b>Step 2</b> — Student B is the local: give real directions, step by step. The tourist repeats each step back.</div><div><b>Step 3</b> — swap roles with three new places.</div></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Type it\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 9 &middot; Type it</div>\n      <h2>Type it</h2>\n    </div>\n\n      <div class=\"instruction\">Now produce it — type, don’t tap.</div>\n      <p class=\"subline\">Spelling counts. Type the answers, then check.</p>\n      <div class=\"task\" data-task data-tid=\"l15s8t1\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Turn ___ at the bank.<br><input class=\"gap gap-lg\" data-answer=\"left|right\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Go ___ the supermarket, then turn right.<br><input class=\"gap gap-lg\" data-answer=\"past\" placeholder=\"Type the missing word…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The caf\\u00e9 is ___ the corner.<br><input class=\"gap gap-lg\" data-answer=\"on\" placeholder=\"Type the missing word…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>turn left \\u00b7 go past \\u00b7 on the corner \\u00b7 How do I get to\\u2026?</p></div>\n      <div class=\"task\" data-task data-tid=\"l15s8t2\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Turn to left.<br><input class=\"gap gap-lg\" data-answer=\"Turn left.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Go straight to on.<br><input class=\"gap gap-lg\" data-answer=\"Go straight on.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">The bank is in the corner.<br><input class=\"gap gap-lg\" data-answer=\"The bank is on the corner.\" placeholder=\"Type the whole correct sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>turn left \\u00b7 go past \\u00b7 on the corner \\u00b7 How do I get to\\u2026?</p></div>\n      <div class=\"task\" data-task data-tid=\"l15s8t3\">\n        <div class=\"row\"><span class=\"num\">1</span><span class=\"body\">Ask the way to the cinema.<br><input class=\"gap gap-lg\" data-answer=\"How do I get to the cinema?|Where is the cinema?\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">2</span><span class=\"body\">Make it polite: Where is the station?<br><input class=\"gap gap-lg\" data-answer=\"Excuse me, how do I get to the station?|Excuse me, where is the station?\" placeholder=\"Type the new sentence…\"></span></div>\n        <div class=\"row\"><span class=\"num\">3</span><span class=\"body\">Give the direction: first turning / left<br><input class=\"gap gap-lg\" data-answer=\"Take the first turning on the left.\" placeholder=\"Type the new sentence…\"></span></div>\n        <button class=\"btn btn-primary\" onclick=\"check(this)\">Check answers</button>\n        <div class=\"res\"></div>\n      </div>\n      <div class=\"bubble am\" style=\"margin-top:14px\"><div class=\"blab\">Why</div><p>turn left \\u00b7 go past \\u00b7 on the corner \\u00b7 How do I get to\\u2026?</p></div>\n  </section>\n\n  <section class=\"stage\" data-stage=\"Done\">\n    <div class=\"stage-head\">\n      <div class=\"kicker\">Stage 10 &middot; Done</div>\n      <h2>Done</h2>\n    </div>\n\n  </section>\n\n"}