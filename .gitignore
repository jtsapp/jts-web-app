public/learning/media/

# Сырьё Shadowing: выгруженные страницы Notion и промежуточный captions.txt.
# В репозиторий едет только результат нарезки (public/shadowing/*.json) и
# описание материалов — держать вторую копию тех же транскриптов ни к чему.
scripts/shadowing-src/*
!scripts/shadowing-src/sources.json
# Локальный venv питон-агента (ставится из agent/requirements.txt)
agent/venv/

# Вывод дев-сервера: попал в гит по недосмотру, меняется при каждом запуске.
dev.log

# Предпросмотр импорта каталога книг (scripts/import-practice-library.js
