# ═══════════════════════════════════════════════════════════════════════════
#  jts-web-app (Next.js) — переменные окружения по трём границам.
#  СЕКРЕТЫ (ключи) НИКОГДА не идут с префиксом NEXT_PUBLIC_ — иначе Next вошьёт
#  их в публичный браузерный бандл и любой посетитель их украдёт. Секреты живут
#  только в серверном env (Next route-handlers) и в env LiveKit-агента.
# ═══════════════════════════════════════════════════════════════════════════

# ── SERVER: Next route-handlers (src/app/api) — секреты, в браузер НЕ попадают ─
# Прописать в Vercel → Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=            # мозг тьютора (Claude Haiku 4.5 + caching) + оценка IELTS (Sonnet)
LIVEKIT_API_KEY=             # выдача токена + подпись webhook
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://<project>.livekit.cloud
DATABASE_URL=                # Свой Postgres (self-host) — память тьютора, минуты, IELTS.
#                            # postgres://user:pass@host:5432/db?sslmode=require
#                            # Схема: psql "$DATABASE_URL" -f src/lib/schema.sql
# VOICE_BRAIN_MODEL=claude-haiku-4-5-20251001   # override модели мозга (опц.)
# ANTHROPIC_MODEL=claude-sonnet-5               # override модели оценки IELTS (опц.)

# ── IELTS (src/app/api/ielts/*) — всё опционально, каждая часть деградирует сама ─
# Без ANTHROPIC_API_KEY: Writing/Speaking отдают демо-band, помеченный «демо».
# Listening/Reading считаются по ключу ответов и не требуют ключей вообще.
AZURE_SPEECH_KEY=            # STT разговорного теста уровня + IELTS Speaking
AZURE_SPEECH_REGION=centralus  # (/api/transcribe, en-US) + оценка произношения
#                            # (Pronunciation Assessment). Приоритетный STT на
#                            # этих экранах. Без него: произношение = мок 70/100,
#                            # транскрипт — с Soniox, если задан ключ ниже.
#                            # Region — код региона ресурса Azure Speech.
SONIOX_API_KEY=              # Фолбэк STT для /api/transcribe, если Azure не задан.
#                            # Тот же ключ, что у агента ниже (там он обязателен).
# ELEVENLABS_API_KEY=        # Listening: озвучка скриптов. Без него — браузерный TTS.
# ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku   # «Lily» (опц.)
# ELEVENLABS_MODEL=eleven_flash_v2_5         # (опц.)
# ELEVENLABS_SPEED=0.9                       # (опц.)
# ELEVEN_VOICE_ID_DEXTER=      # Голос Декстера для превью «послушать» на экране
#                            # выбора тьютора (/api/tutor-tts). Тот же voice id,
#                            # что у агента в ELEVEN_VOICE_ID_BRO — иначе превью
#                            # и живой разговор звучат разными людьми. Пусто →
#                            # тихий откат на Gemini/Puck (старый голос).
#                            # NB: ELEVENLABS_VOICE_ID выше — это голос IELTS
#                            # Listening («Lily»), к тьютору отношения не имеет.

# ── LIVEKIT AGENT: отдельный деплой на LiveKit Cloud (папка agent/) ───────────
# Прописать в env агента на LiveKit Cloud, НЕ в Vercel.
# SONIOX_API_KEY=            # STT Луны и Спарка (+ общий фолбэк STT/TTS) и TTS
#                            # Спарка, kz-сессий и откатов. Обязателен всегда.
# GEMINI_API_KEY=            # fallback / transcribe
# VOICE_STACK=cascade        # обязательно cascade (не gemini-live)
# JTS_API_URL=https://<vercel-deploy>   # агент → /api/voice/brain этого проекта.
#                            # Пусто при cascade → сессия прерывается (мозгу некуда
#                            # звонить); при gemini-live — голос работает, но память
#                            # (log_*) молча теряется. Задавать всегда.
# INTERNAL_API_KEY=          # ОБЯЗАТЕЛЬНО: тот же ключ, что на Vercel (ниже).
#                            # Агент шлёт его в /api/voice/brain как Bearer. Пусто/
#                            # не совпадает → мозг отвечает 401 и тьютор молчит.
#
# TTS: провайдер СВОЙ у каждого тьютора (TUTOR_TTS_PROVIDER в agent.py) —
#   Декстер (bro) → ElevenLabs, Луна (gentle) → Gemini, Спарк (hype) → Soniox.
#   Приоритет: TTS_PROVIDER_<ПЕРСОНА> → таблица → CASCADE_TTS. От языка сессии
#   выбор НЕ зависит: по-казахски говорит только Спарк, он и так на Soniox.
#   Провайдер не настроен → предупреждение в лог и откат на Soniox.
# GOOGLE_CREDENTIALS_JSON=   # service account GCP: Cloud TTS для голоса Луны.
#                            # Пусто (и без ADC) → Луна уходит в Soniox.
# ELEVENLABS_API_KEY=        # TTS Декстера. Пусто → Декстер уходит в Soniox.
# ELEVEN_VOICE_ID_BRO=       # voice id Декстера из кабинета ElevenLabs.
#                            # Пусто → зашитый в agent.py фолбэк-id.
# ELEVENLABS_MODEL=eleven_flash_v2_5   # (опц.) Pro: 20 параллельных на Flash/Turbo,
#                            # 10 на multilingual_v2 — про конкурентность, не качество.
# FISH_AUDIO_API_KEY=        # TTS Джарвиса (dev-only тьютор). Пусто → Джарвис
#                            # уходит в Soniox, то есть звучит чужим голосом.
# FISH_VOICE_ID_JARVIS=      # (опц.) voice id (reference_id) из кабинета Fish
#                            # Audio. Пусто → зашитый в код фолбэк-id.
# FISH_TTS_MODEL=s2.1-pro    # (опц.) s1 | s2-pro | s2.1-pro. Цена у всех трёх
#                            # одна ($15/1M UTF-8 байт), дефолт s2.1-pro. На s1
#                            # откатываться только если клон голоса на нём
#                            # звучит ближе к оригиналу.
# TTS_PROVIDER_BRO=          # (опц.) сменить провайдера одному тьютору без
#                            # редеплоя: soniox|gemini|eleven|azure|fish.
# CASCADE_TTS=gemini         # (опц.) дефолт для персон ВНЕ таблицы (professor/
#                            # sage/snark/… — в UI их нет). Не рубильник на всех.
# STT: провайдер тоже СВОЙ у каждого тьютора (TUTOR_STT_PROVIDER в agent.py) —
#   Декстер (bro) → Azure (en-US + ru-RU, континуальный LID), Луна и Спарк →
#   Soniox (авто en/ru/kk с переключением внутри фразы; казахский только там).
#   Приоритет: STT_PROVIDER_<ПЕРСОНА> → таблица → CASCADE_STT.
#   Провайдер не настроен → предупреждение в лог и откат на Soniox, то есть
#   без ключей ниже Декстер молча уедет обратно на Soniox.
AZURE_SPEECH_KEY=            # STT Декстера (обязателен для него) + опц. TTS.
AZURE_SPEECH_REGION=centralus  # Код региона ресурса Azure Speech (KEY 1 или
#                            # KEY 2 из портала — они равнозначны, второй для
#                            # ротации; один ресурс покрывает STT + TTS + PA).
# AZURE_STT_LANGUAGES=en-US,ru-RU   # (опц.) кандидаты LID. Максимум 4, каждый
#                            # лишний ухудшает детект. kk сюда НЕ добавлять —
#                            # казахские сессии распознаёт Soniox.
# STT_PROVIDER_BRO=          # (опц.) сменить STT одному тьютору: soniox|azure.
# CASCADE_STT=soniox         # (опц.) дефолт для персон вне таблицы.
# AZURE_TTS_VOICE_OVERRIDE=  # (опц.) Azure-TTS включается только явно:
#                            # TTS_PROVIDER_<ПЕРСОНА>=azure / CASCADE_TTS=azure.

# ── CLIENT: Next public (NEXT_PUBLIC_ префикс → в браузере, ТОЛЬКО несекретное) ─
NEXT_PUBLIC_API_URL=https://dev-server.justtostudy.kz   # бэкенд авторизации (api.js)
# NEXT_PUBLIC_SCENARIOS_NO_LOCK=1   # открыть ВСЕ сценарии Тьютора, минуя цепочку
#                            # (магазин после интервью, врач после магазина).
#                            # Для локальных тестов — в проде не ставить.
# NEXT_PUBLIC_ENABLE_JARVIS=1  # четвёртый тьютор «Джарвис» на экране выбора.
#                            # Вшивается на этапе `next build` (см. ARG в
#                            # Dockerfile и build.args в compose-app.yaml) —
#                            # значит задаётся ДО сборки, а не в рантайме.
#                            # Только локально и на dev-стенде: в прод-окружении
#                            # переменной быть не должно.
# Токен-эндпоинт зовётся same-origin (/api/livekit/token) — отдельная переменная не нужна.

# ── SERVER: публичный адрес этого стенда ─────────────────────────────────────
# Голосовой агент на LiveKit Cloud ОДИН на дев и прод, а JTS_API_URL у него
# один. Эта переменная уезжает в метаданные комнаты, и агент пишет память и
# историю звонков туда, откуда пришёл токен. Без неё дев-звонки ложились в
# прод-базу, а история на деве была пуста всегда.
# Задавать на КАЖДОМ стенде своим значением. Пусто → поле не шлётся, агент
# остаётся на своём JTS_API_URL (прежнее поведение).
# Агент принимает только https и только хост из того же домена, что его
# JTS_API_URL (localhost — исключение для локальной разработки).
APP_PUBLIC_URL=https://dev-tutor.justtostudy.kz

# Сервисный ключ агент↔Next. Агент шлёт его: (1) как Bearer в /api/voice/brain —
# мозг тьютора, и (2) как x-internal-key при записи памяти в user-<id>. ОБЯЗАН
# стоять И на Vercel, И в env агента, ОДИНАКОВЫЙ. Пусто на Vercel → brain-роут
# закрыт (401, тьютор молчит) и запись памяти в аккаунт запрещена (fail-closed).
# Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
