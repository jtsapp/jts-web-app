# Env копии мозга (compose-brain.yaml). Скопировать в .env.brain и заполнить.
# .env.brain в git не попадает (см. .gitignore).

# Домен этого сервера. A-запись должна смотреть на его IP до первого запуска —
# Caddy по этому имени получает сертификат Let's Encrypt.
BRAIN_DOMAIN=brain-us.justtostudy.kz

# Тот же ключ Anthropic, что на основном стенде.
ANTHROPIC_API_KEY=

# Тот же INTERNAL_API_KEY, что в секретах агента в LiveKit Cloud и на основном
# стенде. Не совпадёт — роут ответит 401, тьютор будет молчать.
INTERNAL_API_KEY=

# (опц.) модель мозга; пусто = claude-haiku-4-5-20251001.
# VOICE_BRAIN_MODEL=
